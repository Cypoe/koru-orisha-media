# Build / runtime artifacts
a.out
bin/
dist/
*.o
*.pyc
__pycache__/
scripts/__pycache__/
scripts/.pw/

# Local compose library mount (see compose.yaml)
media/

# Local runtime volumes (compose ./data). CI uses fixtures/.
data/*
!data/.gitkeep

# Local settings bind (compose ./config). NAS uses /volume1/docker/koru-orisha-media/config.
config/*
!config/.gitkeep

# koruc pump-emit repro logs (scripts/repro_pump_emit.sh copies these to the repo root in Docker)
pump-emit-*.log
pump-emit-artifacts/

# Secrets (provider keys — never commit)
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
