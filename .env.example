# Provider API keys for offline enrichment / hydrate scripts only.
# Orisha request handlers never read these. Never commit .env.
#
#   cp .env.example .env
#   # edit .env
#
# TMDB: either field is enough. Token (API Read Access Token / Bearer) is
# preferred; api_key is the older v3 query param. Same access either way.
#   python3 scripts/enrich_tmdb.py --live --in data/semantic.json --out data/semantic.json
#   python3 scripts/hydrate_catalog.py --catalog data/catalog.sqlite
TMDB_API_KEY=
TMDB_API_TOKEN=

# TVDB (optional; v4 keys from the dashboard; subscriber keys may need PIN)
# TVDB_API_KEY=
# TVDB_PIN=
