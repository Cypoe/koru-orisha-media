# Provider API keys for offline enrichment scripts only.
# Orisha request handlers never read these.
#
#   cp .env.example .env
#   # edit .env
#   TVDB_API_KEY=... python3 scripts/enrich_tvdb.py --live ...

TVDB_API_KEY=
# Optional subscriber PIN for user-supported v4 keys:
# TVDB_PIN=
# IMDB_API_KEY=
