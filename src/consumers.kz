// media/consumers — named constructions → representations (not Orisha).
// HTML library/item/watch/settings, JSON-LD, Link, media/art/subtitle bytes.
// JSON-LD is a Schema.org projection of the local catalog graph (plus optional
// semantic overlay and SQLite nfo/hydrate overlays). Reads the graph snapshot;
// does not load JSON itself. Handlers never call TMDB, TVDB, or ffmpeg.

const std = @import("std");

const STREAM_CHUNK = 64 * 1024;
fn parseBytesRange(range_hdr: []const u8, size: u64) ?struct { start: u64, end: u64 } {
    if (!std.mem.startsWith(u8, range_hdr, "bytes=")) return null;
    const spec = range_hdr["bytes=".len..];
    const dash = std.mem.indexOfScalar(u8, spec, '-') orelse return null;
    if (dash == 0) return null;
    const start = std.fmt.parseInt(u64, spec[0..dash], 10) catch return null;
    var end: u64 = if (dash + 1 < spec.len)
        (std.fmt.parseInt(u64, spec[dash + 1 ..], 10) catch return null)
    else blk: {
        if (size == 0) return null;
        break :blk size - 1;
    };
    if (size == 0 or start >= size or end < start) return null;
    if (end >= size) end = size - 1;
    return .{ .start = start, .end = end };
}

fn htmlEscaped(allocator: std.mem.Allocator, s: []const u8) []const u8 {
    var out: std.ArrayList(u8) = .empty;
    for (s) |ch| {
        switch (ch) {
            '&' => out.appendSlice(allocator, "&amp;") catch {},
            '<' => out.appendSlice(allocator, "&lt;") catch {},
            '>' => out.appendSlice(allocator, "&gt;") catch {},
            '"' => out.appendSlice(allocator, "&quot;") catch {},
            else => out.append(allocator, ch) catch {},
        }
    }
    return out.toOwnedSlice(allocator) catch s;
}

fn formatHttpDateFromNs(buf: *[29]u8, ns: u64) void {
    // Reuse civil_from_days via epoch seconds.
    const epoch: i64 = @intCast(ns / 1_000_000_000);
    const days = @divFloor(epoch, 86400);
    const secs = @as(u32, @intCast(epoch - days * 86400));
    const z = days + 719468;
    const era = @divFloor(z, 146097);
    const doe = @as(u32, @intCast(z - era * 146097));
    const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    const y0 = @as(i64, yoe) + era * 400;
    const doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    const mp = (5 * doy + 2) / 153;
    const d = doy - (153 * mp + 2) / 5 + 1;
    const m = if (mp < 10) mp + 3 else mp - 9;
    const y = if (m <= 2) y0 + 1 else y0;
    const wday = @as(u32, @intCast(@mod(days + 4, 7)));
    const DAY = [_][]const u8{ "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
    const MON = [_][]const u8{ "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    @memcpy(buf[0..3], DAY[wday]);
    buf[3] = ',';
    buf[4] = ' ';
    two(buf[5..7], d);
    buf[7] = ' ';
    @memcpy(buf[8..11], MON[m - 1]);
    buf[11] = ' ';
    four(buf[12..16], @as(u32, @intCast(y)));
    buf[16] = ' ';
    two(buf[17..19], secs / 3600);
    buf[19] = ':';
    two(buf[20..22], (secs % 3600) / 60);
    buf[22] = ':';
    two(buf[23..25], secs % 60);
    @memcpy(buf[25..29], " GMT");
}

fn two(dst: *[2]u8, v: u32) void {
    dst[0] = '0' + @as(u8, @intCast((v / 10) % 10));
    dst[1] = '0' + @as(u8, @intCast(v % 10));
}

fn four(dst: *[4]u8, v: u32) void {
    dst[0] = '0' + @as(u8, @intCast((v / 1000) % 10));
    dst[1] = '0' + @as(u8, @intCast((v / 100) % 10));
    dst[2] = '0' + @as(u8, @intCast((v / 10) % 10));
    dst[3] = '0' + @as(u8, @intCast(v % 10));
}
pub fn parseQueryString(query: ?[]const u8) struct { sort: koru_media.koru_graph.SortMode, q: ?[]const u8, limit: u32, offset: u32 } {
    var sort: koru_media.koru_graph.SortMode = .title;
    var q: ?[]const u8 = null;
    var limit: u32 = 0;
    var offset: u32 = 0;
    const qs = query orelse return .{ .sort = sort, .q = q, .limit = limit, .offset = offset };
    var it = std.mem.splitScalar(u8, qs, '&');
    while (it.next()) |pair| {
        if (std.mem.startsWith(u8, pair, "sort=")) {
            const v = pair["sort=".len..];
            if (std.mem.eql(u8, v, "id")) sort = .id;
            if (std.mem.eql(u8, v, "recent")) sort = .recent;
        } else if (std.mem.startsWith(u8, pair, "q=")) {
            q = pair["q=".len..];
        } else if (std.mem.startsWith(u8, pair, "limit=")) {
            limit = std.fmt.parseInt(u32, pair["limit=".len..], 10) catch 0;
        } else if (std.mem.startsWith(u8, pair, "offset=")) {
            offset = std.fmt.parseInt(u32, pair["offset=".len..], 10) catch 0;
        }
    }
    return .{ .sort = sort, .q = q, .limit = limit, .offset = offset };
}
fn formatLibraryQuery(buf: []u8, sort: koru_media.koru_graph.SortMode, q: ?[]const u8, limit: u32, offset: u32) []const u8 {
    const sort_s: []const u8 = switch (sort) {
        .title => "title",
        .id => "id",
        .recent => "recent",
    };
    if (q) |qv| {
        if (qv.len > 0) {
            return std.fmt.bufPrint(buf, "?sort={s}&q={s}&limit={d}&offset={d}", .{ sort_s, qv, limit, offset }) catch "?";
        }
    }
    return std.fmt.bufPrint(buf, "?sort={s}&limit={d}&offset={d}", .{ sort_s, limit, offset }) catch "?";
}

fn bp() []const u8 {
    return koru_media.koru_graph.basePath();
}

fn homeAbs() []const u8 {
    const b = bp();
    return if (b.len == 0) "/" else b;
}

fn appendAppPath(allocator: std.mem.Allocator, out: *std.ArrayList(u8), path: []const u8) void {
    out.appendSlice(allocator, bp()) catch {};
    out.appendSlice(allocator, path) catch {};
}

fn appendHtmlOpen(allocator: std.mem.Allocator, out: *std.ArrayList(u8)) void {
    out.appendSlice(allocator, "<html lang=\"en\" data-base=\"") catch {};
    out.appendSlice(allocator, bp()) catch {};
    out.appendSlice(allocator, "\">") catch {};
}

fn appendStylesheet(allocator: std.mem.Allocator, out: *std.ArrayList(u8)) void {
    out.appendSlice(allocator, "<link rel=\"stylesheet\" href=\"") catch {};
    appendAppPath(allocator, out, "/app.css");
    out.appendSlice(allocator, "\">") catch {};
}

fn appendScriptEnhance(allocator: std.mem.Allocator, out: *std.ArrayList(u8)) void {
    out.appendSlice(allocator, "<script src=\"") catch {};
    appendAppPath(allocator, out, "/enhance.js");
    out.appendSlice(allocator, "\" defer></script>") catch {};
}

fn libraryBasePath(buf: []u8, kind_filter: ?[]const u8) []const u8 {
    if (kind_filter) |k| {
        return std.fmt.bufPrint(buf, "{s}/library/{s}", .{ bp(), k }) catch "/library";
    }
    return std.fmt.bufPrint(buf, "{s}/library", .{bp()}) catch "/library";
}

fn appendLibraryEmpty(allocator: std.mem.Allocator, out: *std.ArrayList(u8), kind_filter: ?[]const u8, q: ?[]const u8, total: usize) void {
    var base_buf: [160]u8 = undefined;
    const base = libraryBasePath(&base_buf, kind_filter);
    if (q) |needle| {
        if (needle.len > 0 and total == 0) {
            const q_esc = htmlEscaped(allocator, needle);
            defer if (q_esc.ptr != needle.ptr) allocator.free(q_esc);
            var msg: [768]u8 = undefined;
            const line = std.fmt.bufPrint(&msg, "<p class=\"empty\" role=\"status\">No titles match “{s}”. <a href=\"{s}\" hx-get=\"{s}\" hx-target=\"#library-region\" hx-swap=\"outerHTML\" hx-push-url=\"true\">Clear search</a></p>", .{ q_esc, base, base }) catch {
                out.appendSlice(allocator, "<p class=\"empty\" role=\"status\">No titles match this search.</p>") catch {};
                return;
            };
            out.appendSlice(allocator, line) catch {};
            return;
        }
    }
    if (total == 0) {
        if (kind_filter) |_| {
            out.appendSlice(allocator, "<p class=\"empty\" role=\"status\">No items in this collection. <a href=\"") catch {};
            appendAppPath(allocator, out, "/library");
            out.appendSlice(allocator, "\">Browse all</a></p>") catch {};
        } else {
            out.appendSlice(allocator, "<p class=\"empty\" role=\"status\">Library is empty.</p>") catch {};
        }
        return;
    }
    out.appendSlice(allocator, "<p class=\"empty\" role=\"status\">No more items on this page.</p>") catch {};
}

const DEFAULT_PAGE: u32 = 48;

fn kindLabel(kind: []const u8) []const u8 {
    if (std.mem.eql(u8, kind, "movie")) return "Movies";
    if (std.mem.eql(u8, kind, "tv")) return "Series";
    if (std.mem.eql(u8, kind, "audio")) return "Music";
    if (std.mem.eql(u8, kind, "musicVideo")) return "Music videos";
    if (std.mem.eql(u8, kind, "book")) return "Books";
    if (std.mem.eql(u8, kind, "extra")) return "Extras";
    return kind;
}

fn kindBadge(kind: []const u8) []const u8 {
    if (std.mem.eql(u8, kind, "movie")) return "MOVIE";
    if (std.mem.eql(u8, kind, "tv")) return "SERIES";
    if (std.mem.eql(u8, kind, "audio")) return "MUSIC";
    if (std.mem.eql(u8, kind, "musicVideo")) return "MUSIC VIDEO";
    if (std.mem.eql(u8, kind, "book")) return "BOOK";
    if (std.mem.eql(u8, kind, "extra")) return "EXTRA";
    return "FILE";
}

fn searchPlaceholder(kind_filter: ?[]const u8) []const u8 {
    const k = kind_filter orelse return "Search library";
    if (std.mem.eql(u8, k, "movie")) return "Search movies";
    if (std.mem.eql(u8, k, "tv")) return "Search series";
    if (std.mem.eql(u8, k, "audio")) return "Search music";
    if (std.mem.eql(u8, k, "musicVideo")) return "Search music videos";
    if (std.mem.eql(u8, k, "book")) return "Search books";
    if (std.mem.eql(u8, k, "extra")) return "Search extras";
    return "Search library";
}

fn cardTitle(e: koru_media.koru_graph.Entry) []const u8 {
    if (std.mem.eql(u8, e.kind, "tv") or std.mem.eql(u8, e.kind, "audio")) {
        if (e.work_title.len > 0) return e.work_title;
    }
    return e.title;
}

fn isRemotePoster(url: []const u8) bool {
    return std.mem.startsWith(u8, url, "https://") or std.mem.startsWith(u8, url, "http://");
}

fn entryIsExtra(e: koru_media.koru_graph.Entry) bool {
    if (std.mem.eql(u8, e.kind, "extra")) return true;
    return std.mem.eql(u8, koru_media.koru_graph.fileKind(e.path), "extra");
}

fn extraHeading(role: []const u8) []const u8 {
    if (std.mem.eql(u8, role, "soundtrack")) return "Soundtracks";
    if (std.mem.eql(u8, role, "featurette")) return "Featurettes";
    if (std.mem.eql(u8, role, "document")) return "Documents";
    if (std.mem.eql(u8, role, "trailer")) return "Trailers";
    return "Extras";
}

fn editionCaption(rel: []const u8, any_3d: bool) []const u8 {
    const label = koru_media.koru_graph.editionLabel(rel);
    if (any_3d and std.mem.eql(u8, label, "Original")) return "Flat";
    return label;
}

fn appendPosterCard(allocator: std.mem.Allocator, out: *std.ArrayList(u8), e: koru_media.koru_graph.Entry) void {
    const shown = cardTitle(e);
    const title = htmlEscaped(allocator, shown);
    defer if (title.ptr != shown.ptr) allocator.free(title);
    const id_esc = htmlEscaped(allocator, e.id);
    defer if (id_esc.ptr != e.id.ptr) allocator.free(id_esc);
    const kind_esc = htmlEscaped(allocator, e.kind);
    defer if (kind_esc.ptr != e.kind.ptr) allocator.free(kind_esc);
    const badge = kindBadge(e.kind);
    out.appendSlice(allocator, "<li class=\"poster-card\"><a class=\"poster-link\" href=\"") catch {};
    appendAppPath(allocator, out, "/item/");
    out.appendSlice(allocator, id_esc) catch {};
    out.appendSlice(allocator, "\" aria-label=\"") catch {};
    out.appendSlice(allocator, title) catch {};
    out.appendSlice(allocator, "\"><span class=\"poster-frame\">") catch {};
    if (e.poster.len > 0) {
        out.appendSlice(allocator, "<img class=\"poster-art\" src=\"") catch {};
        appendAppPath(allocator, out, "/art/");
        out.appendSlice(allocator, id_esc) catch {};
        out.appendSlice(allocator, "\" alt=\"") catch {};
        out.appendSlice(allocator, title) catch {};
        out.appendSlice(allocator, "\"/>") catch {};
    } else blk: {
        const h = koru_media.koru_graph.findHydrateOverlay(e.imdb_id);
        if (!isRemotePoster(h.poster_url)) {
            out.appendSlice(allocator, "<span class=\"poster-art poster-fallback\" aria-hidden=\"true\"></span>") catch {};
            break :blk;
        }
        const u = htmlEscaped(allocator, h.poster_url);
        defer if (u.ptr != h.poster_url.ptr) allocator.free(u);
        out.appendSlice(allocator, "<img class=\"poster-art\" src=\"") catch {};
        out.appendSlice(allocator, u) catch {};
        out.appendSlice(allocator, "\" alt=\"") catch {};
        out.appendSlice(allocator, title) catch {};
        out.appendSlice(allocator, "\"/>") catch {};
    }
    out.appendSlice(allocator, "<span class=\"badge kind-") catch {};
    out.appendSlice(allocator, kind_esc) catch {};
    out.appendSlice(allocator, "\">") catch {};
    out.appendSlice(allocator, badge) catch {};
    out.appendSlice(allocator, "</span><span class=\"play-overlay\" aria-hidden=\"true\"></span></span></a></li>") catch {};
}

fn appendLibraryList(allocator: std.mem.Allocator, out: *std.ArrayList(u8), kind_filter: ?[]const u8, sort: koru_media.koru_graph.SortMode, q: ?[]const u8, limit: u32, offset: u32, with_region: bool, as_row: bool) void {
    var tmp: [koru_media.koru_graph.MAX_PAGE]koru_media.koru_graph.Entry = undefined;
    const page_limit: u32 = if (limit == 0) DEFAULT_PAGE else limit;
    const page = koru_media.koru_graph.collectPage(kind_filter, q, sort, @as(usize, offset), @as(usize, page_limit), &tmp);
    const items = page.items;
    const start: usize = offset;
    const end: usize = start + items.len;
    const row = as_row;
    // Single swap root: list + pagination. Never include #player here.
    if (with_region) {
        out.appendSlice(allocator, "<div id=\"library-region\">") catch {};
    } else {
        out.appendSlice(allocator, "<div class=\"shelf-region\">") catch {};
    }
    if (items.len == 0) {
        appendLibraryEmpty(allocator, out, kind_filter, q, page.total);
    } else {
        if (with_region) {
            if (row) {
                out.appendSlice(allocator, "<ul id=\"library-list\" class=\"library-list poster-row\">") catch {};
            } else {
                out.appendSlice(allocator, "<ul id=\"library-list\" class=\"library-list poster-grid\">") catch {};
            }
        } else if (row) {
            out.appendSlice(allocator, "<ul class=\"library-list poster-row\">") catch {};
        } else {
            out.appendSlice(allocator, "<ul class=\"library-list poster-grid\">") catch {};
        }
        for (items) |e| {
            appendPosterCard(allocator, out, e);
        }
        out.appendSlice(allocator, "</ul>") catch {};
    }
    if (!row and page.total > end) {
        var qb: [192]u8 = undefined;
        const qs = formatLibraryQuery(&qb, sort, q, page_limit, @as(u32, @intCast(end)));
        var nb: [512]u8 = undefined;
        const next = std.fmt.bufPrint(&nb, "<p class=\"pagination\"><a href=\"{s}\" hx-get=\"{s}\" hx-target=\"#library-region\" hx-swap=\"outerHTML\" hx-push-url=\"true\">next</a></p>", .{ qs, qs }) catch "";
        out.appendSlice(allocator, next) catch {};
    }
    if (!row and start > 0) {
        const prev_off = if (start > page_limit) start - page_limit else 0;
        var qb: [192]u8 = undefined;
        const qs = formatLibraryQuery(&qb, sort, q, page_limit, @as(u32, @intCast(prev_off)));
        var pb: [512]u8 = undefined;
        const prev = std.fmt.bufPrint(&pb, "<p class=\"pagination\"><a href=\"{s}\" hx-get=\"{s}\" hx-target=\"#library-region\" hx-swap=\"outerHTML\" hx-push-url=\"true\">prev</a></p>", .{ qs, qs }) catch "";
        out.appendSlice(allocator, prev) catch {};
    }
    out.appendSlice(allocator, "</div>") catch {};
}

// ============================================================================
// ============================================================================

fn libraryAffordances(allocator: std.mem.Allocator, out: *std.ArrayList(u8), kind_filter: ?[]const u8, q: ?[]const u8, swap: bool) void {
    const q_val: []const u8 = if (q) |qv| qv else "";
    const q_esc = if (q_val.len > 0) htmlEscaped(allocator, q_val) else "";
    defer if (q_esc.len > 0 and q_esc.ptr != q_val.ptr) allocator.free(q_esc);
    var base_buf: [160]u8 = undefined;
    const action = libraryBasePath(&base_buf, kind_filter);
    const placeholder = searchPlaceholder(kind_filter);

    out.appendSlice(allocator, "<nav class=\"affordances\"><form method=\"get\" action=\"") catch {};
    out.appendSlice(allocator, action) catch {};
    if (swap) {
        out.appendSlice(allocator, "\" class=\"search\" hx-get=\"") catch {};
        out.appendSlice(allocator, action) catch {};
        out.appendSlice(allocator, "\" hx-target=\"#library-region\" hx-swap=\"outerHTML\" hx-push-url=\"true\"><label class=\"sr-only\">Search</label><input type=\"search\" name=\"q\" value=\"") catch {};
    } else {
        out.appendSlice(allocator, "\" class=\"search\"><label class=\"sr-only\">Search</label><input type=\"search\" name=\"q\" value=\"") catch {};
    }
    out.appendSlice(allocator, q_esc) catch {};
    out.appendSlice(allocator, "\" placeholder=\"") catch {};
    out.appendSlice(allocator, placeholder) catch {};
    out.appendSlice(allocator, "\"/></form>") catch {};
    if (q_val.len > 0) {
        out.appendSlice(allocator, "<p><a href=\"") catch {};
        out.appendSlice(allocator, action) catch {};
        out.appendSlice(allocator, "\" hx-get=\"") catch {};
        out.appendSlice(allocator, action) catch {};
        out.appendSlice(allocator, "\" hx-target=\"#library-region\" hx-swap=\"outerHTML\" hx-push-url=\"true\">clear search</a></p>") catch {};
    }
    out.appendSlice(allocator, "</nav>") catch {};
}

const KIND_NAV = [_]struct { id: []const u8, always: bool }{
    .{ .id = "movie", .always = true },
    .{ .id = "tv", .always = true },
    .{ .id = "audio", .always = true },
    .{ .id = "musicVideo", .always = false },
    .{ .id = "book", .always = false },
    .{ .id = "extra", .always = false },
};

fn appendKindNav(allocator: std.mem.Allocator, out: *std.ArrayList(u8), kind_filter: ?[]const u8, on_discover: bool) void {
    out.appendSlice(allocator, "<nav class=\"kinds sidebar-nav\">") catch {};
    if (on_discover) {
        out.appendSlice(allocator, "<a class=\"nav-item active\" href=\"") catch {};
        appendAppPath(allocator, out, "/");
        out.appendSlice(allocator, "\"><strong>Discover</strong></a>") catch {};
    } else {
        out.appendSlice(allocator, "<a class=\"nav-item\" href=\"") catch {};
        appendAppPath(allocator, out, "/");
        out.appendSlice(allocator, "\">Discover</a>") catch {};
    }
    for (KIND_NAV) |item| {
        if (!item.always and !koru_media.koru_graph.hasKind(item.id)) continue;
        const label = kindLabel(item.id);
        const on = if (kind_filter) |k| std.mem.eql(u8, k, item.id) else false;
        out.appendSlice(allocator, "<a class=\"nav-item") catch {};
        if (on) out.appendSlice(allocator, " active") catch {};
        out.appendSlice(allocator, "\" href=\"") catch {};
        appendAppPath(allocator, out, "/library/");
        out.appendSlice(allocator, item.id) catch {};
        out.appendSlice(allocator, "\">") catch {};
        if (on) {
            out.appendSlice(allocator, "<strong>") catch {};
            out.appendSlice(allocator, label) catch {};
            out.appendSlice(allocator, "</strong>") catch {};
        } else {
            out.appendSlice(allocator, label) catch {};
        }
        out.appendSlice(allocator, "</a>") catch {};
    }
    out.appendSlice(allocator, "</nav>") catch {};
}

fn appendAppChrome(allocator: std.mem.Allocator, out: *std.ArrayList(u8), kind_filter: ?[]const u8, q: ?[]const u8, extra_class: []const u8) void {
    out.appendSlice(allocator, "<div class=\"layout") catch {};
    if (extra_class.len > 0) {
        out.appendSlice(allocator, " ") catch {};
        out.appendSlice(allocator, extra_class) catch {};
    }
    out.appendSlice(allocator, "\"><aside class=\"sidebar\"><a class=\"logo\" href=\"") catch {};
    appendAppPath(allocator, out, "/");
    out.appendSlice(allocator, "\">Koru Media</a>") catch {};
    appendKindNav(allocator, out, kind_filter, std.mem.eql(u8, extra_class, "home"));
    out.appendSlice(allocator, "<nav class=\"sidebar-nav sidebar-foot\">") catch {};
    if (std.mem.eql(u8, extra_class, "settings")) {
        out.appendSlice(allocator, "<a class=\"nav-item active\" href=\"") catch {};
        appendAppPath(allocator, out, "/settings");
        out.appendSlice(allocator, "\"><strong>Settings</strong></a>") catch {};
    } else {
        out.appendSlice(allocator, "<a class=\"nav-item\" href=\"") catch {};
        appendAppPath(allocator, out, "/settings");
        out.appendSlice(allocator, "\">Settings</a>") catch {};
    }
    out.appendSlice(allocator, "</nav></aside><div class=\"main\"><header class=\"topbar\">") catch {};
    const swap = extra_class.len == 0 or std.mem.eql(u8, extra_class, "home");
    libraryAffordances(allocator, out, kind_filter, q, swap);
    out.appendSlice(allocator, "</header><div class=\"content\">") catch {};
}

fn appendAppChromeEnd(allocator: std.mem.Allocator, out: *std.ArrayList(u8)) void {
    out.appendSlice(allocator, "</div></div></div>") catch {};
}

fn preferMinimal(prefer: ?[]const u8) bool {
    const p = prefer orelse return false;
    return std.ascii.indexOfIgnoreCase(p, "return=minimal") != null;
}

pub fn wantsFragment(req_prefer: ?[]const u8, hx_request: bool) bool {
    // Prefer: return=minimal is the HTTP contract. HX-Request is looked up by
    // the caller via Request.header — not a field on the base parser.
    return hx_request or preferMinimal(req_prefer);
}

fn renderHttpHtml(allocator: std.mem.Allocator, link: []const u8, html: []const u8) []const u8 {
    var out: std.ArrayList(u8) = .empty;
    out.appendSlice(allocator, "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\n") catch {};
    {
        var lb: [32]u8 = undefined;
        const ls = std.fmt.bufPrint(&lb, "Content-Length: {d}\r\n", .{html.len}) catch "";
        out.appendSlice(allocator, ls) catch {};
    }
    out.appendSlice(allocator, "Link: ") catch {};
    out.appendSlice(allocator, link) catch {};
    out.appendSlice(allocator, "\r\nConnection: close\r\n\r\n") catch {};
    out.appendSlice(allocator, html) catch {};
    return out.toOwnedSlice(allocator) catch html;
}

fn appendArchiveStatus(allocator: std.mem.Allocator, out: *std.ArrayList(u8)) void {
    if (koru_media.koru_graph.hasProjectionIndex()) {
        out.appendSlice(allocator, "<p class=\"archive-note\" role=\"status\">Local archive — catalogue names and links overlay matched titles when a projection index is present.</p>") catch {};
    } else {
        out.appendSlice(allocator, "<p class=\"archive-note\" role=\"status\">Local archive — titles here are files on disk and play without a catalogue fetch.</p>") catch {};
    }
}

pub fn homeHtml(allocator: std.mem.Allocator) []const u8 {
    var html: std.ArrayList(u8) = .empty;
    html.appendSlice(allocator, "<!doctype html>") catch {};
    appendHtmlOpen(allocator, &html);
    html.appendSlice(allocator, "<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Koru Media</title>") catch {};
    appendStylesheet(allocator, &html);
    appendScriptEnhance(allocator, &html);
    html.appendSlice(allocator, "</head><body>") catch {};
    appendAppChrome(allocator, &html, null, null, "home");
    html.appendSlice(allocator, "<p class=\"lede\">A direct-play library — browse, watch, and stream originals without a transcoder.</p>") catch {};
    appendArchiveStatus(allocator, &html);
    html.appendSlice(allocator, "<p class=\"cta\"><a class=\"primary\" href=\"") catch {};
    appendAppPath(allocator, &html, "/library");
    html.appendSlice(allocator, "\">Open library</a></p>") catch {};
    html.appendSlice(allocator, "<section class=\"shelf\"><h2>Recently added</h2>") catch {};
    appendLibraryList(allocator, &html, "movie", .recent, null, 12, 0, true, true);
    html.appendSlice(allocator, "</section>") catch {};
    if (koru_media.koru_graph.hasKind("tv")) {
        html.appendSlice(allocator, "<section class=\"shelf\"><h2>Series</h2>") catch {};
        appendLibraryList(allocator, &html, "tv", .recent, null, 12, 0, false, true);
        html.appendSlice(allocator, "</section>") catch {};
    }
    if (koru_media.koru_graph.hasKind("audio")) {
        html.appendSlice(allocator, "<section class=\"shelf\"><h2>Music</h2>") catch {};
        appendLibraryList(allocator, &html, "audio", .recent, null, 12, 0, false, true);
        html.appendSlice(allocator, "</section>") catch {};
    }
    appendAppChromeEnd(allocator, &html);
    html.appendSlice(allocator, "</body></html>") catch {};
    const body = html.toOwnedSlice(allocator) catch "home error";
    var home_link: [384]u8 = undefined;
    const home_l = std.fmt.bufPrint(&home_link, "<{s}>; rel=\"self\", <{s}/library>; rel=\"related\", <{s}/library/movie>; rel=\"collection\"", .{ homeAbs(), bp(), bp() }) catch "</>; rel=\"self\"";
    return renderHttpHtml(allocator, allocator.dupe(u8, home_l) catch home_l, body);
}

pub fn libraryHtml(allocator: std.mem.Allocator, kind_filter: ?[]const u8, sort: koru_media.koru_graph.SortMode, q: ?[]const u8, limit: u32, offset: u32) []const u8 {
    const page_sz: u32 = if (limit == 0) DEFAULT_PAGE else limit;
    var html: std.ArrayList(u8) = .empty;
    html.appendSlice(allocator, "<!doctype html>") catch {};
    appendHtmlOpen(allocator, &html);
    html.appendSlice(allocator, "<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Library · Koru Media</title>") catch {};
    appendStylesheet(allocator, &html);
    appendScriptEnhance(allocator, &html);
    html.appendSlice(allocator, "</head><body>") catch {};
    appendAppChrome(allocator, &html, kind_filter, q, "");
    html.appendSlice(allocator, "<h1>") catch {};
    if (kind_filter) |k| {
        html.appendSlice(allocator, kindLabel(k)) catch {};
    } else {
        html.appendSlice(allocator, "Library") catch {};
    }
    html.appendSlice(allocator, "</h1>") catch {};
    appendArchiveStatus(allocator, &html);
    appendLibraryList(allocator, &html, kind_filter, sort, q, page_sz, offset, true, false);
    appendAppChromeEnd(allocator, &html);
    html.appendSlice(allocator, "</body></html>") catch {};
    const body = html.toOwnedSlice(allocator) catch "library error";
    if (kind_filter) |k| {
        const k_esc = htmlEscaped(allocator, k);
        defer if (k_esc.ptr != k.ptr) allocator.free(k_esc);
        var link_buf: [384]u8 = undefined;
        const self_link = std.fmt.bufPrint(&link_buf, "<{s}/library/{s}>; rel=\"self\", <{s}/library>; rel=\"up\", <{s}>; rel=\"home\"", .{ bp(), k_esc, bp(), homeAbs() }) catch "</library>; rel=\"up\"";
        return renderHttpHtml(allocator, allocator.dupe(u8, self_link) catch self_link, body);
    }
    var all_link: [256]u8 = undefined;
    const all_l = std.fmt.bufPrint(&all_link, "<{s}/library>; rel=\"self\", <{s}>; rel=\"up\"", .{ bp(), homeAbs() }) catch "</library>; rel=\"self\"";
    return renderHttpHtml(allocator, allocator.dupe(u8, all_l) catch all_l, body);
}

fn formUnescape(allocator: std.mem.Allocator, s: []const u8) []const u8 {
    var out: std.ArrayList(u8) = .empty;
    var i: usize = 0;
    while (i < s.len) {
        if (s[i] == '+') {
            out.append(allocator, ' ') catch {};
            i += 1;
        } else if (s[i] == '%' and i + 2 < s.len) {
            const hi = std.fmt.charToDigit(s[i + 1], 16) catch {
                out.append(allocator, s[i]) catch {};
                i += 1;
                continue;
            };
            const lo = std.fmt.charToDigit(s[i + 2], 16) catch {
                out.append(allocator, s[i]) catch {};
                i += 1;
                continue;
            };
            out.append(allocator, hi * 16 + lo) catch {};
            i += 3;
        } else {
            out.append(allocator, s[i]) catch {};
            i += 1;
        }
    }
    return out.toOwnedSlice(allocator) catch s;
}

fn formSlotIndex(key: []const u8, prefix: []const u8) ?usize {
    if (!std.mem.startsWith(u8, key, prefix)) return null;
    const num = key[prefix.len..];
    if (num.len == 0 or num.len > 2) return null;
    return std.fmt.parseInt(usize, num, 10) catch null;
}

fn formBool(val: []const u8) bool {
    return val.len > 0 and !std.mem.eql(u8, val, "0") and !std.ascii.eqlIgnoreCase(val, "false");
}

fn joinAffordances(ep: bool, extras: bool, audio_extra: bool, buf: []u8) []const u8 {
    var w: usize = 0;
    const add = struct {
        fn go(dest: []u8, wp: *usize, name: []const u8) void {
            if (wp.* > 0) {
                if (wp.* + 1 > dest.len) return;
                dest[wp.*] = ',';
                wp.* += 1;
            }
            if (wp.* + name.len > dest.len) return;
            @memcpy(dest[wp.* .. wp.* + name.len], name);
            wp.* += name.len;
        }
    }.go;
    if (ep) add(buf, &w, "episode_graph");
    if (extras) add(buf, &w, "extras");
    if (audio_extra) add(buf, &w, "audio_as_extra");
    return buf[0..w];
}

fn appendCapSelect(allocator: std.mem.Allocator, out: *std.ArrayList(u8), idx: []const u8, current: []const u8) void {
    const opts = [_]struct { v: []const u8, l: []const u8 }{
        .{ .v = "movies", .l = "Movies — film works" },
        .{ .v = "series", .l = "Series — episode graph" },
        .{ .v = "music", .l = "Music — audio library" },
        .{ .v = "books", .l = "Books" },
        .{ .v = "music_videos", .l = "Music videos" },
        .{ .v = "mixed", .l = "Mixed — infer from files" },
    };
    out.appendSlice(allocator, "<label>Capability <select name=\"cap_") catch {};
    out.appendSlice(allocator, idx) catch {};
    out.appendSlice(allocator, "\">") catch {};
    for (opts) |o| {
        out.appendSlice(allocator, "<option value=\"") catch {};
        out.appendSlice(allocator, o.v) catch {};
        out.appendSlice(allocator, "\"") catch {};
        if (std.mem.eql(u8, current, o.v)) out.appendSlice(allocator, " selected") catch {};
        out.appendSlice(allocator, ">") catch {};
        out.appendSlice(allocator, o.l) catch {};
        out.appendSlice(allocator, "</option>") catch {};
    }
    out.appendSlice(allocator, "</select></label>") catch {};
}

fn appendAffChecks(allocator: std.mem.Allocator, out: *std.ArrayList(u8), idx: []const u8, aff: []const u8) void {
    const ep = koru_media.koru_catalog.hasAffordance(aff, "episode_graph");
    const extras = koru_media.koru_catalog.hasAffordance(aff, "extras");
    const audio_ex = koru_media.koru_catalog.hasAffordance(aff, "audio_as_extra");
    out.appendSlice(allocator, "<fieldset class=\"mount-aff\"><legend>Affordances</legend>") catch {};
    out.appendSlice(allocator, "<label class=\"mount-check\"><input type=\"checkbox\" name=\"aff_ep_") catch {};
    out.appendSlice(allocator, idx) catch {};
    out.appendSlice(allocator, "\" value=\"1\"") catch {};
    if (ep) out.appendSlice(allocator, " checked") catch {};
    out.appendSlice(allocator, "> Episode graph</label>") catch {};
    out.appendSlice(allocator, "<label class=\"mount-check\"><input type=\"checkbox\" name=\"aff_ex_") catch {};
    out.appendSlice(allocator, idx) catch {};
    out.appendSlice(allocator, "\" value=\"1\"") catch {};
    if (extras) out.appendSlice(allocator, " checked") catch {};
    out.appendSlice(allocator, "> Extras folders</label>") catch {};
    out.appendSlice(allocator, "<label class=\"mount-check\"><input type=\"checkbox\" name=\"aff_ae_") catch {};
    out.appendSlice(allocator, idx) catch {};
    out.appendSlice(allocator, "\" value=\"1\"") catch {};
    if (audio_ex) out.appendSlice(allocator, " checked") catch {};
    out.appendSlice(allocator, "> Audio as extra</label></fieldset>") catch {};
}

fn appendMountCard(allocator: std.mem.Allocator, out: *std.ArrayList(u8), i: usize, root: ?koru_media.koru_graph.LibraryRoot, media: []const u8, add_slot: bool) void {
    const enabled = if (root) |r| r.enabled else false;
    const name: []const u8 = if (root) |r| r.display_name else "";
    const path: []const u8 = if (root) |r| r.rel_path else "";
    const cap: []const u8 = if (root) |r| (if (r.capability.len > 0) r.capability else koru_media.koru_catalog.inferCapability(path)) else "mixed";
    const aff: []const u8 = if (root) |r| r.affordances else "";
    const name_esc = htmlEscaped(allocator, name);
    defer if (name_esc.ptr != name.ptr) allocator.free(name_esc);
    const path_esc = htmlEscaped(allocator, path);
    defer if (path_esc.ptr != path.ptr) allocator.free(path_esc);
    var idx_buf: [4]u8 = undefined;
    const idx = std.fmt.bufPrint(&idx_buf, "{d}", .{i}) catch "0";
    out.appendSlice(allocator, "<li class=\"mount-card") catch {};
    if (add_slot) out.appendSlice(allocator, " mount-add") catch {};
    out.appendSlice(allocator, "\"><label class=\"mount-on\"><input type=\"checkbox\" name=\"on_") catch {};
    out.appendSlice(allocator, idx) catch {};
    out.appendSlice(allocator, "\" value=\"1\"") catch {};
    if (enabled) out.appendSlice(allocator, " checked") catch {};
    out.appendSlice(allocator, "> Enabled</label><label>Name <input type=\"text\" name=\"name_") catch {};
    out.appendSlice(allocator, idx) catch {};
    out.appendSlice(allocator, "\" value=\"") catch {};
    out.appendSlice(allocator, name_esc) catch {};
    out.appendSlice(allocator, "\" maxlength=\"80\" placeholder=\"Display name\"></label><label>Path <input type=\"text\" name=\"path_") catch {};
    out.appendSlice(allocator, idx) catch {};
    out.appendSlice(allocator, "\" value=\"") catch {};
    out.appendSlice(allocator, path_esc) catch {};
    out.appendSlice(allocator, "\" maxlength=\"200\" spellcheck=\"false\" autocomplete=\"off\" placeholder=\"folder under /media\"></label>") catch {};
    appendCapSelect(allocator, out, idx, cap);
    if (!add_slot) {
        out.appendSlice(allocator, "<label class=\"mount-drop\"><input type=\"checkbox\" name=\"drop_") catch {};
        out.appendSlice(allocator, idx) catch {};
        out.appendSlice(allocator, "\" value=\"1\"> Remove</label>") catch {};
    }
    appendAffChecks(allocator, out, idx, aff);
    if (path.len > 0) {
        out.appendSlice(allocator, "<p class=\"hint\"><code>") catch {};
        const m_esc = htmlEscaped(allocator, media);
        defer if (m_esc.ptr != media.ptr) allocator.free(m_esc);
        out.appendSlice(allocator, m_esc) catch {};
        out.appendSlice(allocator, "/") catch {};
        out.appendSlice(allocator, path_esc) catch {};
        out.appendSlice(allocator, "</code> must be a Compose host bind — this page cannot mount Synology volumes.</p>") catch {};
    } else if (add_slot) {
        out.appendSlice(allocator, "<p class=\"hint\">Add a folder already bind-mounted under the media root, then tag how the indexer should treat it.</p>") catch {};
    }
    out.appendSlice(allocator, "</li>") catch {};
}

fn appendSettingsPage(allocator: std.mem.Allocator, out: *std.ArrayList(u8), notice: []const u8) void {
    var roots_buf: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS]koru_media.koru_graph.LibraryRoot = undefined;
    const roots = koru_media.koru_graph.listLibraryRoots(&roots_buf);
    const media = koru_media.koru_graph.mediaRoot();
    const max = koru_media.koru_catalog.MAX_LIBRARY_ROOTS;
    out.appendSlice(allocator, "<div id=\"settings-page\" class=\"settings-page\"><h1>Settings</h1>") catch {};
    if (notice.len > 0) {
        out.appendSlice(allocator, "<p class=\"notice\" role=\"status\">") catch {};
        const n_esc = htmlEscaped(allocator, notice);
        defer if (n_esc.ptr != notice.ptr) allocator.free(n_esc);
        out.appendSlice(allocator, n_esc) catch {};
        out.appendSlice(allocator, "</p>") catch {};
    }
    out.appendSlice(allocator, "<form method=\"post\" action=\"") catch {};
    appendAppPath(allocator, out, "/settings");
    out.appendSlice(allocator, "\" class=\"settings-form\">") catch {};

    out.appendSlice(allocator, "<section class=\"settings-section\"><h2>Libraries</h2>") catch {};
    out.appendSlice(allocator, "<p class=\"lede\">Enabled folders under the media root that the binary indexer walks. Tag each entry by capability (what the library is) and affordances (episode graph, extras, audio-as-extra). Compose still has to bind the DSM share into <code>/media/…</code> — adding a row here does not mount a volume.</p>") catch {};
    out.appendSlice(allocator, "<ul class=\"mount-list\">") catch {};
    var i: usize = 0;
    while (i < roots.len and i < max) : (i += 1) {
        appendMountCard(allocator, out, i, roots[i], media, false);
    }
    if (i < max) {
        appendMountCard(allocator, out, i, null, media, true);
    }
    out.appendSlice(allocator, "</ul></section>") catch {};

    out.appendSlice(allocator, "<section class=\"settings-section\"><h2>Indexer</h2>") catch {};
    out.appendSlice(allocator, "<p class=\"lede\">Reindex walks enabled folders into the catalog on the next idle request so a playing stream is not interrupted. The walker is this app’s binary, not a host script. A walk that finds 0 files against a non-empty catalog is rolled back.</p>") catch {};
    out.appendSlice(allocator, "<label class=\"mount-check\"><input type=\"hidden\" name=\"walk_on_empty\" value=\"0\"><input type=\"checkbox\" name=\"walk_on_empty\" value=\"1\"") catch {};
    if (koru_media.koru_graph.walkOnEmpty()) out.appendSlice(allocator, " checked") catch {};
    out.appendSlice(allocator, "> Reindex automatically when the catalog is empty and media binds have files</label>") catch {};
    out.appendSlice(allocator, "<p class=\"hint\">Same flag as <code>reindex.requested</code> next to the catalog file. <code>KORU_REINDEX=1</code> still forces a walk on boot.</p></section>") catch {};

    out.appendSlice(allocator, "<section class=\"settings-section\"><h2>Catalog store</h2>") catch {};
    out.appendSlice(allocator, "<p class=\"lede\">SQLite is the linked driver. An external SQL DSN can be stored for a later build; this process will not pretend to open Postgres or MySQL.</p>") catch {};
    const drv = koru_media.koru_graph.catalogDriver();
    out.appendSlice(allocator, "<label>Driver <select name=\"catalog_driver\"><option value=\"sqlite\"") catch {};
    if (std.ascii.eqlIgnoreCase(drv, "sqlite")) out.appendSlice(allocator, " selected") catch {};
    out.appendSlice(allocator, ">SQLite (linked)</option><option value=\"postgres\"") catch {};
    if (std.ascii.eqlIgnoreCase(drv, "postgres")) out.appendSlice(allocator, " selected") catch {};
    out.appendSlice(allocator, ">PostgreSQL (not linked)</option><option value=\"mysql\"") catch {};
    if (std.ascii.eqlIgnoreCase(drv, "mysql")) out.appendSlice(allocator, " selected") catch {};
    out.appendSlice(allocator, ">MySQL (not linked)</option></select></label>") catch {};
    const dsn = koru_media.koru_graph.catalogDsn();
    const dsn_esc = htmlEscaped(allocator, dsn);
    defer if (dsn_esc.ptr != dsn.ptr) allocator.free(dsn_esc);
    out.appendSlice(allocator, "<label>DSN / SQLite path <input type=\"text\" name=\"catalog_dsn\" value=\"") catch {};
    out.appendSlice(allocator, dsn_esc) catch {};
    out.appendSlice(allocator, "\" maxlength=\"400\" spellcheck=\"false\" autocomplete=\"off\"></label>") catch {};
    if (!koru_media.koru_graph.catalogDriverLinked()) {
        out.appendSlice(allocator, "<p class=\"notice\" role=\"status\">This driver is not linked. The catalog stays on SQLite until a later build opens external SQL.</p>") catch {};
    } else {
        out.appendSlice(allocator, "<p class=\"hint\">SQLite file must live on the <code>/data</code> host bind so it survives Container Manager / Watchtower recreates. Changing the path applies on the next process start.</p>") catch {};
    }
    out.appendSlice(allocator, "</section>") catch {};

    out.appendSlice(allocator, "<section class=\"settings-section\"><h2>Base path</h2>") catch {};
    out.appendSlice(allocator, "<p class=\"lede\">WebStation alias / reverse-proxy prefix. Saved under <code>") catch {};
    const cfg = koru_media.koru_graph.configPath();
    const cfg_esc = htmlEscaped(allocator, cfg);
    defer if (cfg_esc.ptr != cfg.ptr) allocator.free(cfg_esc);
    out.appendSlice(allocator, cfg_esc) catch {};
    out.appendSlice(allocator, "</code>. Compose env <code>KORU_BASE_PATH</code> is the fallback when this field is empty. Do not use <code>/media</code> — that name is the byte-stream route.</p>") catch {};
    const alias = bp();
    const alias_esc = htmlEscaped(allocator, alias);
    defer if (alias_esc.ptr != alias.ptr) allocator.free(alias_esc);
    out.appendSlice(allocator, "<label>Base path <input type=\"text\" name=\"base_path\" value=\"") catch {};
    out.appendSlice(allocator, alias_esc) catch {};
    out.appendSlice(allocator, "\" maxlength=\"80\" spellcheck=\"false\" placeholder=\"/korisha\"></label></section>") catch {};

    out.appendSlice(allocator, "<p class=\"settings-actions\"><button type=\"submit\" name=\"action\" value=\"save\" class=\"primary\">Save</button>") catch {};
    out.appendSlice(allocator, "<button type=\"submit\" name=\"action\" value=\"reindex\" class=\"secondary\">Reindex</button></p></form></div>") catch {};
}

pub fn settingsHtml(allocator: std.mem.Allocator, notice: []const u8) []const u8 {
    var html: std.ArrayList(u8) = .empty;
    html.appendSlice(allocator, "<!doctype html>") catch {};
    appendHtmlOpen(allocator, &html);
    html.appendSlice(allocator, "<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Settings · Koru Media</title>") catch {};
    appendStylesheet(allocator, &html);
    appendScriptEnhance(allocator, &html);
    html.appendSlice(allocator, "</head><body>") catch {};
    appendAppChrome(allocator, &html, null, null, "settings");
    appendSettingsPage(allocator, &html, notice);
    appendAppChromeEnd(allocator, &html);
    html.appendSlice(allocator, "</body></html>") catch {};
    const body = html.toOwnedSlice(allocator) catch "settings error";
    var link_buf: [256]u8 = undefined;
    const link = std.fmt.bufPrint(&link_buf, "<{s}/settings>; rel=\"self\", <{s}>; rel=\"home\"", .{ bp(), homeAbs() }) catch "</settings>; rel=\"self\"";
    return renderHttpHtml(allocator, allocator.dupe(u8, link) catch link, body);
}

pub fn settingsPost(allocator: std.mem.Allocator, body: ?[]const u8) []const u8 {
    const raw = body orelse "";
    const max = koru_media.koru_catalog.MAX_LIBRARY_ROOTS;
    var names: [16][]const u8 = .{""} ** 16;
    var paths: [16][]const u8 = .{""} ** 16;
    var caps: [16][]const u8 = .{""} ** 16;
    var ons: [16]bool = .{false} ** 16;
    var drops: [16]bool = .{false} ** 16;
    var aff_ep: [16]bool = .{false} ** 16;
    var aff_ex: [16]bool = .{false} ** 16;
    var aff_ae: [16]bool = .{false} ** 16;
    var action: []const u8 = "save";
    var base_raw: []const u8 = koru_media.koru_graph.basePath();
    var driver: []const u8 = koru_media.koru_graph.catalogDriver();
    var dsn: []const u8 = koru_media.koru_graph.catalogDsn();
    var walk = true;
    var it = std.mem.splitScalar(u8, raw, '&');
    while (it.next()) |pair| {
        const eq = std.mem.indexOfScalar(u8, pair, '=') orelse continue;
        const key = pair[0..eq];
        const val = formUnescape(allocator, pair[eq + 1 ..]);
        if (std.mem.eql(u8, key, "action")) {
            action = val;
        } else if (std.mem.eql(u8, key, "base_path")) {
            base_raw = val;
        } else if (std.mem.eql(u8, key, "catalog_driver")) {
            driver = val;
        } else if (std.mem.eql(u8, key, "catalog_dsn")) {
            dsn = val;
        } else if (std.mem.eql(u8, key, "walk_on_empty")) {
            walk = formBool(val);
        } else if (formSlotIndex(key, "name_")) |idx| {
            if (idx < max) names[idx] = val;
        } else if (formSlotIndex(key, "path_")) |idx| {
            if (idx < max) paths[idx] = val;
        } else if (formSlotIndex(key, "cap_")) |idx| {
            if (idx < max) caps[idx] = val;
        } else if (formSlotIndex(key, "on_")) |idx| {
            if (idx < max) ons[idx] = formBool(val);
        } else if (formSlotIndex(key, "drop_")) |idx| {
            if (idx < max) drops[idx] = formBool(val);
        } else if (formSlotIndex(key, "aff_ep_")) |idx| {
            if (idx < max) aff_ep[idx] = formBool(val);
        } else if (formSlotIndex(key, "aff_ex_")) |idx| {
            if (idx < max) aff_ex[idx] = formBool(val);
        } else if (formSlotIndex(key, "aff_ae_")) |idx| {
            if (idx < max) aff_ae[idx] = formBool(val);
        }
    }
    const base_trim = std.mem.trim(u8, base_raw, " \t\r\n");
    if (std.ascii.eqlIgnoreCase(base_trim, "/media")) {
        return settingsHtml(allocator, "Not saved: base path cannot be /media (that name is the byte-stream route).");
    }
    var built: [16]koru_media.koru_graph.LibraryRoot = undefined;
    var aff_bufs: [16][96]u8 = undefined;
    var n: usize = 0;
    var i: usize = 0;
    var bad = false;
    while (i < max) : (i += 1) {
        if (drops[i]) continue;
        const p = std.mem.trim(u8, paths[i], " \t");
        if (p.len == 0) continue;
        var rel_buf: [256]u8 = undefined;
        const rel = koru_media.koru_graph.normalizeLibraryRel(p, &rel_buf) orelse {
            bad = true;
            break;
        };
        var name = std.mem.trim(u8, names[i], " \t");
        if (name.len == 0) name = rel;
        var cap = std.mem.trim(u8, caps[i], " \t");
        if (cap.len == 0) cap = koru_media.koru_catalog.inferCapability(rel);
        const aff = joinAffordances(aff_ep[i], aff_ex[i], aff_ae[i], &aff_bufs[n]);
        const name_owned = allocator.dupe(u8, name) catch name;
        const rel_owned = allocator.dupe(u8, rel) catch rel;
        const cap_owned = allocator.dupe(u8, cap) catch cap;
        const aff_owned = allocator.dupe(u8, aff) catch aff;
        built[n] = .{
            .display_name = name_owned,
            .rel_path = rel_owned,
            .enabled = ons[i],
            .capability = cap_owned,
            .affordances = aff_owned,
        };
        n += 1;
    }
    if (bad) {
        return settingsHtml(allocator, "Not saved: a library path must stay under the media root (no .., no absolute path outside it).");
    }
    if (n == 0) {
        return settingsHtml(allocator, "Not saved: keep at least one library path. Disable a folder with the checkbox instead of clearing every path.");
    }
    const dsn_trim = std.mem.trim(u8, dsn, " \t");
    const drv_trim = std.mem.trim(u8, driver, " \t");
    if (!koru_media.koru_graph.persistAppSettings(base_trim, drv_trim, dsn_trim, walk, built[0..n])) {
        return settingsHtml(allocator, "Not saved: catalog is not writable.");
    }
    const linked = std.ascii.eqlIgnoreCase(drv_trim, "sqlite");
    if (std.mem.eql(u8, action, "reindex")) {
        koru_media.koru_graph.requestReindex();
        if (!linked) {
            return settingsHtml(allocator, "Saved. Reindex is flagged — the next idle request walks enabled folders into the SQLite catalog. The selected SQL driver is not linked.");
        }
        return settingsHtml(allocator, "Saved. Reindex is flagged — the next idle request walks enabled folders into the catalog.");
    }
    if (!linked) {
        return settingsHtml(allocator, "Saved library mounts and settings. The selected SQL driver is not linked; the catalog stays on SQLite.");
    }
    return settingsHtml(allocator, "Saved library mounts.");
}

pub fn libraryFragment(allocator: std.mem.Allocator, kind_filter: ?[]const u8, sort: koru_media.koru_graph.SortMode, q: ?[]const u8, limit: u32, offset: u32) []const u8 {
    var html: std.ArrayList(u8) = .empty;
    appendLibraryList(allocator, &html, kind_filter, sort, q, limit, offset, true, false);
    const body = html.toOwnedSlice(allocator) catch "fragment error";
    if (kind_filter) |k| {
        const k_esc = htmlEscaped(allocator, k);
        defer if (k_esc.ptr != k.ptr) allocator.free(k_esc);
        var link_buf: [320]u8 = undefined;
        const link = std.fmt.bufPrint(&link_buf, "<{s}/library/{s}>; rel=\"collection\", <{s}/library>; rel=\"up\"", .{ bp(), k_esc, bp() }) catch "</library>; rel=\"up\"";
        return renderHttpHtml(allocator, allocator.dupe(u8, link) catch link, body);
    }
    var frag_link: [160]u8 = undefined;
    const frag_l = std.fmt.bufPrint(&frag_link, "<{s}/library>; rel=\"up\"", .{bp()}) catch "</library>; rel=\"up\"";
    return renderHttpHtml(allocator, allocator.dupe(u8, frag_l) catch frag_l, body);
}

fn likelyBrowserPlayable(container: []const u8) bool {
    const ok = [_][]const u8{ "mp4", "m4v", "webm", "ogg", "ogv", "mp3", "m4a", "aac", "wav", "flac" };
    for (ok) |cand| {
        if (std.mem.eql(u8, container, cand)) return true;
    }
    return false;
}

fn entryHasProbe(e: koru_media.koru_graph.Entry) bool {
    return e.video_brand.len > 0 or e.video_codec.len > 0 or e.audio_codec.len > 0;
}

/// Honest indexer facts only — no invented stream/codec matrix.
fn formatProbeNote(allocator: std.mem.Allocator, e: koru_media.koru_graph.Entry, out: []u8) []const u8 {
    if (!entryHasProbe(e)) return "";
    const brand = htmlEscaped(allocator, e.video_brand);
    defer if (brand.ptr != e.video_brand.ptr) allocator.free(brand);
    const vcodec = htmlEscaped(allocator, e.video_codec);
    defer if (vcodec.ptr != e.video_codec.ptr) allocator.free(vcodec);
    const acodec = htmlEscaped(allocator, e.audio_codec);
    defer if (acodec.ptr != e.audio_codec.ptr) allocator.free(acodec);

    var joined: [320]u8 = undefined;
    var w: usize = 0;
    const append = struct {
        fn go(dest: []u8, wp: *usize, piece: []const u8) void {
            if (wp.* > 0) {
                const sep = " · ";
                if (wp.* + sep.len > dest.len) return;
                @memcpy(dest[wp.* .. wp.* + sep.len], sep);
                wp.* += sep.len;
            }
            if (wp.* + piece.len > dest.len) return;
            @memcpy(dest[wp.* .. wp.* + piece.len], piece);
            wp.* += piece.len;
        }
    }.go;

    if (e.video_brand.len > 0) {
        var piece: [128]u8 = undefined;
        const s = std.fmt.bufPrint(&piece, "brand <code>{s}</code>", .{brand}) catch "brand";
        append(&joined, &w, s);
    }
    if (e.video_codec.len > 0) {
        if (std.mem.eql(u8, e.video_codec, "unknown")) {
            append(&joined, &w, "video codec not probed");
        } else {
            var piece: [128]u8 = undefined;
            const s = std.fmt.bufPrint(&piece, "video <code>{s}</code>", .{vcodec}) catch "video";
            append(&joined, &w, s);
        }
    }
    if (e.audio_codec.len > 0) {
        if (std.mem.eql(u8, e.audio_codec, "unknown")) {
            append(&joined, &w, "audio codec not probed");
        } else {
            var piece: [128]u8 = undefined;
            const s = std.fmt.bufPrint(&piece, "audio <code>{s}</code>", .{acodec}) catch "audio";
            append(&joined, &w, s);
        }
    }
    if (w == 0) return "";
    return std.fmt.bufPrint(out, "<p class=\"probe\" role=\"status\">Indexed: {s}</p>", .{joined[0..w]}) catch "";
}

fn queryValue(query: ?[]const u8, name: []const u8) ?[]const u8 {
    const qs = query orelse return null;
    var it = std.mem.splitScalar(u8, qs, '&');
    var prefix_buf: [32]u8 = undefined;
    const prefix = std.fmt.bufPrint(&prefix_buf, "{s}=", .{name}) catch return null;
    while (it.next()) |raw| {
        const pair = std.mem.trim(u8, raw, " \t\r");
        if (std.mem.startsWith(u8, pair, prefix)) return pair[prefix.len..];
    }
    return null;
}

fn appendJsonString(allocator: std.mem.Allocator, out: *std.ArrayList(u8), s: []const u8) void {
    out.append(allocator, '"') catch {};
    for (s) |ch| {
        switch (ch) {
            '"' => out.appendSlice(allocator, "\\\"") catch {},
            '\\' => out.appendSlice(allocator, "\\\\") catch {},
            '\n' => out.appendSlice(allocator, "\\n") catch {},
            '\r' => out.appendSlice(allocator, "\\r") catch {},
            '\t' => out.appendSlice(allocator, "\\t") catch {},
            '<' => out.appendSlice(allocator, "\\u003c") catch {},
            '>' => out.appendSlice(allocator, "\\u003e") catch {},
            '&' => out.appendSlice(allocator, "\\u0026") catch {},
            else => {
                if (ch < 0x20) {
                    const hex = "0123456789abcdef";
                    const ub = [_]u8{ '\\', 'u', '0', '0', hex[@as(usize, ch >> 4)], hex[@as(usize, ch & 0x0f)] };
                    out.appendSlice(allocator, &ub) catch {};
                } else {
                    out.append(allocator, ch) catch {};
                }
            },
        }
    }
    out.append(allocator, '"') catch {};
}

fn appendJsonAppUrl(allocator: std.mem.Allocator, out: *std.ArrayList(u8), path: []const u8, id: []const u8) void {
    var buf: [512]u8 = undefined;
    const url = std.fmt.bufPrint(&buf, "{s}{s}{s}", .{ bp(), path, id }) catch return;
    appendJsonString(allocator, out, url);
}

fn appendJsonU32(allocator: std.mem.Allocator, out: *std.ArrayList(u8), n: u32) void {
    var nb: [16]u8 = undefined;
    const ns = std.fmt.bufPrint(&nb, "{d}", .{n}) catch "0";
    out.appendSlice(allocator, ns) catch {};
}

fn workRepId(files: []const koru_media.koru_graph.Entry, fallback: []const u8) []const u8 {
    var best: ?[]const u8 = null;
    for (files) |f| {
        if (entryIsExtra(f)) continue;
        if (best) |b| {
            if (std.mem.order(u8, f.id, b) == .lt) best = f.id;
        } else best = f.id;
    }
    return best orelse fallback;
}

fn workNameOf(e: koru_media.koru_graph.Entry, files: []const koru_media.koru_graph.Entry) []const u8 {
    if (e.work_title.len > 0) return e.work_title;
    for (files) |f| {
        if (f.work_title.len > 0) return f.work_title;
    }
    return e.title;
}

fn workImdbOf(e: koru_media.koru_graph.Entry, files: []const koru_media.koru_graph.Entry) []const u8 {
    if (e.imdb_id.len > 0) return e.imdb_id;
    for (files) |f| {
        if (f.imdb_id.len > 0) return f.imdb_id;
    }
    return "";
}

fn jsonLdIsSeriesWork(e: koru_media.koru_graph.Entry, files: []const koru_media.koru_graph.Entry) bool {
    if (entryIsExtra(e)) return false;
    if (!filesAreSeries(e.kind, files)) return false;
    return std.mem.eql(u8, e.id, workRepId(files, e.id));
}

fn jsonLdType(e: koru_media.koru_graph.Entry, files: []const koru_media.koru_graph.Entry) []const u8 {
    if (entryIsExtra(e)) {
        if (std.mem.startsWith(u8, e.mime, "video/")) return "VideoObject";
        return "MusicRecording";
    }
    if (jsonLdIsSeriesWork(e, files)) return "TVSeries";
    if (std.mem.eql(u8, e.kind, "tv") or e.season > 0 or e.episode > 0) return "TVEpisode";
    if (std.mem.eql(u8, e.kind, "movie")) return "Movie";
    if (std.mem.eql(u8, e.kind, "book")) return "Book";
    if (std.mem.eql(u8, e.kind, "audio") or std.mem.eql(u8, e.kind, "music")) return "MusicRecording";
    return "CreativeWork";
}

fn appendImdbSameAs(allocator: std.mem.Allocator, out: *std.ArrayList(u8), imdb_id: []const u8) void {
    if (imdb_id.len == 0) return;
    var buf: [80]u8 = undefined;
    const url = std.fmt.bufPrint(&buf, "https://www.imdb.com/title/{s}/", .{imdb_id}) catch return;
    out.appendSlice(allocator, ",\"sameAs\":") catch {};
    appendJsonString(allocator, out, url);
}

fn appendJsonLdCore(allocator: std.mem.Allocator, out: *std.ArrayList(u8), typ: []const u8, e: koru_media.koru_graph.Entry, name: []const u8, description: []const u8) void {
    out.appendSlice(allocator, "{\"@context\":\"https://schema.org\",\"@type\":") catch {};
    appendJsonString(allocator, out, typ);
    out.appendSlice(allocator, ",\"@id\":") catch {};
    appendJsonAppUrl(allocator, out, "/item/", e.id);
    out.appendSlice(allocator, ",\"name\":") catch {};
    appendJsonString(allocator, out, name);
    if (description.len > 0) {
        out.appendSlice(allocator, ",\"description\":") catch {};
        appendJsonString(allocator, out, description);
    }
    out.appendSlice(allocator, ",\"contentUrl\":") catch {};
    appendJsonAppUrl(allocator, out, "/media/", e.id);
    if (e.year > 0) {
        var yb: [8]u8 = undefined;
        const ys = std.fmt.bufPrint(&yb, "{d}", .{e.year}) catch "";
        if (ys.len > 0) {
            out.appendSlice(allocator, ",\"datePublished\":") catch {};
            appendJsonString(allocator, out, ys);
        }
    }
    if (e.poster.len > 0) {
        out.appendSlice(allocator, ",\"image\":") catch {};
        appendJsonAppUrl(allocator, out, "/art/", e.id);
    }
}

fn appendEpisodeStub(allocator: std.mem.Allocator, out: *std.ArrayList(u8), f: koru_media.koru_graph.Entry) void {
    out.appendSlice(allocator, "{\"@type\":\"TVEpisode\",\"name\":") catch {};
    appendJsonString(allocator, out, f.title);
    if (f.episode > 0) {
        out.appendSlice(allocator, ",\"episodeNumber\":") catch {};
        appendJsonU32(allocator, out, f.episode);
    }
    if (f.season > 0) {
        out.appendSlice(allocator, ",\"partOfSeason\":{\"@type\":\"TVSeason\",\"seasonNumber\":") catch {};
        appendJsonU32(allocator, out, f.season);
        out.append(allocator, '}') catch {};
    }
    out.appendSlice(allocator, ",\"contentUrl\":") catch {};
    appendJsonAppUrl(allocator, out, "/media/", f.id);
    out.append(allocator, '}') catch {};
}

fn firstTrailer(files: []const koru_media.koru_graph.Entry) ?koru_media.koru_graph.Entry {
    for (files) |f| {
        if (!entryIsExtra(f)) continue;
        if (koru_media.koru_graph.pathIsTrailer(f.path)) return f;
    }
    return null;
}

fn appendActorsJsonLd(allocator: std.mem.Allocator, out: *std.ArrayList(u8), actors: []const u8) void {
    if (actors.len == 0) return;
    var any = false;
    var it = std.mem.splitScalar(u8, actors, '|');
    while (it.next()) |name| {
        if (name.len == 0) continue;
        if (!any) {
            out.appendSlice(allocator, ",\"actor\":[") catch {};
            any = true;
        } else {
            out.append(allocator, ',') catch {};
        }
        out.appendSlice(allocator, "{\"@type\":\"Person\",\"name\":") catch {};
        appendJsonString(allocator, out, name);
        out.append(allocator, '}') catch {};
    }
    if (any) out.append(allocator, ']') catch {};
}

fn buildCatalogJsonLd(allocator: std.mem.Allocator, e: koru_media.koru_graph.Entry, files: []const koru_media.koru_graph.Entry) []const u8 {
    var out: std.ArrayList(u8) = .empty;
    const typ = jsonLdType(e, files);
    const series_name = workNameOf(e, files);
    const name: []const u8 = if (std.mem.eql(u8, typ, "TVSeries")) series_name else e.title;
    const series_work = std.mem.eql(u8, typ, "TVSeries");
    const nfo = koru_media.koru_graph.findNfoOverlay(e.path, e.season, e.episode, series_work);
    const imdb = workImdbOf(e, files);
    const hydrate = koru_media.koru_graph.findHydrateOverlay(imdb);
    const plot: []const u8 = if (nfo.plot.len > 0) nfo.plot else hydrate.plot;
    appendJsonLdCore(allocator, &out, typ, e, name, plot);
    if (e.poster.len == 0 and isRemotePoster(hydrate.poster_url)) {
        out.appendSlice(allocator, ",\"image\":") catch {};
        appendJsonString(allocator, &out, hydrate.poster_url);
    }
    if (nfo.aired.len > 0 and e.year == 0) {
        out.appendSlice(allocator, ",\"datePublished\":") catch {};
        appendJsonString(allocator, &out, nfo.aired);
    } else if (e.year == 0 and hydrate.year > 0) {
        var yb: [8]u8 = undefined;
        const ys = std.fmt.bufPrint(&yb, "{d}", .{hydrate.year}) catch "";
        if (ys.len > 0) {
            out.appendSlice(allocator, ",\"datePublished\":") catch {};
            appendJsonString(allocator, &out, ys);
        }
    }
    appendActorsJsonLd(allocator, &out, hydrate.actors);
    if (std.mem.eql(u8, typ, "TVSeries")) {
        appendImdbSameAs(allocator, &out, workImdbOf(e, files));
        var any_ep = false;
        for (files) |f| {
            if (entryIsExtra(f)) continue;
            if (!any_ep) {
                out.appendSlice(allocator, ",\"episode\":[") catch {};
                any_ep = true;
            } else {
                out.append(allocator, ',') catch {};
            }
            appendEpisodeStub(allocator, &out, f);
        }
        if (any_ep) out.append(allocator, ']') catch {};
    } else if (std.mem.eql(u8, typ, "TVEpisode")) {
        if (e.episode > 0) {
            out.appendSlice(allocator, ",\"episodeNumber\":") catch {};
            appendJsonU32(allocator, &out, e.episode);
        }
        if (e.season > 0) {
            out.appendSlice(allocator, ",\"partOfSeason\":{\"@type\":\"TVSeason\",\"seasonNumber\":") catch {};
            appendJsonU32(allocator, &out, e.season);
            out.append(allocator, '}') catch {};
        }
        out.appendSlice(allocator, ",\"partOfSeries\":{\"@type\":\"TVSeries\",\"name\":") catch {};
        appendJsonString(allocator, &out, series_name);
        const rep = workRepId(files, e.id);
        out.appendSlice(allocator, ",\"url\":") catch {};
        appendJsonAppUrl(allocator, &out, "/item/", rep);
        out.append(allocator, '}') catch {};
        appendImdbSameAs(allocator, &out, workImdbOf(e, files));
    } else {
        appendImdbSameAs(allocator, &out, e.imdb_id);
    }
    if (std.mem.eql(u8, typ, "TVSeries") or std.mem.eql(u8, typ, "Movie")) {
        if (firstTrailer(files)) |tr| {
            out.appendSlice(allocator, ",\"trailer\":{\"@type\":\"VideoObject\",\"contentUrl\":") catch {};
            appendJsonAppUrl(allocator, &out, "/media/", tr.id);
            out.append(allocator, '}') catch {};
        }
    }
    out.append(allocator, '}') catch {};
    return out.toOwnedSlice(allocator) catch "";
}

const ItemJsonLd = struct { text: []const u8, owned: bool };

fn resolveItemJsonLd(allocator: std.mem.Allocator, e: koru_media.koru_graph.Entry, files: []const koru_media.koru_graph.Entry, join: ?koru_media.koru_graph.SemanticJoin) ItemJsonLd {
    if (join) |s| {
        if (s.jsonld.len > 0) return .{ .text = s.jsonld, .owned = false };
    }
    return .{ .text = buildCatalogJsonLd(allocator, e, files), .owned = true };
}

fn appendJsonLdScript(allocator: std.mem.Allocator, html: *std.ArrayList(u8), json: []const u8) void {
    if (json.len == 0) return;
    html.appendSlice(allocator, "<script type=\"application/ld+json\">") catch {};
    for (json) |ch| {
        if (ch == '<') {
            html.appendSlice(allocator, "\\u003c") catch {};
        } else {
            html.append(allocator, ch) catch {};
        }
    }
    html.appendSlice(allocator, "</script>") catch {};
}

pub fn wantsJsonLd(query: ?[]const u8, accept: ?[]const u8) bool {
    if (queryValue(query, "format")) |fmt| {
        if (std.mem.eql(u8, fmt, "jsonld") or std.mem.eql(u8, fmt, "json")) return true;
    }
    const a = accept orelse return false;
    return std.ascii.indexOfIgnoreCase(a, "application/ld+json") != null or
        std.ascii.indexOfIgnoreCase(a, "application/json") != null;
}

pub fn itemJsonLd(allocator: std.mem.Allocator, id: []const u8) []const u8 {
    const e = koru_media.koru_graph.findEntry(id) orelse {
        return "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found";
    };
    const join = koru_media.koru_graph.findSemantic(id);
    var files_buf: [koru_media.koru_graph.MAX_PAGE]koru_media.koru_graph.Entry = undefined;
    const files = koru_media.koru_graph.collectWorkFiles(e.path, &files_buf);
    const doc = resolveItemJsonLd(allocator, e, files, join);
    defer if (doc.owned and doc.text.len > 0) allocator.free(doc.text);
    if (doc.text.len == 0) {
        return "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found";
    }
    var out: std.ArrayList(u8) = .empty;
    out.appendSlice(allocator, "HTTP/1.1 200 OK\r\nContent-Type: application/ld+json; charset=utf-8\r\n") catch {};
    {
        var lb: [32]u8 = undefined;
        const ls = std.fmt.bufPrint(&lb, "Content-Length: {d}\r\n", .{doc.text.len}) catch "";
        out.appendSlice(allocator, ls) catch {};
    }
    out.appendSlice(allocator, "Link: <") catch {};
    appendAppPath(allocator, &out, "/item/");
    out.appendSlice(allocator, id) catch {};
    out.appendSlice(allocator, ">; rel=\"alternate\"; type=\"text/html\"\r\nConnection: close\r\n\r\n") catch {};
    out.appendSlice(allocator, doc.text) catch {};
    return out.toOwnedSlice(allocator) catch "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 5\r\nConnection: close\r\n\r\nError";
}

fn joinHasCatalogue(s: koru_media.koru_graph.SemanticJoin, physical_title: []const u8) bool {
    if (s.display_description.len > 0) return true;
    if (s.tmdb_url.len > 0 or s.imdb_url.len > 0) return true;
    if (s.display_title.len > 0 and !std.mem.eql(u8, s.display_title, physical_title)) return true;
    return false;
}

fn appendHydrateOverlay(allocator: std.mem.Allocator, html: *std.ArrayList(u8), h: koru_media.koru_graph.HydrateMeta, include_plot: bool) void {
    if (include_plot and h.plot.len > 0) {
        const desc = htmlEscaped(allocator, h.plot);
        defer if (desc.ptr != h.plot.ptr) allocator.free(desc);
        html.appendSlice(allocator, "<p class=\"overview\">") catch {};
        html.appendSlice(allocator, desc) catch {};
        html.appendSlice(allocator, "</p>") catch {};
    }
    if (h.actors.len == 0) return;
    html.appendSlice(allocator, "<ul class=\"cast\">") catch {};
    var it = std.mem.splitScalar(u8, h.actors, '|');
    while (it.next()) |name| {
        if (name.len == 0) continue;
        const n = htmlEscaped(allocator, name);
        defer if (n.ptr != name.ptr) allocator.free(n);
        html.appendSlice(allocator, "<li>") catch {};
        html.appendSlice(allocator, n) catch {};
        html.appendSlice(allocator, "</li>") catch {};
    }
    html.appendSlice(allocator, "</ul>") catch {};
}

fn appendNfoOverlay(allocator: std.mem.Allocator, html: *std.ArrayList(u8), nfo: koru_media.koru_graph.NfoMeta, include_plot: bool) void {
    if (include_plot and nfo.plot.len > 0) {
        const desc = htmlEscaped(allocator, nfo.plot);
        defer if (desc.ptr != nfo.plot.ptr) allocator.free(desc);
        html.appendSlice(allocator, "<p class=\"overview\">") catch {};
        html.appendSlice(allocator, desc) catch {};
        html.appendSlice(allocator, "</p>") catch {};
    }
    if (nfo.aired.len > 0) {
        const aired = htmlEscaped(allocator, nfo.aired);
        defer if (aired.ptr != nfo.aired.ptr) allocator.free(aired);
        html.appendSlice(allocator, "<p class=\"meta-line nfo-aired\">aired ") catch {};
        html.appendSlice(allocator, aired) catch {};
        html.appendSlice(allocator, "</p>") catch {};
    }
    if (nfo.rating.len > 0) {
        const rating = htmlEscaped(allocator, nfo.rating);
        defer if (rating.ptr != nfo.rating.ptr) allocator.free(rating);
        html.appendSlice(allocator, "<p class=\"meta-line nfo-rating\">rating ") catch {};
        html.appendSlice(allocator, rating) catch {};
        html.appendSlice(allocator, "</p>") catch {};
    }
}

fn appendTrailerChips(allocator: std.mem.Allocator, html: *std.ArrayList(u8), files: []const koru_media.koru_graph.Entry) void {
    var n: usize = 0;
    for (files) |f| {
        if (!entryIsExtra(f)) continue;
        if (!koru_media.koru_graph.pathIsTrailer(f.path)) continue;
        const id_esc = htmlEscaped(allocator, f.id);
        defer if (id_esc.ptr != f.id.ptr) allocator.free(id_esc);
        html.appendSlice(allocator, " <a class=\"chip trailer\" href=\"") catch {};
        appendAppPath(allocator, html, "/watch/");
        html.appendSlice(allocator, id_esc) catch {};
        html.appendSlice(allocator, "\">") catch {};
        if (n == 0) {
            html.appendSlice(allocator, "Trailer</a>") catch {};
        } else {
            const t = htmlEscaped(allocator, f.title);
            defer if (t.ptr != f.title.ptr) allocator.free(t);
            html.appendSlice(allocator, t) catch {};
            html.appendSlice(allocator, "</a>") catch {};
        }
        n += 1;
    }
}

fn appendSemanticBlock(allocator: std.mem.Allocator, html: *std.ArrayList(u8), join: koru_media.koru_graph.SemanticJoin, include_overview: bool) void {
    if (include_overview and join.display_description.len > 0) {
        const desc = htmlEscaped(allocator, join.display_description);
        defer if (desc.ptr != join.display_description.ptr) allocator.free(desc);
        html.appendSlice(allocator, "<p class=\"overview\">") catch {};
        html.appendSlice(allocator, desc) catch {};
        html.appendSlice(allocator, "</p>") catch {};
    }
    if (join.tmdb_url.len > 0 or join.imdb_url.len > 0) {
        html.appendSlice(allocator, "<p class=\"provider-links\">") catch {};
        if (join.tmdb_url.len > 0) {
            const u = htmlEscaped(allocator, join.tmdb_url);
            defer if (u.ptr != join.tmdb_url.ptr) allocator.free(u);
            html.appendSlice(allocator, "<a class=\"chip\" rel=\"related\" href=\"") catch {};
            html.appendSlice(allocator, u) catch {};
            html.appendSlice(allocator, "\">TMDB</a>") catch {};
        }
        if (join.imdb_url.len > 0) {
            const u = htmlEscaped(allocator, join.imdb_url);
            defer if (u.ptr != join.imdb_url.ptr) allocator.free(u);
            html.appendSlice(allocator, "<a class=\"chip\" rel=\"related\" href=\"") catch {};
            html.appendSlice(allocator, u) catch {};
            html.appendSlice(allocator, "\">IMDb</a>") catch {};
        }
        html.appendSlice(allocator, "</p>") catch {};
    }
}

fn appendCatalogueBlock(allocator: std.mem.Allocator, html: *std.ArrayList(u8), join: koru_media.koru_graph.SemanticJoin, include_overview: bool) void {
    html.appendSlice(allocator, "<section class=\"catalogue\"><h2 class=\"pane-label\">Catalogue</h2>") catch {};
    appendSemanticBlock(allocator, html, join, include_overview);
    html.appendSlice(allocator, "</section>") catch {};
}

fn appendArchiveFacts(allocator: std.mem.Allocator, html: *std.ArrayList(u8), e: koru_media.koru_graph.Entry, container: []const u8, include_path: bool) void {
    html.appendSlice(allocator, "<section class=\"archive\"><h2 class=\"pane-label\">Local archive</h2>") catch {};
    {
        const file_title = htmlEscaped(allocator, e.title);
        defer if (file_title.ptr != e.title.ptr) allocator.free(file_title);
        html.appendSlice(allocator, "<p class=\"meta-line file-title\">file ") catch {};
        html.appendSlice(allocator, file_title) catch {};
        html.appendSlice(allocator, "</p>") catch {};
    }
    if (include_path and e.path.len > 0) {
        const path_esc = htmlEscaped(allocator, e.path);
        defer if (path_esc.ptr != e.path.ptr) allocator.free(path_esc);
        html.appendSlice(allocator, "<p class=\"meta-line file-path\">path <code>") catch {};
        html.appendSlice(allocator, path_esc) catch {};
        html.appendSlice(allocator, "</code></p>") catch {};
    }
    if (e.year >= 1000) {
        var year_buf: [64]u8 = undefined;
        const year_line = std.fmt.bufPrint(&year_buf, "<p class=\"meta-line\">year {d}</p>", .{e.year}) catch "";
        html.appendSlice(allocator, year_line) catch {};
    }
    {
        var cbuf: [128]u8 = undefined;
        const cline = std.fmt.bufPrint(&cbuf, "<p class=\"meta-line\">container <code>{s}</code></p>", .{container}) catch "";
        html.appendSlice(allocator, cline) catch {};
    }
    {
        var bbuf: [80]u8 = undefined;
        const bline = std.fmt.bufPrint(&bbuf, "<p class=\"meta-line file-bytes\">size {d} bytes</p>", .{e.bytes}) catch "";
        html.appendSlice(allocator, bline) catch {};
    }
    var probe_buf: [512]u8 = undefined;
    const probe = formatProbeNote(allocator, e, &probe_buf);
    if (probe.len > 0) html.appendSlice(allocator, probe) catch {};
    html.appendSlice(allocator, "</section>") catch {};
}

fn appendPhysicalPlain(allocator: std.mem.Allocator, html: *std.ArrayList(u8), e: koru_media.koru_graph.Entry, container: []const u8) void {
    if (e.year >= 1000) {
        var year_buf: [64]u8 = undefined;
        const year_line = std.fmt.bufPrint(&year_buf, "<p class=\"meta-line\">year {d}</p>", .{e.year}) catch "";
        html.appendSlice(allocator, year_line) catch {};
    }
    {
        var cbuf: [128]u8 = undefined;
        const cline = std.fmt.bufPrint(&cbuf, "<p class=\"meta-line\">container <code>{s}</code></p>", .{container}) catch "";
        html.appendSlice(allocator, cline) catch {};
    }
    var probe_buf: [512]u8 = undefined;
    const probe = formatProbeNote(allocator, e, &probe_buf);
    if (probe.len > 0) html.appendSlice(allocator, probe) catch {};
}

fn appendProviderLinkHeader(out: *std.ArrayList(u8), allocator: std.mem.Allocator, join: ?koru_media.koru_graph.SemanticJoin) void {
    const s = join orelse return;
    if (s.tmdb_url.len > 0) {
        out.appendSlice(allocator, ", <") catch {};
        out.appendSlice(allocator, s.tmdb_url) catch {};
        out.appendSlice(allocator, ">; rel=\"related\"") catch {};
    }
    if (s.imdb_url.len > 0) {
        out.appendSlice(allocator, ", <") catch {};
        out.appendSlice(allocator, s.imdb_url) catch {};
        out.appendSlice(allocator, ">; rel=\"related\"") catch {};
    }
}

pub fn queryFlag(query: ?[]const u8, name: []const u8) bool {
    const qs = query orelse return false;
    var it = std.mem.splitScalar(u8, qs, '&');
    while (it.next()) |raw| {
        const pair = std.mem.trim(u8, raw, " \t\r");
        if (std.mem.eql(u8, pair, name)) return true;
        var eq_buf: [64]u8 = undefined;
        if (name.len + 5 >= eq_buf.len) continue;
        const want = std.fmt.bufPrint(&eq_buf, "{s}=1", .{name}) catch continue;
        if (std.mem.eql(u8, pair, want)) return true;
    }
    return false;
}

fn itemHeading(e: koru_media.koru_graph.Entry, join: ?koru_media.koru_graph.SemanticJoin) []const u8 {
    if (join) |s| {
        if (s.display_title.len > 0) return s.display_title;
    }
    if (e.work_title.len > 0) return e.work_title;
    return e.title;
}

fn filesAreSeries(kind: []const u8, files: []const koru_media.koru_graph.Entry) bool {
    if (std.mem.eql(u8, kind, "tv")) return true;
    for (files) |f| {
        if (entryIsExtra(f)) continue;
        if (f.season > 0 or f.episode > 0) return true;
    }
    return false;
}

fn appendSeasons(allocator: std.mem.Allocator, html: *std.ArrayList(u8), files: []const koru_media.koru_graph.Entry) void {
    var any_ep = false;
    for (files) |f| {
        if (!entryIsExtra(f)) {
            any_ep = true;
            break;
        }
    }
    if (!any_ep) return;
    html.appendSlice(allocator, "<section class=\"seasons\">") catch {};
    var current_season: u32 = 0xFFFFFFFF;
    var list_open = false;
    for (files) |f| {
        if (entryIsExtra(f)) continue;
        if (f.season != current_season) {
            if (list_open) html.appendSlice(allocator, "</ol>") catch {};
            current_season = f.season;
            if (f.season == 0) {
                html.appendSlice(allocator, "<h2>Episodes</h2>") catch {};
            } else {
                var hbuf: [48]u8 = undefined;
                const h = std.fmt.bufPrint(&hbuf, "<h2>Season {d}</h2>", .{f.season}) catch "<h2>Season</h2>";
                html.appendSlice(allocator, h) catch {};
            }
            html.appendSlice(allocator, "<ol class=\"episode-list\">") catch {};
            list_open = true;
        }
        const ep_title = htmlEscaped(allocator, f.title);
        defer if (ep_title.ptr != f.title.ptr) allocator.free(ep_title);
        const ep_id = htmlEscaped(allocator, f.id);
        defer if (ep_id.ptr != f.id.ptr) allocator.free(ep_id);
        html.appendSlice(allocator, "<li><a href=\"") catch {};
        appendAppPath(allocator, html, "/watch/");
        html.appendSlice(allocator, ep_id) catch {};
        html.appendSlice(allocator, "\">") catch {};
        if (f.episode > 0) {
            var num: [2]u8 = undefined;
            two(&num, f.episode);
            html.appendSlice(allocator, "E") catch {};
            html.appendSlice(allocator, &num) catch {};
            html.appendSlice(allocator, " · ") catch {};
        }
        html.appendSlice(allocator, ep_title) catch {};
        html.appendSlice(allocator, "</a></li>") catch {};
    }
    if (list_open) html.appendSlice(allocator, "</ol>") catch {};
    html.appendSlice(allocator, "</section>") catch {};
}

fn appendEditions(allocator: std.mem.Allocator, html: *std.ArrayList(u8), files: []const koru_media.koru_graph.Entry, current_id: []const u8) void {
    var n: usize = 0;
    var any_3d = false;
    for (files) |f| {
        if (entryIsExtra(f)) continue;
        n += 1;
        if (koru_media.koru_graph.editionLooks3d(f.path)) any_3d = true;
    }
    if (n < 2) return;
    html.appendSlice(allocator, "<section class=\"editions\"><h2>Editions</h2><ul class=\"edition-list\">") catch {};
    for (files) |f| {
        if (entryIsExtra(f)) continue;
        const cap = editionCaption(f.path, any_3d);
        const cap_esc = htmlEscaped(allocator, cap);
        defer if (cap_esc.ptr != cap.ptr) allocator.free(cap_esc);
        const fid = htmlEscaped(allocator, f.id);
        defer if (fid.ptr != f.id.ptr) allocator.free(fid);
        html.appendSlice(allocator, "<li>") catch {};
        if (std.mem.eql(u8, f.id, current_id)) {
            html.appendSlice(allocator, "<strong>") catch {};
            html.appendSlice(allocator, cap_esc) catch {};
            html.appendSlice(allocator, "</strong>") catch {};
        } else {
            html.appendSlice(allocator, "<a href=\"") catch {};
            appendAppPath(allocator, html, "/watch/");
            html.appendSlice(allocator, fid) catch {};
            html.appendSlice(allocator, "\">") catch {};
            html.appendSlice(allocator, cap_esc) catch {};
            html.appendSlice(allocator, "</a>") catch {};
        }
        html.appendSlice(allocator, " · <a href=\"") catch {};
        appendAppPath(allocator, html, "/media/");
        html.appendSlice(allocator, fid) catch {};
        html.appendSlice(allocator, "?download=1\">download</a></li>") catch {};
    }
    html.appendSlice(allocator, "</ul></section>") catch {};
}

fn appendExtrasFrom(allocator: std.mem.Allocator, html: *std.ArrayList(u8), files: []const koru_media.koru_graph.Entry) void {
    const roles = [_][]const u8{ "soundtrack", "featurette", "document", "trailer", "extra" };
    var opened = false;
    for (roles) |role| {
        var any = false;
        for (files) |f| {
            if (!entryIsExtra(f)) continue;
            if (std.mem.eql(u8, koru_media.koru_graph.extraRole(f.path, f.mime), role)) {
                any = true;
                break;
            }
        }
        if (!any) continue;
        if (!opened) {
            html.appendSlice(allocator, "<section class=\"extras\">") catch {};
            opened = true;
        }
        html.appendSlice(allocator, "<h2>") catch {};
        html.appendSlice(allocator, extraHeading(role)) catch {};
        html.appendSlice(allocator, "</h2><ol class=\"episode-list extra-list\">") catch {};
        for (files) |f| {
            if (!entryIsExtra(f)) continue;
            if (!std.mem.eql(u8, koru_media.koru_graph.extraRole(f.path, f.mime), role)) continue;
            const ep_title = htmlEscaped(allocator, f.title);
            defer if (ep_title.ptr != f.title.ptr) allocator.free(ep_title);
            const ep_id = htmlEscaped(allocator, f.id);
            defer if (ep_id.ptr != f.id.ptr) allocator.free(ep_id);
            html.appendSlice(allocator, "<li><a href=\"") catch {};
            appendAppPath(allocator, html, "/watch/");
            html.appendSlice(allocator, ep_id) catch {};
            html.appendSlice(allocator, "\">") catch {};
            html.appendSlice(allocator, ep_title) catch {};
            html.appendSlice(allocator, "</a></li>") catch {};
        }
        html.appendSlice(allocator, "</ol>") catch {};
    }
    if (opened) html.appendSlice(allocator, "</section>") catch {};
}

pub fn itemHtml(allocator: std.mem.Allocator, id: []const u8) []const u8 {
    if (koru_media.koru_graph.findEntry(id)) |e| {
        const join = koru_media.koru_graph.findSemantic(id);
        const shown_title = itemHeading(e, join);
        const title = htmlEscaped(allocator, shown_title);
        defer if (title.ptr != shown_title.ptr) allocator.free(title);
        const id_esc = htmlEscaped(allocator, e.id);
        defer if (id_esc.ptr != e.id.ptr) allocator.free(id_esc);
        const container = htmlEscaped(allocator, e.container);
        defer if (container.ptr != e.container.ptr) allocator.free(container);
        const kind_esc = htmlEscaped(allocator, e.kind);
        defer if (kind_esc.ptr != e.kind.ptr) allocator.free(kind_esc);
        var files_buf: [koru_media.koru_graph.MAX_PAGE]koru_media.koru_graph.Entry = undefined;
        const files = koru_media.koru_graph.collectWorkFiles(e.path, &files_buf);
        const series = filesAreSeries(e.kind, files);
        const jsonld = resolveItemJsonLd(allocator, e, files, join);
        defer if (jsonld.owned and jsonld.text.len > 0) allocator.free(jsonld.text);
        const series_work = jsonLdIsSeriesWork(e, files);
        const nfo = koru_media.koru_graph.findNfoOverlay(e.path, e.season, e.episode, series_work);
        const hydrate = koru_media.koru_graph.findHydrateOverlay(workImdbOf(e, files));
        const skip_nfo_plot = if (join) |s| s.display_description.len > 0 else false;
        var html: std.ArrayList(u8) = .empty;
        html.appendSlice(allocator, "<!doctype html>") catch {};
        appendHtmlOpen(allocator, &html);
        html.appendSlice(allocator, "<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>") catch {};
        html.appendSlice(allocator, title) catch {};
        html.appendSlice(allocator, " · Koru Media</title>") catch {};
        appendStylesheet(allocator, &html);
        appendScriptEnhance(allocator, &html);
        appendJsonLdScript(allocator, &html, jsonld.text);
        html.appendSlice(allocator, "</head><body>") catch {};
        appendAppChrome(allocator, &html, e.kind, null, "item-page");
        html.appendSlice(allocator, "<article class=\"item\">") catch {};
        if (e.poster.len > 0) {
            html.appendSlice(allocator, "<div class=\"item-layout has-poster\"><div class=\"item-poster\"><img src=\"") catch {};
            appendAppPath(allocator, &html, "/art/");
            html.appendSlice(allocator, id_esc) catch {};
            html.appendSlice(allocator, "\" alt=\"\" width=\"240\"/></div><div class=\"item-body\">") catch {};
        } else if (isRemotePoster(hydrate.poster_url)) {
            const u = htmlEscaped(allocator, hydrate.poster_url);
            defer if (u.ptr != hydrate.poster_url.ptr) allocator.free(u);
            html.appendSlice(allocator, "<div class=\"item-layout has-poster\"><div class=\"item-poster\"><img src=\"") catch {};
            html.appendSlice(allocator, u) catch {};
            html.appendSlice(allocator, "\" alt=\"\" width=\"240\"/></div><div class=\"item-body\">") catch {};
        } else {
            html.appendSlice(allocator, "<div class=\"item-layout\"><div class=\"item-body\">") catch {};
        }
        html.appendSlice(allocator, "<h1>") catch {};
        html.appendSlice(allocator, title) catch {};
        html.appendSlice(allocator, "</h1>") catch {};
        appendNfoOverlay(allocator, &html, nfo, !skip_nfo_plot);
        appendHydrateOverlay(allocator, &html, hydrate, !skip_nfo_plot and nfo.plot.len == 0);
        const split = if (join) |s| joinHasCatalogue(s, e.title) else false;
        if (split) {
            appendCatalogueBlock(allocator, &html, join.?, true);
            if (!series) appendArchiveFacts(allocator, &html, e, container, true);
        } else {
            if (join) |s| {
                appendSemanticBlock(allocator, &html, s, true);
            }
            if (!series) appendPhysicalPlain(allocator, &html, e, container);
        }
        html.appendSlice(allocator, "<p class=\"item-actions\"><a class=\"primary\" href=\"") catch {};
        appendAppPath(allocator, &html, "/watch/");
        html.appendSlice(allocator, id_esc) catch {};
        html.appendSlice(allocator, "\">watch</a>") catch {};
        appendTrailerChips(allocator, &html, files);
        html.appendSlice(allocator, " <a href=\"") catch {};
        appendAppPath(allocator, &html, "/media/");
        html.appendSlice(allocator, id_esc) catch {};
        html.appendSlice(allocator, "?download=1\">download</a>") catch {};
        if (e.subtitle.len > 0) {
            html.appendSlice(allocator, " <a href=\"") catch {};
            appendAppPath(allocator, &html, "/subtitles/");
            html.appendSlice(allocator, id_esc) catch {};
            html.appendSlice(allocator, "\">subtitles</a>") catch {};
        }
        html.appendSlice(allocator, " <a href=\"") catch {};
        appendAppPath(allocator, &html, "/library/");
        html.appendSlice(allocator, kind_esc) catch {};
        html.appendSlice(allocator, "\">more ") catch {};
        html.appendSlice(allocator, kindLabel(e.kind)) catch {};
        html.appendSlice(allocator, "</a> <a href=\"") catch {};
        appendAppPath(allocator, &html, "/library");
        html.appendSlice(allocator, "\">library</a></p>") catch {};
        if (series) appendSeasons(allocator, &html, files) else appendEditions(allocator, &html, files, e.id);
        appendExtrasFrom(allocator, &html, files);
        html.appendSlice(allocator, "</div></div></article>") catch {};
        appendAppChromeEnd(allocator, &html);
        html.appendSlice(allocator, "</body></html>") catch {};
        const body = html.toOwnedSlice(allocator) catch "item error";
        var link: std.ArrayList(u8) = .empty;
        link.appendSlice(allocator, "<") catch {};
        appendAppPath(allocator, &link, "/item/");
        link.appendSlice(allocator, id_esc) catch {};
        link.appendSlice(allocator, ">; rel=\"self\", <") catch {};
        appendAppPath(allocator, &link, "/library");
        link.appendSlice(allocator, ">; rel=\"up\", <") catch {};
        appendAppPath(allocator, &link, "/library/");
        link.appendSlice(allocator, kind_esc) catch {};
        link.appendSlice(allocator, ">; rel=\"collection\", <") catch {};
        appendAppPath(allocator, &link, "/watch/");
        link.appendSlice(allocator, id_esc) catch {};
        link.appendSlice(allocator, ">; rel=\"related\", <") catch {};
        appendAppPath(allocator, &link, "/media/");
        link.appendSlice(allocator, id_esc) catch {};
        link.appendSlice(allocator, ">; rel=\"related\"") catch {};
        if (e.poster.len > 0) {
            link.appendSlice(allocator, ", <") catch {};
            appendAppPath(allocator, &link, "/art/");
            link.appendSlice(allocator, id_esc) catch {};
            link.appendSlice(allocator, ">; rel=\"preview\"") catch {};
        }
        if (e.subtitle.len > 0) {
            link.appendSlice(allocator, ", <") catch {};
            appendAppPath(allocator, &link, "/subtitles/");
            link.appendSlice(allocator, id_esc) catch {};
            link.appendSlice(allocator, ">; rel=\"related\"") catch {};
        }
        if (jsonld.text.len > 0) {
            link.appendSlice(allocator, ", <") catch {};
            appendAppPath(allocator, &link, "/item/");
            link.appendSlice(allocator, id_esc) catch {};
            link.appendSlice(allocator, "?format=jsonld>; rel=\"alternate\"; type=\"application/ld+json\"") catch {};
        }
        if (join) |s| {
            appendProviderLinkHeader(&link, allocator, s);
        }
        return renderHttpHtml(allocator, link.toOwnedSlice(allocator) catch "</library>; rel=\"up\"", body);
    }
    return "HTTP/1.1 404 Not Found\r\nContent-Type: text/html\r\nContent-Length: 58\r\nConnection: close\r\n\r\n<!doctype html><html><body><h1>Not Found</h1></body></html>";
}

pub fn watchHtml(allocator: std.mem.Allocator, id: []const u8) []const u8 {
    if (koru_media.koru_graph.findEntry(id)) |e| {
        const tag = koru_media.koru_graph.playerTag(e);
        const join = koru_media.koru_graph.findSemantic(id);
        const shown_title: []const u8 = if (join) |s| (if (s.display_title.len > 0) s.display_title else e.title) else e.title;
        const title = htmlEscaped(allocator, shown_title);
        defer if (title.ptr != shown_title.ptr) allocator.free(title);
        const id_esc = htmlEscaped(allocator, e.id);
        defer if (id_esc.ptr != e.id.ptr) allocator.free(id_esc);
        const container = htmlEscaped(allocator, e.container);
        defer if (container.ptr != e.container.ptr) allocator.free(container);
        const kind_esc = htmlEscaped(allocator, e.kind);
        defer if (kind_esc.ptr != e.kind.ptr) allocator.free(kind_esc);
        var html: std.ArrayList(u8) = .empty;
        html.appendSlice(allocator, "<!doctype html>") catch {};
        appendHtmlOpen(allocator, &html);
        html.appendSlice(allocator, "<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Watch ") catch {};
        html.appendSlice(allocator, title) catch {};
        html.appendSlice(allocator, " · Koru Media</title>") catch {};
        appendStylesheet(allocator, &html);
        appendScriptEnhance(allocator, &html);
        html.appendSlice(allocator, "</head><body>") catch {};
        appendAppChrome(allocator, &html, e.kind, null, "watch");
        html.appendSlice(allocator, "<h1>") catch {};
        html.appendSlice(allocator, title) catch {};
        html.appendSlice(allocator, "</h1>") catch {};
        const split = if (join) |s| joinHasCatalogue(s, e.title) else false;
        if (split) {
            appendCatalogueBlock(allocator, &html, join.?, false);
            appendArchiveFacts(allocator, &html, e, container, false);
        } else if (join) |s| {
            appendSemanticBlock(allocator, &html, s, false);
        }
        if (!likelyBrowserPlayable(e.container) and (std.mem.eql(u8, tag, "video") or std.mem.eql(u8, tag, "audio"))) {
            var note_buf: [512]u8 = undefined;
            const note = if (e.video_brand.len > 0) blk: {
                const brand = htmlEscaped(allocator, e.video_brand);
                defer if (brand.ptr != e.video_brand.ptr) allocator.free(brand);
                break :blk std.fmt.bufPrint(&note_buf, "<p class=\"capability\" role=\"status\">This <code>{s}</code> file (brand <code>{s}</code>) may not play in the browser. Use <a href=\"{s}/media/{s}?download=1\">download</a> if playback fails.</p>", .{ container, brand, bp(), id_esc }) catch "";
            } else std.fmt.bufPrint(&note_buf, "<p class=\"capability\" role=\"status\">This <code>{s}</code> file may not play in the browser. Use <a href=\"{s}/media/{s}?download=1\">download</a> if playback fails.</p>", .{ container, bp(), id_esc }) catch "";
            html.appendSlice(allocator, note) catch {};
        }
        if (!split) {
            var probe_buf: [512]u8 = undefined;
            const probe = formatProbeNote(allocator, e, &probe_buf);
            if (probe.len > 0) html.appendSlice(allocator, probe) catch {};
        }
        html.appendSlice(allocator, "<div class=\"watch-stage\">") catch {};
        // Player owns identity outside any hx-target / #library-region.
        // Native <audio>/<video> when the browser can; otherwise a plugin slot.
        if (std.mem.eql(u8, tag, "audio")) {
            var player_buf: [448]u8 = undefined;
            const player = std.fmt.bufPrint(&player_buf, "<audio id=\"player\" data-player=\"audio\" data-media-id=\"{s}\" controls src=\"{s}/media/{s}\"></audio>", .{ id_esc, bp(), id_esc }) catch "";
            html.appendSlice(allocator, player) catch {};
        } else if (std.mem.eql(u8, tag, "video") and e.subtitle.len > 0) {
            var player_buf: [768]u8 = undefined;
            const player = std.fmt.bufPrint(&player_buf, "<video id=\"player\" data-player=\"video\" data-media-id=\"{s}\" controls src=\"{s}/media/{s}\"><track kind=\"subtitles\" src=\"{s}/subtitles/{s}\" srclang=\"en\" label=\"English\" default></video>", .{ id_esc, bp(), id_esc, bp(), id_esc }) catch "";
            html.appendSlice(allocator, player) catch {};
        } else if (std.mem.eql(u8, tag, "video")) {
            var player_buf: [448]u8 = undefined;
            const player = std.fmt.bufPrint(&player_buf, "<video id=\"player\" data-player=\"video\" data-media-id=\"{s}\" controls src=\"{s}/media/{s}\"></video>", .{ id_esc, bp(), id_esc }) catch "";
            html.appendSlice(allocator, player) catch {};
        } else if (std.mem.eql(u8, tag, "pdf")) {
            var player_buf: [576]u8 = undefined;
            const player = std.fmt.bufPrint(&player_buf, "<iframe id=\"player\" data-player=\"pdf\" data-media-id=\"{s}\" src=\"{s}/media/{s}\" title=\"PDF\"></iframe>", .{ id_esc, bp(), id_esc }) catch "";
            html.appendSlice(allocator, player) catch {};
        } else {
            var player_buf: [768]u8 = undefined;
            const player = std.fmt.bufPrint(&player_buf, "<div id=\"player\" data-player=\"{s}\" data-media-id=\"{s}\" data-mime=\"{s}\" class=\"player-fallback\"><p>This title is not a browser-native stream. <a href=\"{s}/media/{s}?download=1\">Download</a> or attach a player plugin.</p></div>", .{ e.kind, id_esc, e.mime, bp(), id_esc }) catch "";
            html.appendSlice(allocator, player) catch {};
        }
        html.appendSlice(allocator, "</div>") catch {};
        // Filled by enhance.js when a saved resume position exists; never replaces #player.
        html.appendSlice(allocator, "<p id=\"resume-ui\" class=\"resume\" role=\"status\" hidden></p>") catch {};
        var nav_buf: [640]u8 = undefined;
        const nav = if (e.subtitle.len > 0)
            std.fmt.bufPrint(&nav_buf, "<p class=\"watch-nav\"><a href=\"{s}/item/{s}\">item</a> · <a href=\"{s}/media/{s}?download=1\">download</a> · <a href=\"{s}/subtitles/{s}\">subtitles</a> · <a href=\"{s}/library/{s}\">more {s}</a></p>", .{ bp(), id_esc, bp(), id_esc, bp(), id_esc, bp(), kind_esc, kind_esc }) catch ""
        else
            std.fmt.bufPrint(&nav_buf, "<p class=\"watch-nav\"><a href=\"{s}/item/{s}\">item</a> · <a href=\"{s}/media/{s}?download=1\">download</a> · <a href=\"{s}/library/{s}\">more {s}</a></p>", .{ bp(), id_esc, bp(), id_esc, bp(), kind_esc, kind_esc }) catch "";
        html.appendSlice(allocator, nav) catch {};
        {
            var work_files: [koru_media.koru_graph.MAX_PAGE]koru_media.koru_graph.Entry = undefined;
            const files = koru_media.koru_graph.collectWorkFiles(e.path, &work_files);
            if (!filesAreSeries(e.kind, files)) appendEditions(allocator, &html, files, e.id);
            appendExtrasFrom(allocator, &html, files);
        }
        html.appendSlice(allocator, "<section class=\"related\" aria-label=\"Related in collection\"><h2>More in collection</h2>") catch {};
        appendLibraryList(allocator, &html, e.kind, .title, null, 4, 0, true, true);
        html.appendSlice(allocator, "</section>") catch {};
        appendAppChromeEnd(allocator, &html);
        html.appendSlice(allocator, "</body></html>") catch {};
        const body = html.toOwnedSlice(allocator) catch "watch error";
        var link: std.ArrayList(u8) = .empty;
        link.appendSlice(allocator, "<") catch {};
        appendAppPath(allocator, &link, "/watch/");
        link.appendSlice(allocator, id_esc) catch {};
        link.appendSlice(allocator, ">; rel=\"self\", <") catch {};
        appendAppPath(allocator, &link, "/item/");
        link.appendSlice(allocator, id_esc) catch {};
        link.appendSlice(allocator, ">; rel=\"up\", <") catch {};
        appendAppPath(allocator, &link, "/media/");
        link.appendSlice(allocator, id_esc) catch {};
        link.appendSlice(allocator, ">; rel=\"related\"") catch {};
        if (e.subtitle.len > 0) {
            link.appendSlice(allocator, ", <") catch {};
            appendAppPath(allocator, &link, "/subtitles/");
            link.appendSlice(allocator, id_esc) catch {};
            link.appendSlice(allocator, ">; rel=\"related\"") catch {};
        }
        link.appendSlice(allocator, ", <") catch {};
        appendAppPath(allocator, &link, "/library/");
        link.appendSlice(allocator, kind_esc) catch {};
        link.appendSlice(allocator, ">; rel=\"collection\"") catch {};
        if (join) |s| {
            appendProviderLinkHeader(&link, allocator, s);
        }
        return renderHttpHtml(allocator, link.toOwnedSlice(allocator) catch "</library>; rel=\"up\"", body);
    }
    return "HTTP/1.1 404 Not Found\r\nContent-Type: text/html\r\nContent-Length: 58\r\nConnection: close\r\n\r\n<!doctype html><html><body><h1>Not Found</h1></body></html>";
}

// ============================================================================
// ============================================================================

pub fn artHttp(allocator: std.mem.Allocator, id: []const u8) []const u8 {
    koru_media.koru_graph.ensureConfig();
    const e = koru_media.koru_graph.findEntry(id) orelse {
        return "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found";
    };
    if (e.poster.len == 0) {
        return "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found";
    }
    var path_buf: [4096]u8 = undefined;
    const full_path = koru_media.koru_graph.pathUnderRoot(e.poster, &path_buf) orelse {
        return "HTTP/1.1 403 Forbidden\r\nContent-Length: 9\r\nConnection: close\r\n\r\nForbidden";
    };
    const file = std.fs.cwd().openFile(full_path, .{}) catch {
        return "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found";
    };
    defer file.close();
    const data = file.readToEndAlloc(allocator, 8 * 1024 * 1024) catch {
        return "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 5\r\nConnection: close\r\n\r\nError";
    };
    const ctype: []const u8 = if (std.mem.endsWith(u8, e.poster, ".webp"))
        "image/webp"
    else if (std.mem.endsWith(u8, e.poster, ".png"))
        "image/png"
    else
        "image/jpeg";
    var head: std.ArrayList(u8) = .empty;
    head.appendSlice(allocator, "HTTP/1.1 200 OK\r\nContent-Type: ") catch {};
    head.appendSlice(allocator, ctype) catch {};
    head.appendSlice(allocator, "\r\n") catch {};
    {
        var lb: [48]u8 = undefined;
        const ls = std.fmt.bufPrint(&lb, "Content-Length: {d}\r\n", .{data.len}) catch "";
        head.appendSlice(allocator, ls) catch {};
    }
    head.appendSlice(allocator, "Cache-Control: public, max-age=3600\r\nConnection: close\r\n\r\n") catch {};
    head.appendSlice(allocator, data) catch {};
    return head.toOwnedSlice(allocator) catch "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 5\r\nConnection: close\r\n\r\nError";
}

pub fn subtitlesHttp(allocator: std.mem.Allocator, id: []const u8) []const u8 {
    koru_media.koru_graph.ensureConfig();
    const e = koru_media.koru_graph.findEntry(id) orelse {
        return "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found";
    };
    if (e.subtitle.len == 0) {
        return "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found";
    }
    var path_buf: [4096]u8 = undefined;
    const full_path = koru_media.koru_graph.pathUnderRoot(e.subtitle, &path_buf) orelse {
        return "HTTP/1.1 403 Forbidden\r\nContent-Length: 9\r\nConnection: close\r\n\r\nForbidden";
    };
    const file = std.fs.cwd().openFile(full_path, .{}) catch {
        return "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found";
    };
    defer file.close();
    // WebVTT sidecars are small; full read is fine (Range stays on /media only).
    const data = file.readToEndAlloc(allocator, 1 * 1024 * 1024) catch {
        return "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 5\r\nConnection: close\r\n\r\nError";
    };
    var head: std.ArrayList(u8) = .empty;
    head.appendSlice(allocator, "HTTP/1.1 200 OK\r\nContent-Type: text/vtt; charset=utf-8\r\n") catch {};
    {
        var lb: [48]u8 = undefined;
        const ls = std.fmt.bufPrint(&lb, "Content-Length: {d}\r\n", .{data.len}) catch "";
        head.appendSlice(allocator, ls) catch {};
    }
    head.appendSlice(allocator, "Cache-Control: public, max-age=3600\r\nConnection: close\r\n\r\n") catch {};
    head.appendSlice(allocator, data) catch {};
    return head.toOwnedSlice(allocator) catch "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 5\r\nConnection: close\r\n\r\nError";
}

pub fn mediaHttp(allocator: std.mem.Allocator, method: []const u8, id: []const u8, range: ?[]const u8, download: bool, if_none_match: ?[]const u8) []const u8 {
    koru_media.koru_graph.ensureConfig();
    const e = koru_media.koru_graph.findEntry(id) orelse {
        return "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found";
    };
    var path_buf: [4096]u8 = undefined;
    const full_path = koru_media.koru_graph.pathUnderRoot(e.path, &path_buf) orelse {
        return "HTTP/1.1 403 Forbidden\r\nContent-Length: 9\r\nConnection: close\r\n\r\nForbidden";
    };
    const file = std.fs.cwd().openFile(full_path, .{}) catch {
        return "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nConnection: close\r\n\r\nNot Found";
    };
    defer file.close();
    // Zig 0.15 File.stat uses statx; DSM ACL shares reject it (500). fstat matches ingest.
    const size: u64 = blk: {
        const pst = std.posix.fstat(file.handle) catch break :blk e.bytes;
        break :blk std.fs.File.Stat.fromPosix(pst).size;
    };

    var etag_buf: [96]u8 = undefined;
    const etag = std.fmt.bufPrint(&etag_buf, "{s}-{d}", .{ e.id, size }) catch "";
    if (range == null) {
        if (if_none_match) |inm| {
            if (std.mem.eql(u8, inm, etag) or std.mem.eql(u8, inm, "*")) {
                var not_mod: [160]u8 = undefined;
                const nm = std.fmt.bufPrint(&not_mod, "HTTP/1.1 304 Not Modified\r\nETag: \"{s}\"\r\nContent-Length: 0\r\nConnection: close\r\n\r\n", .{etag}) catch "HTTP/1.1 304 Not Modified\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
                return allocator.dupe(u8, nm) catch nm;
            }
        }
    }

    var start: u64 = 0;
    var end: u64 = if (size == 0) 0 else size - 1;
    var status_line: []const u8 = "HTTP/1.1 200 OK\r\n";
    const is_head = std.mem.eql(u8, method, "HEAD");
    var used_range = false;

    if (range) |rh| {
        const trimmed = std.mem.trim(u8, rh, " \t");
        if (parseBytesRange(trimmed, size)) |br| {
            start = br.start;
            end = br.end;
            status_line = "HTTP/1.1 206 Partial Content\r\n";
            used_range = true;
        } else {
            var msg: [192]u8 = undefined;
            const m = std.fmt.bufPrint(&msg, "HTTP/1.1 416 Range Not Satisfiable\r\nContent-Range: bytes */{d}\r\nContent-Length: 0\r\nAccept-Ranges: bytes\r\nConnection: close\r\n\r\n", .{size}) catch "HTTP/1.1 416 Range Not Satisfiable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
            return allocator.dupe(u8, m) catch m;
        }
    }

    const content_len: u64 = if (size == 0) 0 else end - start + 1;
    var head: std.ArrayList(u8) = .empty;
    head.appendSlice(allocator, status_line) catch {};
    {
        var line: [320]u8 = undefined;
        const l = std.fmt.bufPrint(&line, "Content-Type: {s}\r\nContent-Length: {d}\r\nAccept-Ranges: bytes\r\nETag: \"{s}\"\r\n", .{ e.mime, content_len, etag }) catch "";
        head.appendSlice(allocator, l) catch {};
    }
    if (download) {
        // Basename only — path is already validated relative.
        var base: []const u8 = e.path;
        if (std.mem.lastIndexOfScalar(u8, e.path, '/')) |slash| {
            base = e.path[slash + 1 ..];
        }
        var disp: [256]u8 = undefined;
        const dline = std.fmt.bufPrint(&disp, "Content-Disposition: attachment; filename=\"{s}\"\r\n", .{base}) catch "Content-Disposition: attachment\r\n";
        head.appendSlice(allocator, dline) catch {};
    }
    if (e.modified_ns > 0) {
        var date_buf: [29]u8 = undefined;
        formatHttpDateFromNs(&date_buf, e.modified_ns);
        head.appendSlice(allocator, "Last-Modified: ") catch {};
        head.appendSlice(allocator, &date_buf) catch {};
        head.appendSlice(allocator, "\r\n") catch {};
    }
    if (used_range and size > 0) {
        var line: [128]u8 = undefined;
        const l = std.fmt.bufPrint(&line, "Content-Range: bytes {d}-{d}/{d}\r\n", .{ start, end, size }) catch "";
        head.appendSlice(allocator, l) catch {};
    }
    head.appendSlice(allocator, "Connection: close\r\n\r\n") catch {};

    if (is_head or content_len == 0) {
        return head.toOwnedSlice(allocator) catch "HEAD error";
    }

    // STREAM:v1 — send|zig writes headers then chunks the file (no full-range buffer).
    var stream: std.ArrayList(u8) = .empty;
    stream.appendSlice(allocator, "STREAM:v1\n") catch {};
    stream.appendSlice(allocator, full_path) catch {};
    stream.appendSlice(allocator, "\n") catch {};
    {
        var nb: [48]u8 = undefined;
        const s = std.fmt.bufPrint(&nb, "{d}\n{d}\n\n", .{ start, end }) catch "0\n0\n\n";
        stream.appendSlice(allocator, s) catch {};
    }
    stream.appendSlice(allocator, head.items) catch {};
    head.deinit(allocator);
    return stream.toOwnedSlice(allocator) catch "media error";
}

pub fn mediaOptions(id: []const u8) []const u8 {
    _ = id;
    return "HTTP/1.1 204 No Content\r\nAllow: GET, HEAD, OPTIONS\r\nAccept-Ranges: bytes\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
}

const StaticBody = struct { status: u16, body: []const u8, content_type: ?[]const u8 };

pub fn staticFallback(method: []const u8, path: []const u8, if_none_match: ?[]const u8) ?StaticBody {
    _ = if_none_match;
    if (!std.mem.eql(u8, method, "GET")) return null;
    if (std.mem.eql(u8, path, "/smoke.html") or std.mem.eql(u8, path, "/smoke")) {
        return .{
            .status = 200,
            .body = "<!doctype html><html><head><title>smoke</title></head><body><p>static ok</p></body></html>",
            .content_type = "text/html",
        };
    }
    // Allowlisted public assets only (no directory listing / path join).
    if (std.mem.eql(u8, path, "/enhance.js")) {
        return readPublicFile("public/enhance.js", "application/javascript; charset=utf-8", 256 * 1024);
    }
    if (std.mem.eql(u8, path, "/app.css")) {
        return readPublicFile("public/app.css", "text/css; charset=utf-8", 128 * 1024);
    }
    if (std.mem.eql(u8, path, "/koru-dom-enhance.js")) {
        return readPublicFile("public/koru-dom-enhance.js", "application/javascript; charset=utf-8", 512 * 1024);
    }
    if (std.mem.eql(u8, path, "/enhance-demo.html") or std.mem.eql(u8, path, "/enhance-demo")) {
        return readPublicFile("public/enhance-demo.html", "text/html; charset=utf-8", 64 * 1024);
    }
    return null;
}

fn readPublicFile(rel: []const u8, content_type: []const u8, max: usize) StaticBody {
    const file = std.fs.cwd().openFile(rel, .{}) catch {
        return .{ .status = 404, .body = "Not Found", .content_type = "text/plain" };
    };
    defer file.close();
    const allocator = std.heap.c_allocator;
    const data = file.readToEndAlloc(allocator, max) catch {
        return .{ .status = 500, .body = "Error", .content_type = "text/plain" };
    };
    return .{ .status = 200, .body = data, .content_type = content_type };
}
