// media/catalog — SQLite physical index. Page-sized reads; no RAM cap on
// library size. Handlers never call TMDB, TVDB, or ffmpeg. Graph tables
// (sem_*) are the catalogue store; hydrate_works is a one-shot migrate source.

const std = @import("std");

const sqlite3 = opaque {};
const sqlite3_stmt = opaque {};

extern fn sqlite3_open(filename: [*:0]const u8, ppDb: *?*sqlite3) c_int;
extern fn sqlite3_close(db: ?*sqlite3) c_int;
extern fn sqlite3_exec(db: ?*sqlite3, sql: [*:0]const u8, cb: ?*anyopaque, arg: ?*anyopaque, err: *?[*:0]u8) c_int;
extern fn sqlite3_prepare_v2(db: ?*sqlite3, sql: [*:0]const u8, nByte: c_int, ppStmt: *?*sqlite3_stmt, pzTail: ?*?*const u8) c_int;
extern fn sqlite3_bind_text(stmt: ?*sqlite3_stmt, idx: c_int, val: [*]const u8, n: c_int, destructor: ?*const anyopaque) c_int;
extern fn sqlite3_bind_int64(stmt: ?*sqlite3_stmt, idx: c_int, val: i64) c_int;
extern fn sqlite3_bind_null(stmt: ?*sqlite3_stmt, idx: c_int) c_int;
extern fn sqlite3_step(stmt: ?*sqlite3_stmt) c_int;
extern fn sqlite3_reset(stmt: ?*sqlite3_stmt) c_int;
extern fn sqlite3_finalize(stmt: ?*sqlite3_stmt) c_int;
extern fn sqlite3_column_text(stmt: ?*sqlite3_stmt, i: c_int) ?[*:0]const u8;
extern fn sqlite3_column_bytes(stmt: ?*sqlite3_stmt, i: c_int) c_int;
extern fn sqlite3_column_int64(stmt: ?*sqlite3_stmt, i: c_int) i64;
extern fn sqlite3_errmsg(db: ?*sqlite3) [*:0]const u8;
extern fn sqlite3_free(p: ?*anyopaque) void;
extern fn sqlite3_changes(db: ?*sqlite3) c_int;

const SQLITE_OK: c_int = 0;
const SQLITE_ROW: c_int = 100;
const SQLITE_DONE: c_int = 101;
const SQLITE_TRANSIENT: ?*const anyopaque = @ptrFromInt(@as(usize, @bitCast(@as(isize, -1))));

const SCHEMA =
    \\CREATE TABLE IF NOT EXISTS entries (
    \\  id TEXT PRIMARY KEY,
    \\  kind TEXT NOT NULL,
    \\  title TEXT NOT NULL,
    \\  path TEXT NOT NULL UNIQUE,
    \\  bytes INTEGER NOT NULL,
    \\  modified_ns INTEGER NOT NULL,
    \\  mime TEXT NOT NULL,
    \\  container TEXT NOT NULL,
    \\  poster TEXT NOT NULL DEFAULT '',
    \\  backdrop TEXT NOT NULL DEFAULT '',
    \\  logo TEXT NOT NULL DEFAULT '',
    \\  subtitle TEXT NOT NULL DEFAULT '',
    \\  year INTEGER NOT NULL DEFAULT 0,
    \\  video_codec TEXT NOT NULL DEFAULT '',
    \\  video_brand TEXT NOT NULL DEFAULT '',
    \\  audio_codec TEXT NOT NULL DEFAULT '',
    \\  work_key TEXT NOT NULL DEFAULT '',
    \\  season INTEGER NOT NULL DEFAULT 0,
    \\  episode INTEGER NOT NULL DEFAULT 0,
    \\  imdb_id TEXT NOT NULL DEFAULT '',
    \\  work_title TEXT NOT NULL DEFAULT ''
    \\);
    \\CREATE INDEX IF NOT EXISTS idx_entries_kind ON entries(kind);
    \\CREATE INDEX IF NOT EXISTS idx_entries_title ON entries(title COLLATE NOCASE);
    \\CREATE INDEX IF NOT EXISTS idx_entries_work ON entries(work_key);
    \\CREATE INDEX IF NOT EXISTS idx_entries_modified ON entries(modified_ns);
    \\CREATE TABLE IF NOT EXISTS nfo_works (
    \\  work_key TEXT PRIMARY KEY,
    \\  plot TEXT NOT NULL DEFAULT '',
    \\  aired TEXT NOT NULL DEFAULT '',
    \\  rating TEXT NOT NULL DEFAULT '',
    \\  trailer_youtube TEXT NOT NULL DEFAULT ''
    \\);
    \\CREATE TABLE IF NOT EXISTS nfo_episodes (
    \\  work_key TEXT NOT NULL,
    \\  season INTEGER NOT NULL,
    \\  episode INTEGER NOT NULL,
    \\  plot TEXT NOT NULL DEFAULT '',
    \\  aired TEXT NOT NULL DEFAULT '',
    \\  rating TEXT NOT NULL DEFAULT '',
    \\  PRIMARY KEY (work_key, season, episode)
    \\);
    \\CREATE INDEX IF NOT EXISTS idx_nfo_episodes_work ON nfo_episodes(work_key);
    \\CREATE TABLE IF NOT EXISTS hydrate_works (
    \\  imdb_id TEXT PRIMARY KEY,
    \\  work_key TEXT NOT NULL DEFAULT '',
    \\  source TEXT NOT NULL DEFAULT '',
    \\  tmdb_id TEXT NOT NULL DEFAULT '',
    \\  tvdb_id TEXT NOT NULL DEFAULT '',
    \\  title TEXT NOT NULL DEFAULT '',
    \\  plot TEXT NOT NULL DEFAULT '',
    \\  year INTEGER NOT NULL DEFAULT 0,
    \\  poster_url TEXT NOT NULL DEFAULT '',
    \\  actors TEXT NOT NULL DEFAULT '',
    \\  retrieved_at TEXT NOT NULL DEFAULT ''
    \\);
    \\CREATE INDEX IF NOT EXISTS idx_hydrate_works_key ON hydrate_works(work_key);
    \\CREATE TABLE IF NOT EXISTS library_roots (
    \\  id INTEGER PRIMARY KEY,
    \\  display_name TEXT NOT NULL,
    \\  rel_path TEXT NOT NULL UNIQUE,
    \\  enabled INTEGER NOT NULL DEFAULT 1,
    \\  sort INTEGER NOT NULL DEFAULT 0,
    \\  capability TEXT NOT NULL DEFAULT '',
    \\  affordances TEXT NOT NULL DEFAULT ''
    \\);
    \\CREATE INDEX IF NOT EXISTS idx_library_roots_sort ON library_roots(sort);
    \\CREATE TABLE IF NOT EXISTS sem_entities (
    \\  id TEXT PRIMARY KEY,
    \\  type TEXT NOT NULL
    \\);
    \\CREATE TABLE IF NOT EXISTS sem_assertions (
    \\  entity TEXT NOT NULL,
    \\  property TEXT NOT NULL,
    \\  value TEXT NOT NULL DEFAULT '',
    \\  source_json TEXT NOT NULL DEFAULT '',
    \\  status TEXT NOT NULL DEFAULT 'accepted',
    \\  retrieved_at TEXT NOT NULL DEFAULT '',
    \\  PRIMARY KEY (entity, property, source_json)
    \\);
    \\CREATE INDEX IF NOT EXISTS idx_sem_assertions_entity ON sem_assertions(entity);
    \\CREATE TABLE IF NOT EXISTS sem_provider_ids (
    \\  entity TEXT NOT NULL,
    \\  provider TEXT NOT NULL,
    \\  namespace TEXT NOT NULL DEFAULT '',
    \\  value TEXT NOT NULL,
    \\  url TEXT NOT NULL DEFAULT '',
    \\  PRIMARY KEY (entity, provider, namespace, value)
    \\);
    \\CREATE TABLE IF NOT EXISTS sem_relations (
    \\  subject TEXT NOT NULL,
    \\  kind TEXT NOT NULL,
    \\  object TEXT NOT NULL,
    \\  ordinal INTEGER NOT NULL DEFAULT 0,
    \\  source TEXT NOT NULL DEFAULT '',
    \\  PRIMARY KEY (subject, kind, object)
    \\);
    \\CREATE INDEX IF NOT EXISTS idx_sem_relations_kind ON sem_relations(subject, kind, ordinal);
    \\CREATE TABLE IF NOT EXISTS sem_asset_links (
    \\  asset_id TEXT NOT NULL,
    \\  entity_id TEXT NOT NULL,
    \\  role TEXT NOT NULL DEFAULT 'main',
    \\  PRIMARY KEY (asset_id, entity_id, role)
    \\);
    \\CREATE INDEX IF NOT EXISTS idx_sem_asset_entity ON sem_asset_links(entity_id);
    \\CREATE TABLE IF NOT EXISTS sem_migrate (
    \\  key TEXT PRIMARY KEY,
    \\  done INTEGER NOT NULL DEFAULT 0
    \\);
;

pub const LibraryRoot = struct {
    display_name: []const u8,
    rel_path: []const u8,
    enabled: bool,
    capability: []const u8 = "",
    affordances: []const u8 = "",
};

pub const MAX_LIBRARY_ROOTS: usize = 16;
var roots_store: [8192]u8 = undefined;
var roots_store_len: usize = 0;

const ENTRY_COLS = "id,kind,title,path,bytes,modified_ns,mime,container,poster,subtitle,year,video_codec,video_brand,audio_codec,season,episode,imdb_id,work_title,backdrop,logo";
const NFO_MAX: usize = 64 * 1024;
const COVER_SCAN: usize = 256 * 1024;
const JPEG_MAX: usize = 512 * 1024;
var nfo_read_buf: [NFO_MAX]u8 = undefined;
var cover_scan_buf: [COVER_SCAN]u8 = undefined;
var nfo_plot_buf: [2048]u8 = undefined;
var nfo_aired_buf: [32]u8 = undefined;
var nfo_rating_buf: [24]u8 = undefined;
var nfo_title_parse_buf: [256]u8 = undefined;
var nfo_youtube_buf: [16]u8 = undefined;
var nfo_overlay_store: [4096]u8 = undefined;
var nfo_overlay_len: usize = 0;
var nfo_imdb_buf: [16]u8 = undefined;
var hydrate_overlay_store: [12 * 1024]u8 = undefined;
var hydrate_overlay_len: usize = 0;

const DEFAULT_CATALOG = "data/catalog.sqlite";
pub const MAX_PAGE: usize = 256;

var db: ?*sqlite3 = null;
var catalog_path_owned: []const u8 = DEFAULT_CATALOG;
var find_store: [8192]u8 = undefined;
var find_store_len: usize = 0;
var page_store: [96 * 1024]u8 = undefined;
var page_store_len: usize = 0;
var work_store: [32 * 1024]u8 = undefined;
var work_store_len: usize = 0;
var catalog_ready = false;

fn storeDup(store: []u8, used: *usize, s: []const u8) []const u8 {
    if (s.len == 0) return "";
    if (used.* + s.len > store.len) return "";
    const out = store[used.* .. used.* + s.len];
    @memcpy(out, s);
    used.* += s.len;
    return out;
}

fn colText(stmt: ?*sqlite3_stmt, i: c_int) []const u8 {
    const p = sqlite3_column_text(stmt, i) orelse return "";
    const n = sqlite3_column_bytes(stmt, i);
    if (n <= 0) return "";
    return p[0..@as(usize, @intCast(n))];
}

fn bindText(stmt: ?*sqlite3_stmt, idx: c_int, s: []const u8) void {
    const empty: [1]u8 = .{0};
    const p: [*]const u8 = if (s.len == 0) &empty else s.ptr;
    _ = sqlite3_bind_text(stmt, idx, p, @intCast(s.len), SQLITE_TRANSIENT);
}

fn rowToEntry(stmt: ?*sqlite3_stmt, store: []u8, used: *usize) koru_media.koru_graph.Entry {
    const year_i = sqlite3_column_int64(stmt, 10);
    const year: u32 = if (year_i < 0 or year_i > 9999) 0 else @intCast(year_i);
    const season_i = sqlite3_column_int64(stmt, 14);
    const episode_i = sqlite3_column_int64(stmt, 15);
    const season: u32 = if (season_i < 0 or season_i > 9999) 0 else @intCast(season_i);
    const episode: u32 = if (episode_i < 0 or episode_i > 9999) 0 else @intCast(episode_i);
    return .{
        .id = storeDup(store, used, colText(stmt, 0)),
        .kind = storeDup(store, used, colText(stmt, 1)),
        .title = storeDup(store, used, colText(stmt, 2)),
        .path = storeDup(store, used, colText(stmt, 3)),
        .bytes = @intCast(sqlite3_column_int64(stmt, 4)),
        .modified_ns = @intCast(sqlite3_column_int64(stmt, 5)),
        .mime = storeDup(store, used, colText(stmt, 6)),
        .container = storeDup(store, used, colText(stmt, 7)),
        .poster = storeDup(store, used, colText(stmt, 8)),
        .subtitle = storeDup(store, used, colText(stmt, 9)),
        .year = year,
        .video_codec = storeDup(store, used, colText(stmt, 11)),
        .video_brand = storeDup(store, used, colText(stmt, 12)),
        .audio_codec = storeDup(store, used, colText(stmt, 13)),
        .season = season,
        .episode = episode,
        .imdb_id = storeDup(store, used, colText(stmt, 16)),
        .work_title = storeDup(store, used, colText(stmt, 17)),
        .backdrop = storeDup(store, used, colText(stmt, 18)),
        .logo = storeDup(store, used, colText(stmt, 19)),
    };
}

fn zsql(buf: []u8, s: []const u8) ?[*:0]const u8 {
    if (s.len + 1 > buf.len) return null;
    @memcpy(buf[0..s.len], s);
    buf[s.len] = 0;
    return @ptrCast(buf.ptr);
}

fn execSql(sql: [*:0]const u8) void {
    var err: ?[*:0]u8 = null;
    const rc = sqlite3_exec(db, sql, null, null, &err);
    if (rc != SQLITE_OK) {
        if (err) |e| {
            std.debug.print("sqlite exec: {s}\n", .{e});
            sqlite3_free(e);
        }
    }
}

fn columnExists(name: []const u8) bool {
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "PRAGMA table_info(entries)", -1, &stmt, null) != SQLITE_OK) return false;
    defer _ = sqlite3_finalize(stmt);
    while (sqlite3_step(stmt) == SQLITE_ROW) {
        if (std.mem.eql(u8, colText(stmt, 1), name)) return true;
    }
    return false;
}

fn ensureColumn(name: []const u8, sql: [*:0]const u8) void {
    if (columnExists(name)) return;
    execSql(sql);
}

fn nfoWorksColumnExists(name: []const u8) bool {
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "PRAGMA table_info(nfo_works)", -1, &stmt, null) != SQLITE_OK) return false;
    defer _ = sqlite3_finalize(stmt);
    while (sqlite3_step(stmt) == SQLITE_ROW) {
        if (std.mem.eql(u8, colText(stmt, 1), name)) return true;
    }
    return false;
}

fn migrateColumns() void {
    ensureColumn("season", "ALTER TABLE entries ADD COLUMN season INTEGER NOT NULL DEFAULT 0");
    ensureColumn("episode", "ALTER TABLE entries ADD COLUMN episode INTEGER NOT NULL DEFAULT 0");
    ensureColumn("imdb_id", "ALTER TABLE entries ADD COLUMN imdb_id TEXT NOT NULL DEFAULT ''");
    ensureColumn("work_title", "ALTER TABLE entries ADD COLUMN work_title TEXT NOT NULL DEFAULT ''");
    ensureColumn("backdrop", "ALTER TABLE entries ADD COLUMN backdrop TEXT NOT NULL DEFAULT ''");
    ensureColumn("logo", "ALTER TABLE entries ADD COLUMN logo TEXT NOT NULL DEFAULT ''");
    if (!nfoWorksColumnExists("trailer_youtube")) {
        execSql("ALTER TABLE nfo_works ADD COLUMN trailer_youtube TEXT NOT NULL DEFAULT ''");
    }
}

fn libraryRootColumnExists(name: []const u8) bool {
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "PRAGMA table_info(library_roots)", -1, &stmt, null) != SQLITE_OK) return false;
    defer _ = sqlite3_finalize(stmt);
    while (sqlite3_step(stmt) == SQLITE_ROW) {
        if (std.mem.eql(u8, colText(stmt, 1), name)) return true;
    }
    return false;
}

fn migrateLibraryRoots() void {
    if (!libraryRootColumnExists("capability")) {
        execSql("ALTER TABLE library_roots ADD COLUMN capability TEXT NOT NULL DEFAULT ''");
    }
    if (!libraryRootColumnExists("affordances")) {
        execSql("ALTER TABLE library_roots ADD COLUMN affordances TEXT NOT NULL DEFAULT ''");
    }
}

/// Well-known first-segment names used when a row has no capability yet.
pub fn inferCapability(rel: []const u8) []const u8 {
    if (std.ascii.eqlIgnoreCase(rel, "movies")) return "movies";
    if (std.ascii.eqlIgnoreCase(rel, "shows") or std.ascii.eqlIgnoreCase(rel, "tv")) return "series";
    if (std.ascii.eqlIgnoreCase(rel, "music")) return "music";
    if (std.ascii.eqlIgnoreCase(rel, "books")) return "books";
    if (std.ascii.eqlIgnoreCase(rel, "musicvideos") or std.ascii.eqlIgnoreCase(rel, "musicvidoes")) return "music_videos";
    return "mixed";
}

pub fn inferAffordances(capability: []const u8) []const u8 {
    if (std.mem.eql(u8, capability, "series")) return "episode_graph,extras,audio_as_extra";
    if (std.mem.eql(u8, capability, "movies")) return "extras,audio_as_extra";
    return "";
}

pub fn hasAffordance(list: []const u8, name: []const u8) bool {
    var it = std.mem.splitScalar(u8, list, ',');
    while (it.next()) |part| {
        const p = std.mem.trim(u8, part, " \t");
        if (std.mem.eql(u8, p, name)) return true;
    }
    return false;
}

fn filledCapability(rel: []const u8, stored: []const u8) []const u8 {
    if (stored.len > 0) return stored;
    return inferCapability(rel);
}

fn filledAffordances(rel: []const u8, cap: []const u8, stored: []const u8) []const u8 {
    if (stored.len > 0) return stored;
    return inferAffordances(if (cap.len > 0) cap else inferCapability(rel));
}

pub fn open(path: []const u8) void {
    if (catalog_ready) return;
    catalog_path_owned = path;
    if (std.mem.lastIndexOfScalar(u8, path, '/')) |slash| {
        if (slash > 0) std.fs.cwd().makePath(path[0..slash]) catch {};
    }
    var zpath: [512]u8 = undefined;
    if (path.len + 1 > zpath.len) return;
    @memcpy(zpath[0..path.len], path);
    zpath[path.len] = 0;
    var pdb: ?*sqlite3 = null;
    var rc = sqlite3_open(@ptrCast(&zpath), &pdb);
    if (rc != SQLITE_OK) {
        _ = sqlite3_close(pdb);
        pdb = null;
        rc = sqlite3_open(":memory:", &pdb);
        if (rc != SQLITE_OK) {
            std.debug.print("sqlite open failed\n", .{});
            return;
        }
        std.debug.print("catalog not writable ({s}); using memory db\n", .{path});
    }
    db = pdb;
    execSql(SCHEMA);
    migrateColumns();
    migrateLibraryRoots();
    catalog_ready = true;
    ensureLibraryRoots();
}

var graph_store: [16 * 1024]u8 = undefined;
var graph_store_len: usize = 0;
var kind_store: [1024]u8 = undefined;
var kind_store_len: usize = 0;

pub fn upsertEntity(id: []const u8, typ: []const u8) void {
    if (!catalog_ready or id.len == 0) return;
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "INSERT INTO sem_entities(id, type) VALUES(?,?) ON CONFLICT(id) DO UPDATE SET type=excluded.type", -1, &stmt, null) != SQLITE_OK) return;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, id);
    bindText(stmt, 2, typ);
    _ = sqlite3_step(stmt);
}

pub fn upsertAssertion(entity: []const u8, property: []const u8, value: []const u8, source: []const u8) void {
    if (!catalog_ready or entity.len == 0 or property.len == 0 or value.len == 0) return;
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\INSERT INTO sem_assertions(entity, property, value, source_json, status) VALUES(?,?,?,?, 'accepted')
        \\ON CONFLICT(entity, property, source_json) DO UPDATE SET value=excluded.value, status='accepted'
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, entity);
    bindText(stmt, 2, property);
    bindText(stmt, 3, value);
    bindText(stmt, 4, source);
    _ = sqlite3_step(stmt);
}

pub fn upsertProviderId(entity: []const u8, provider: []const u8, namespace: []const u8, value: []const u8, url: []const u8) void {
    if (!catalog_ready or entity.len == 0 or provider.len == 0 or value.len == 0) return;
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\INSERT INTO sem_provider_ids(entity, provider, namespace, value, url) VALUES(?,?,?,?,?)
        \\ON CONFLICT(entity, provider, namespace, value) DO UPDATE SET url=excluded.url
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, entity);
    bindText(stmt, 2, provider);
    bindText(stmt, 3, namespace);
    bindText(stmt, 4, value);
    bindText(stmt, 5, url);
    _ = sqlite3_step(stmt);
}

pub fn upsertRelation(subject: []const u8, kind: []const u8, object: []const u8, ordinal: u32, source: []const u8) void {
    if (!catalog_ready or subject.len == 0 or kind.len == 0 or object.len == 0) return;
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\INSERT INTO sem_relations(subject, kind, object, ordinal, source) VALUES(?,?,?,?,?)
        \\ON CONFLICT(subject, kind, object) DO UPDATE SET ordinal=excluded.ordinal, source=excluded.source
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, subject);
    bindText(stmt, 2, kind);
    bindText(stmt, 3, object);
    _ = sqlite3_bind_int64(stmt, 4, ordinal);
    bindText(stmt, 5, source);
    _ = sqlite3_step(stmt);
}

pub fn upsertAssetLink(asset_id: []const u8, entity_id: []const u8, role: []const u8) void {
    if (!catalog_ready or asset_id.len == 0 or entity_id.len == 0) return;
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\INSERT INTO sem_asset_links(asset_id, entity_id, role) VALUES(?,?,?)
        \\ON CONFLICT(asset_id, entity_id, role) DO NOTHING
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, asset_id);
    bindText(stmt, 2, entity_id);
    bindText(stmt, 3, if (role.len > 0) role else "main");
    _ = sqlite3_step(stmt);
}

pub fn relate(subject: []const u8, kind: []const u8, out: []koru_media.koru_graph.Related) []koru_media.koru_graph.Related {
    graph_store_len = 0;
    if (!catalog_ready or subject.len == 0) return out[0..0];
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT object, ordinal FROM sem_relations WHERE subject=? AND kind=? ORDER BY ordinal ASC, object ASC LIMIT 256", -1, &stmt, null) != SQLITE_OK) return out[0..0];
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, subject);
    bindText(stmt, 2, kind);
    var n: usize = 0;
    while (sqlite3_step(stmt) == SQLITE_ROW and n < out.len) {
        const ord_i = sqlite3_column_int64(stmt, 1);
        const ordinal: u32 = if (ord_i < 0 or ord_i > 9999) 0 else @intCast(ord_i);
        out[n] = .{
            .id = storeDup(&graph_store, &graph_store_len, colText(stmt, 0)),
            .ordinal = ordinal,
        };
        n += 1;
    }
    return out[0..n];
}

pub fn entityForAsset(asset_id: []const u8) []const u8 {
    if (!catalog_ready or asset_id.len == 0) return "";
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT entity_id FROM sem_asset_links WHERE asset_id=? ORDER BY CASE role WHEN 'main' THEN 0 ELSE 1 END LIMIT 1", -1, &stmt, null) != SQLITE_OK) return "";
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, asset_id);
    if (sqlite3_step(stmt) != SQLITE_ROW) return "";
    return storeDup(&graph_store, &graph_store_len, colText(stmt, 0));
}

pub fn assertionValue(entity_id: []const u8, property: []const u8) []const u8 {
    if (!catalog_ready or entity_id.len == 0) return "";
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT value FROM sem_assertions WHERE entity=? AND property=? AND status='accepted' LIMIT 1", -1, &stmt, null) != SQLITE_OK) return "";
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, entity_id);
    bindText(stmt, 2, property);
    if (sqlite3_step(stmt) != SQLITE_ROW) return "";
    return storeDup(&graph_store, &graph_store_len, colText(stmt, 0));
}

pub fn trailerAssetFor(entity_id: []const u8) []const u8 {
    if (!catalog_ready or entity_id.len == 0) return "";
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT asset_id FROM sem_asset_links WHERE entity_id=? AND role='trailer' LIMIT 1", -1, &stmt, null) != SQLITE_OK) return "";
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, entity_id);
    if (sqlite3_step(stmt) != SQLITE_ROW) return "";
    return storeDup(&graph_store, &graph_store_len, colText(stmt, 0));
}

pub fn assetForEntity(entity_id: []const u8) []const u8 {
    if (!catalog_ready or entity_id.len == 0) return "";
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT asset_id FROM sem_asset_links WHERE entity_id=? AND role='main' LIMIT 1", -1, &stmt, null) != SQLITE_OK) return "";
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, entity_id);
    if (sqlite3_step(stmt) != SQLITE_ROW) return "";
    return storeDup(&graph_store, &graph_store_len, colText(stmt, 0));
}

fn findImdbForAsset(asset_id: []const u8) []const u8 {
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT imdb_id FROM entries WHERE id=? LIMIT 1", -1, &stmt, null) != SQLITE_OK) return "";
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, asset_id);
    if (sqlite3_step(stmt) != SQLITE_ROW) return "";
    return storeDup(&graph_store, &graph_store_len, colText(stmt, 0));
}

pub fn findHero() ?koru_media.koru_graph.HeroInfo {
    graph_store_len = 0;
    if (!catalog_ready) return null;
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\SELECT e.id, COALESCE(NULLIF(e.work_title,''), e.title), e.poster, e.backdrop, e.logo, e.year
        \\FROM entries e
        \\WHERE e.kind IN ('movie','tv')
        \\ORDER BY e.modified_ns DESC, e.id ASC LIMIT 1
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return null;
    defer _ = sqlite3_finalize(stmt);
    if (sqlite3_step(stmt) != SQLITE_ROW) return null;
    const asset = storeDup(&graph_store, &graph_store_len, colText(stmt, 0));
    const title = storeDup(&graph_store, &graph_store_len, colText(stmt, 1));
    const poster = storeDup(&graph_store, &graph_store_len, colText(stmt, 2));
    const backdrop = storeDup(&graph_store, &graph_store_len, colText(stmt, 3));
    const logo = storeDup(&graph_store, &graph_store_len, colText(stmt, 4));
    const year_i = sqlite3_column_int64(stmt, 5);
    const year: u32 = if (year_i < 0 or year_i > 9999) 0 else @intCast(year_i);
    const ent = entityForAsset(asset);
    var plot: []const u8 = "";
    var trailer: []const u8 = "";
    var yt: []const u8 = "";
    if (ent.len > 0) {
        plot = assertionValue(ent, "description");
        trailer = trailerAssetFor(ent);
        yt = assertionValue(ent, "trailer_youtube");
    }
    const hydrate = findHydrateForAsset(asset, findImdbForAsset(asset));
    if (plot.len == 0) plot = hydrate.plot;
    const year_out: u32 = if (year > 0) year else hydrate.year;
    return .{
        .asset_id = asset,
        .title = title,
        .plot = plot,
        .trailer_id = trailer,
        .youtube_key = yt,
        .has_poster = poster.len > 0 or isRemoteHttp(hydrate.poster_url),
        .poster_url = if (poster.len > 0) "" else storeDup(&graph_store, &graph_store_len, hydrate.poster_url),
        .has_backdrop = backdrop.len > 0 or isRemoteHttp(hydrate.backdrop_url),
        .backdrop_url = if (backdrop.len > 0) "" else storeDup(&graph_store, &graph_store_len, hydrate.backdrop_url),
        .has_logo = logo.len > 0 or isRemoteHttp(hydrate.logo_url),
        .logo_url = if (logo.len > 0) "" else storeDup(&graph_store, &graph_store_len, hydrate.logo_url),
        .year = year_out,
    };
}

var hero_store: [24 * 1024]u8 = undefined;
var hero_store_len: usize = 0;

fn trailerIdForWork(asset_id: []const u8, work_key: []const u8) []const u8 {
    const ent = entityForAsset(asset_id);
    if (ent.len > 0) {
        const linked = trailerAssetFor(ent);
        if (linked.len > 0) return storeDup(&hero_store, &hero_store_len, linked);
    }
    if (work_key.len == 0) return "";
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT id FROM entries WHERE work_key=? AND (path LIKE '%/trailers/%' OR path LIKE '%/trailer/%') LIMIT 1", -1, &stmt, null) != SQLITE_OK) return "";
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, work_key);
    if (sqlite3_step(stmt) != SQLITE_ROW) return "";
    return storeDup(&hero_store, &hero_store_len, colText(stmt, 0));
}

/// Recent movie/tv works for the home carousel. Art and trailers are optional.
pub fn listHeroes(out: []koru_media.koru_graph.HeroInfo) []koru_media.koru_graph.HeroInfo {
    hero_store_len = 0;
    if (!catalog_ready or out.len == 0) return out[0..0];
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\SELECT e.id, COALESCE(NULLIF(e.work_title,''), e.title), e.path, e.poster, e.imdb_id, e.work_key, e.backdrop, e.logo, e.year
        \\FROM entries e
        \\WHERE e.kind IN ('movie','tv')
        \\AND e.id IN (SELECT MIN(id) FROM entries WHERE kind IN ('movie','tv') GROUP BY CASE WHEN work_key='' THEN id ELSE work_key END)
        \\ORDER BY e.modified_ns DESC, e.id ASC LIMIT 8
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return out[0..0];
    defer _ = sqlite3_finalize(stmt);
    var n: usize = 0;
    while (sqlite3_step(stmt) == SQLITE_ROW and n < out.len) {
        const asset = storeDup(&hero_store, &hero_store_len, colText(stmt, 0));
        const title = storeDup(&hero_store, &hero_store_len, colText(stmt, 1));
        const poster = storeDup(&hero_store, &hero_store_len, colText(stmt, 3));
        const imdb = storeDup(&hero_store, &hero_store_len, colText(stmt, 4));
        const work = storeDup(&hero_store, &hero_store_len, colText(stmt, 5));
        const backdrop = storeDup(&hero_store, &hero_store_len, colText(stmt, 6));
        const logo = storeDup(&hero_store, &hero_store_len, colText(stmt, 7));
        const year_i = sqlite3_column_int64(stmt, 8);
        const year: u32 = if (year_i < 0 or year_i > 9999) 0 else @intCast(year_i);
        const hydrate = findHydrateForAsset(asset, imdb);
        var plot: []const u8 = storeDup(&hero_store, &hero_store_len, hydrate.plot);
        var yt: []const u8 = "";
        const ent = entityForAsset(asset);
        if (ent.len > 0) {
            const desc = assertionValue(ent, "description");
            if (plot.len == 0) plot = storeDup(&hero_store, &hero_store_len, desc);
            yt = storeDup(&hero_store, &hero_store_len, assertionValue(ent, "trailer_youtube"));
        }
        if (yt.len == 0 or plot.len == 0) {
            const nfo = findNfoOverlay(work, 0, 0, true);
            if (plot.len == 0 and nfo.plot.len > 0) plot = storeDup(&hero_store, &hero_store_len, nfo.plot);
            if (yt.len == 0 and nfo.youtube.len > 0) yt = storeDup(&hero_store, &hero_store_len, nfo.youtube);
        }
        const trailer = trailerIdForWork(asset, work);
        const year_out: u32 = if (year > 0) year else hydrate.year;
        out[n] = .{
            .asset_id = asset,
            .title = title,
            .plot = plot,
            .trailer_id = trailer,
            .youtube_key = yt,
            .has_poster = poster.len > 0 or isRemoteHttp(hydrate.poster_url),
            .poster_url = if (poster.len > 0) "" else storeDup(&hero_store, &hero_store_len, hydrate.poster_url),
            .has_backdrop = backdrop.len > 0 or isRemoteHttp(hydrate.backdrop_url),
            .backdrop_url = if (backdrop.len > 0) "" else storeDup(&hero_store, &hero_store_len, hydrate.backdrop_url),
            .has_logo = logo.len > 0 or isRemoteHttp(hydrate.logo_url),
            .logo_url = if (logo.len > 0) "" else storeDup(&hero_store, &hero_store_len, hydrate.logo_url),
            .year = year_out,
        };
        n += 1;
    }
    return out[0..n];
}

fn isRemoteHttp(url: []const u8) bool {
    return std.mem.startsWith(u8, url, "https://") or std.mem.startsWith(u8, url, "http://");
}

pub fn listPresentKinds(out: [][]const u8) [][]const u8 {
    kind_store_len = 0;
    if (!catalog_ready) return out[0..0];
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT DISTINCT kind FROM entries ORDER BY kind ASC LIMIT 16", -1, &stmt, null) != SQLITE_OK) return out[0..0];
    defer _ = sqlite3_finalize(stmt);
    var n: usize = 0;
    while (sqlite3_step(stmt) == SQLITE_ROW and n < out.len) {
        out[n] = storeDup(&kind_store, &kind_store_len, colText(stmt, 0));
        n += 1;
    }
    return out[0..n];
}

var actor_store: [4096]u8 = undefined;
var actor_store_len: usize = 0;

/// Distinct actor names whose hydrate/nfo string contains `q`. Empty q returns none.
pub fn searchActors(q: []const u8, out: [][]const u8) [][]const u8 {
    actor_store_len = 0;
    if (!catalog_ready or q.len == 0 or out.len == 0) return out[0..0];
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT value FROM sem_assertions WHERE property='actors' AND value LIKE '%' || ? || '%' COLLATE NOCASE LIMIT 32", -1, &stmt, null) != SQLITE_OK) return out[0..0];
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, q);
    var n: usize = 0;
    while (sqlite3_step(stmt) == SQLITE_ROW and n < out.len) {
        const raw = colText(stmt, 0);
        var it = std.mem.splitScalar(u8, raw, '|');
        while (it.next()) |name| {
            if (name.len == 0) continue;
            if (std.ascii.indexOfIgnoreCase(name, q) == null) continue;
            var dup = false;
            for (out[0..n]) |seen| {
                if (std.ascii.eqlIgnoreCase(seen, name)) {
                    dup = true;
                    break;
                }
            }
            if (dup) continue;
            out[n] = storeDup(&actor_store, &actor_store_len, name);
            n += 1;
            if (n >= out.len) break;
        }
    }
    return out[0..n];
}

fn libraryRootCount() usize {
    if (!catalog_ready) return 0;
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT COUNT(*) FROM library_roots", -1, &stmt, null) != SQLITE_OK) return 0;
    defer _ = sqlite3_finalize(stmt);
    if (sqlite3_step(stmt) != SQLITE_ROW) return 0;
    const n = sqlite3_column_int64(stmt, 0);
    if (n < 0) return 0;
    return @intCast(n);
}

fn ensureLibraryRoots() void {
    if (!catalog_ready) return;
    if (libraryRootCount() > 0) return;
    execSql(
        \\INSERT INTO library_roots(display_name, rel_path, enabled, sort, capability, affordances) VALUES
        \\ ('Movies','movies',1,0,'movies','extras,audio_as_extra'),
        \\ ('Series','shows',1,1,'series','episode_graph,extras,audio_as_extra'),
        \\ ('Music','music',1,2,'music',''),
        \\ ('Books','books',1,3,'books',''),
        \\ ('Music videos','musicVideos',1,4,'music_videos','')
    );
}

pub fn listLibraryRoots(out: []LibraryRoot) []LibraryRoot {
    if (!catalog_ready) return out[0..0];
    ensureLibraryRoots();
    roots_store_len = 0;
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT display_name, rel_path, enabled, capability, affordances FROM library_roots ORDER BY sort, id", -1, &stmt, null) != SQLITE_OK) {
        return out[0..0];
    }
    defer _ = sqlite3_finalize(stmt);
    var n: usize = 0;
    while (sqlite3_step(stmt) == SQLITE_ROW and n < out.len) {
        const enabled_i = sqlite3_column_int64(stmt, 2);
        const rel = storeDup(&roots_store, &roots_store_len, colText(stmt, 1));
        const cap_raw = colText(stmt, 3);
        const aff_raw = colText(stmt, 4);
        const cap = filledCapability(rel, cap_raw);
        const aff = filledAffordances(rel, cap, aff_raw);
        out[n] = .{
            .display_name = storeDup(&roots_store, &roots_store_len, colText(stmt, 0)),
            .rel_path = rel,
            .enabled = enabled_i != 0,
            .capability = storeDup(&roots_store, &roots_store_len, cap),
            .affordances = storeDup(&roots_store, &roots_store_len, aff),
        };
        n += 1;
    }
    return out[0..n];
}

pub fn saveLibraryRoots(roots: []const LibraryRoot) bool {
    if (!catalog_ready) return false;
    execSql("DELETE FROM library_roots");
    var i: usize = 0;
    while (i < roots.len) : (i += 1) {
        const r = roots[i];
        var stmt: ?*sqlite3_stmt = null;
        const sql = "INSERT OR IGNORE INTO library_roots(display_name, rel_path, enabled, sort, capability, affordances) VALUES(?,?,?,?,?,?)";
        if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return false;
        const cap = filledCapability(r.rel_path, r.capability);
        const aff = filledAffordances(r.rel_path, cap, r.affordances);
        bindText(stmt, 1, r.display_name);
        bindText(stmt, 2, r.rel_path);
        _ = sqlite3_bind_int64(stmt, 3, if (r.enabled) 1 else 0);
        _ = sqlite3_bind_int64(stmt, 4, @intCast(i));
        bindText(stmt, 5, cap);
        bindText(stmt, 6, aff);
        _ = sqlite3_step(stmt);
        _ = sqlite3_finalize(stmt);
    }
    return true;
}

pub fn count() usize {
    if (!catalog_ready) return 0;
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT COUNT(*) FROM entries", -1, &stmt, null) != SQLITE_OK) return 0;
    defer _ = sqlite3_finalize(stmt);
    if (sqlite3_step(stmt) != SQLITE_ROW) return 0;
    const n = sqlite3_column_int64(stmt, 0);
    if (n < 0) return 0;
    return @intCast(n);
}

fn slugFromWork(work: []const u8, buf: []u8) []const u8 {
    var w: usize = 0;
    var i: usize = 0;
    while (i < work.len and w + 1 < buf.len) : (i += 1) {
        const ch = work[i];
        if (ch == '/') {
            w = 0;
            continue;
        }
        const lower = std.ascii.toLower(ch);
        if ((lower >= 'a' and lower <= 'z') or (lower >= '0' and lower <= '9')) {
            buf[w] = lower;
            w += 1;
        } else if (w > 0 and buf[w - 1] != '-') {
            buf[w] = '-';
            w += 1;
        }
    }
    while (w > 0 and buf[w - 1] == '-') w -= 1;
    return buf[0..w];
}

fn encodeOneEntryGraph(e: koru_media.koru_graph.Entry) void {
    const extra = std.mem.eql(u8, e.kind, "extra") or std.mem.eql(u8, koru_media.koru_graph.fileKind(e.path), "extra");
    const work = koru_media.koru_graph.workKey(e.path);
    var slug_buf: [128]u8 = undefined;
    const slug = slugFromWork(work, &slug_buf);
    if (slug.len == 0) return;
    var id_buf: [192]u8 = undefined;
    if (extra) {
        if (koru_media.koru_graph.pathIsTrailer(e.path)) {
            const series_id = std.fmt.bufPrint(&id_buf, "series.{s}", .{slug}) catch return;
            upsertEntity(series_id, "TVSeries");
            upsertAssetLink(e.id, series_id, "trailer");
            upsertRelation(series_id, "has_asset", e.id, 0, "filename");
        }
        return;
    }
    if (e.season > 0 or e.episode > 0 or std.mem.eql(u8, e.kind, "tv")) {
        const series_id = std.fmt.bufPrint(&id_buf, "series.{s}", .{slug}) catch return;
        const series_owned = storeDup(&graph_store, &graph_store_len, series_id);
        upsertEntity(series_owned, "TVSeries");
        if (e.work_title.len > 0) upsertAssertion(series_owned, "name", e.work_title, "filename");
        {
            const work_nfo = findNfoOverlay(work, 0, 0, true);
            if (work_nfo.plot.len > 0) upsertAssertion(series_owned, "description", work_nfo.plot, "nfo");
            if (work_nfo.youtube.len > 0) upsertAssertion(series_owned, "trailer_youtube", work_nfo.youtube, "nfo");
        }
        if (e.imdb_id.len > 0) {
            var url_buf: [80]u8 = undefined;
            const url = std.fmt.bufPrint(&url_buf, "https://www.imdb.com/title/{s}/", .{e.imdb_id}) catch "";
            upsertProviderId(series_owned, "imdb", "title", e.imdb_id, url);
            upsertRelation(series_owned, "same_as", e.imdb_id, 0, "filename");
        }
        if (e.season > 0) {
            var season_buf: [192]u8 = undefined;
            const season_id = std.fmt.bufPrint(&season_buf, "season.{s}.s{d}", .{ slug, e.season }) catch return;
            const season_owned = storeDup(&graph_store, &graph_store_len, season_id);
            upsertEntity(season_owned, "TVSeason");
            upsertRelation(season_owned, "part_of", series_owned, e.season, "filename");
            if (e.episode > 0) {
                var ep_buf: [192]u8 = undefined;
                const ep_id = std.fmt.bufPrint(&ep_buf, "episode.{s}.s{d}e{d}", .{ slug, e.season, e.episode }) catch return;
                const ep_owned = storeDup(&graph_store, &graph_store_len, ep_id);
                upsertEntity(ep_owned, "TVEpisode");
                upsertAssertion(ep_owned, "name", e.title, "filename");
                {
                    const ep_nfo = findNfoOverlay(work, e.season, e.episode, false);
                    if (ep_nfo.plot.len > 0) upsertAssertion(ep_owned, "description", ep_nfo.plot, "nfo");
                }
                upsertAssetLink(e.id, ep_owned, "main");
                upsertRelation(ep_owned, "has_asset", e.id, e.episode, "filename");
                upsertRelation(ep_owned, "part_of", season_owned, e.episode, "filename");
            }
        }
        return;
    }
    if (std.mem.eql(u8, e.kind, "audio")) {
        var rec_buf: [192]u8 = undefined;
        const rec_id = std.fmt.bufPrint(&rec_buf, "music.recording.{s}", .{e.id}) catch return;
        const rec_owned = storeDup(&graph_store, &graph_store_len, rec_id);
        upsertEntity(rec_owned, "MusicRecording");
        upsertAssertion(rec_owned, "name", e.title, "filename");
        upsertAssetLink(e.id, rec_owned, "main");
        upsertRelation(rec_owned, "has_asset", e.id, 0, "filename");
        if (e.work_title.len > 0) {
            var alb_buf: [192]u8 = undefined;
            const alb_id = std.fmt.bufPrint(&alb_buf, "music.album.{s}", .{slug}) catch return;
            const alb_owned = storeDup(&graph_store, &graph_store_len, alb_id);
            upsertEntity(alb_owned, "MusicAlbum");
            upsertAssertion(alb_owned, "name", e.work_title, "filename");
            upsertRelation(rec_owned, "part_of", alb_owned, 0, "filename");
        }
        return;
    }
    var movie_buf: [192]u8 = undefined;
    const movie_id = std.fmt.bufPrint(&movie_buf, "work.movie.{s}", .{slug}) catch return;
    const movie_owned = storeDup(&graph_store, &graph_store_len, movie_id);
    upsertEntity(movie_owned, "Movie");
    upsertAssertion(movie_owned, "name", if (e.work_title.len > 0) e.work_title else e.title, "filename");
    {
        const movie_nfo = findNfoOverlay(work, 0, 0, false);
        if (movie_nfo.plot.len > 0) upsertAssertion(movie_owned, "description", movie_nfo.plot, "nfo");
        if (movie_nfo.youtube.len > 0) upsertAssertion(movie_owned, "trailer_youtube", movie_nfo.youtube, "nfo");
    }
    upsertAssetLink(e.id, movie_owned, "main");
    upsertRelation(movie_owned, "has_asset", e.id, 0, "filename");
    if (e.imdb_id.len > 0) {
        var url_buf: [80]u8 = undefined;
        const url = std.fmt.bufPrint(&url_buf, "https://www.imdb.com/title/{s}/", .{e.imdb_id}) catch "";
        upsertProviderId(movie_owned, "imdb", "title", e.imdb_id, url);
        upsertRelation(movie_owned, "same_as", e.imdb_id, 0, "filename");
    }
}

fn encodeNextForWork(work: []const u8) void {
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT season, episode FROM entries WHERE work_key=? AND season>0 AND episode>0 AND kind!='extra' ORDER BY season ASC, episode ASC LIMIT 256", -1, &stmt, null) != SQLITE_OK) return;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, work);
    var prev_season: i64 = 0;
    var prev_episode: i64 = 0;
    var have_prev = false;
    var slug_buf: [128]u8 = undefined;
    const slug = slugFromWork(work, &slug_buf);
    if (slug.len == 0) return;
    while (sqlite3_step(stmt) == SQLITE_ROW) {
        const season = sqlite3_column_int64(stmt, 0);
        const episode = sqlite3_column_int64(stmt, 1);
        if (have_prev) {
            var a_buf: [192]u8 = undefined;
            var b_buf: [192]u8 = undefined;
            const a = std.fmt.bufPrint(&a_buf, "episode.{s}.s{d}e{d}", .{ slug, prev_season, prev_episode }) catch continue;
            const b = std.fmt.bufPrint(&b_buf, "episode.{s}.s{d}e{d}", .{ slug, season, episode }) catch continue;
            upsertRelation(a, "next", b, 0, "filename");
            upsertRelation(b, "previous", a, 0, "filename");
        }
        prev_season = season;
        prev_episode = episode;
        have_prev = true;
    }
}

pub fn encodeFilenameGraph() void {
    if (!catalog_ready) return;
    kind_store_len = 0;
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT id,kind,title,path,bytes,modified_ns,mime,container,poster,subtitle,year,video_codec,video_brand,audio_codec,season,episode,imdb_id,work_title,backdrop,logo FROM entries", -1, &stmt, null) != SQLITE_OK) return;
    defer _ = sqlite3_finalize(stmt);
    var tmp_store: [32 * 1024]u8 = undefined;
    var works: [128][]const u8 = undefined;
    var work_n: usize = 0;
    while (sqlite3_step(stmt) == SQLITE_ROW) {
        var tmp_len: usize = 0;
        const e = rowToEntry(stmt, &tmp_store, &tmp_len);
        encodeOneEntryGraph(e);
        const work = koru_media.koru_graph.workKey(e.path);
        var seen = false;
        for (works[0..work_n]) |w| {
            if (std.mem.eql(u8, w, work)) {
                seen = true;
                break;
            }
        }
        if (!seen and work_n < works.len and work.len > 0) {
            works[work_n] = storeDup(&kind_store, &kind_store_len, work);
            work_n += 1;
        }
    }
    var i: usize = 0;
    while (i < work_n) : (i += 1) {
        encodeNextForWork(works[i]);
    }
}

pub fn migrateHydrateWorksOnce() void {
    if (!catalog_ready) return;
    var chk: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT done FROM sem_migrate WHERE key='hydrate_works' LIMIT 1", -1, &chk, null) == SQLITE_OK) {
        defer _ = sqlite3_finalize(chk);
        if (sqlite3_step(chk) == SQLITE_ROW and sqlite3_column_int64(chk, 0) != 0) return;
    } else if (chk) |s| {
        _ = sqlite3_finalize(s);
    }
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT imdb_id, work_key, source, tmdb_id, tvdb_id, title, plot, year, poster_url FROM hydrate_works", -1, &stmt, null) != SQLITE_OK) {
        execSql("INSERT OR REPLACE INTO sem_migrate(key, done) VALUES('hydrate_works', 1)");
        return;
    }
    defer _ = sqlite3_finalize(stmt);
    while (sqlite3_step(stmt) == SQLITE_ROW) {
        const imdb = colText(stmt, 0);
        const work = colText(stmt, 1);
        const source = colText(stmt, 2);
        const tmdb_id = colText(stmt, 3);
        const tvdb_id = colText(stmt, 4);
        const title = colText(stmt, 5);
        const plot = colText(stmt, 6);
        const year_i = sqlite3_column_int64(stmt, 7);
        const poster = colText(stmt, 8);
        var slug_buf: [128]u8 = undefined;
        const slug = slugFromWork(work, &slug_buf);
        var id_buf: [192]u8 = undefined;
        const is_tv = std.mem.startsWith(u8, work, "shows/");
        const name = if (slug.len > 0) slug else imdb;
        const ent_id = if (is_tv)
            (std.fmt.bufPrint(&id_buf, "series.{s}", .{name}) catch continue)
        else
            (std.fmt.bufPrint(&id_buf, "work.movie.{s}", .{name}) catch continue);
        const typ: []const u8 = if (is_tv) "TVSeries" else "Movie";
        upsertEntity(ent_id, typ);
        if (title.len > 0) upsertAssertion(ent_id, "name", title, source);
        if (plot.len > 0) upsertAssertion(ent_id, "description", plot, source);
        if (year_i > 0) {
            var yb: [8]u8 = undefined;
            const ys = std.fmt.bufPrint(&yb, "{d}", .{year_i}) catch "";
            if (ys.len > 0) upsertAssertion(ent_id, "datePublished", ys, source);
        }
        if (poster.len > 0) upsertAssertion(ent_id, "poster_url", poster, source);
        if (imdb.len > 0) {
            var url_buf: [80]u8 = undefined;
            const url = std.fmt.bufPrint(&url_buf, "https://www.imdb.com/title/{s}/", .{imdb}) catch "";
            upsertProviderId(ent_id, "imdb", "title", imdb, url);
            upsertRelation(ent_id, "same_as", imdb, 0, source);
        }
        if (tmdb_id.len > 0) {
            var url_buf: [96]u8 = undefined;
            const path: []const u8 = if (is_tv) "tv" else "movie";
            const url = std.fmt.bufPrint(&url_buf, "https://www.themoviedb.org/{s}/{s}", .{ path, tmdb_id }) catch "";
            upsertProviderId(ent_id, "tmdb", path, tmdb_id, url);
            upsertRelation(ent_id, "same_as", tmdb_id, 0, source);
        }
        if (tvdb_id.len > 0) {
            upsertProviderId(ent_id, "tvdb", if (is_tv) "series" else "movie", tvdb_id, "");
        }
    }
    execSql("INSERT OR REPLACE INTO sem_migrate(key, done) VALUES('hydrate_works', 1)");
}

pub fn listDistinctImdb(out: []koru_media.koru_graph.Entry) []koru_media.koru_graph.Entry {
    work_store_len = 0;
    if (!catalog_ready) return out[0..0];
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT id,kind,title,path,bytes,modified_ns,mime,container,poster,subtitle,year,video_codec,video_brand,audio_codec,season,episode,imdb_id,work_title,backdrop,logo FROM entries WHERE imdb_id LIKE 'tt%' GROUP BY imdb_id LIMIT 256", -1, &stmt, null) != SQLITE_OK) return out[0..0];
    defer _ = sqlite3_finalize(stmt);
    var n: usize = 0;
    while (sqlite3_step(stmt) == SQLITE_ROW and n < out.len) {
        out[n] = rowToEntry(stmt, &work_store, &work_store_len);
        n += 1;
    }
    return out[0..n];
}

pub fn clear() void {
    if (!catalog_ready) return;
    execSql("DELETE FROM entries");
    execSql("DELETE FROM nfo_works");
    execSql("DELETE FROM nfo_episodes");
}

pub fn upsert(e: koru_media.koru_graph.Entry) void {
    if (!catalog_ready) return;
    const work = koru_media.koru_graph.workKey(e.path);
    var se = koru_media.koru_graph.SeasonEpisode{ .season = e.season, .episode = e.episode };
    if (se.season == 0 and se.episode == 0) {
        se = koru_media.koru_graph.parseSeasonEpisode(e.path);
    }
    var imdb_buf: [16]u8 = undefined;
    const imdb = if (e.imdb_id.len > 0) e.imdb_id else koru_media.koru_graph.parseImdbId(e.path, &imdb_buf);
    var wt_buf: [256]u8 = undefined;
    const wt = if (e.work_title.len > 0) e.work_title else koru_media.koru_graph.workDisplayTitle(work, &wt_buf);
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\INSERT OR REPLACE INTO entries(
        \\  id,kind,title,path,bytes,modified_ns,mime,container,poster,subtitle,year,
        \\  video_codec,video_brand,audio_codec,work_key,season,episode,imdb_id,work_title,backdrop,logo
        \\) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, e.id);
    bindText(stmt, 2, e.kind);
    bindText(stmt, 3, e.title);
    bindText(stmt, 4, e.path);
    _ = sqlite3_bind_int64(stmt, 5, @intCast(e.bytes));
    _ = sqlite3_bind_int64(stmt, 6, @intCast(e.modified_ns));
    bindText(stmt, 7, e.mime);
    bindText(stmt, 8, e.container);
    bindText(stmt, 9, e.poster);
    bindText(stmt, 10, e.subtitle);
    _ = sqlite3_bind_int64(stmt, 11, e.year);
    bindText(stmt, 12, e.video_codec);
    bindText(stmt, 13, e.video_brand);
    bindText(stmt, 14, e.audio_codec);
    bindText(stmt, 15, work);
    _ = sqlite3_bind_int64(stmt, 16, se.season);
    _ = sqlite3_bind_int64(stmt, 17, se.episode);
    bindText(stmt, 18, imdb);
    bindText(stmt, 19, wt);
    bindText(stmt, 20, e.backdrop);
    bindText(stmt, 21, e.logo);
    _ = sqlite3_step(stmt);
}

fn nfoHasText(plot: []const u8, aired: []const u8, rating: []const u8, youtube: []const u8) bool {
    return plot.len > 0 or aired.len > 0 or rating.len > 0 or youtube.len > 0;
}

pub fn upsertNfoWork(work_key: []const u8, plot: []const u8, aired: []const u8, rating: []const u8, youtube: []const u8) void {
    if (!catalog_ready) return;
    if (work_key.len == 0 or !nfoHasText(plot, aired, rating, youtube)) return;
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\INSERT INTO nfo_works(work_key, plot, aired, rating, trailer_youtube) VALUES(?,?,?,?,?)
        \\ON CONFLICT(work_key) DO UPDATE SET
        \\  plot=CASE WHEN excluded.plot!='' THEN excluded.plot ELSE nfo_works.plot END,
        \\  aired=CASE WHEN excluded.aired!='' THEN excluded.aired ELSE nfo_works.aired END,
        \\  rating=CASE WHEN excluded.rating!='' THEN excluded.rating ELSE nfo_works.rating END,
        \\  trailer_youtube=CASE WHEN excluded.trailer_youtube!='' THEN excluded.trailer_youtube ELSE nfo_works.trailer_youtube END
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, work_key);
    bindText(stmt, 2, plot);
    bindText(stmt, 3, aired);
    bindText(stmt, 4, rating);
    bindText(stmt, 5, youtube);
    _ = sqlite3_step(stmt);
}

pub fn upsertNfoEpisode(work_key: []const u8, season: u32, episode: u32, plot: []const u8, aired: []const u8, rating: []const u8) void {
    if (!catalog_ready) return;
    if (work_key.len == 0 or !nfoHasText(plot, aired, rating, "")) return;
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\INSERT INTO nfo_episodes(work_key, season, episode, plot, aired, rating) VALUES(?,?,?,?,?,?)
        \\ON CONFLICT(work_key, season, episode) DO UPDATE SET
        \\  plot=CASE WHEN excluded.plot!='' THEN excluded.plot ELSE nfo_episodes.plot END,
        \\  aired=CASE WHEN excluded.aired!='' THEN excluded.aired ELSE nfo_episodes.aired END,
        \\  rating=CASE WHEN excluded.rating!='' THEN excluded.rating ELSE nfo_episodes.rating END
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, work_key);
    _ = sqlite3_bind_int64(stmt, 2, season);
    _ = sqlite3_bind_int64(stmt, 3, episode);
    bindText(stmt, 4, plot);
    bindText(stmt, 5, aired);
    bindText(stmt, 6, rating);
    _ = sqlite3_step(stmt);
}

/// Join overlay: series item uses work row; episode coalesces episode then work.
pub fn findNfoOverlay(work_key: []const u8, season: u32, episode: u32, series_work: bool) koru_media.koru_graph.NfoMeta {
    nfo_overlay_len = 0;
    if (!catalog_ready or work_key.len == 0) return .{};
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\SELECT
        \\  CASE WHEN ?!=0 THEN COALESCE(w.plot,'') ELSE COALESCE(NULLIF(e.plot,''), w.plot, '') END,
        \\  CASE WHEN ?!=0 THEN COALESCE(w.aired,'') ELSE COALESCE(NULLIF(e.aired,''), w.aired, '') END,
        \\  CASE WHEN ?!=0 THEN COALESCE(w.rating,'') ELSE COALESCE(NULLIF(e.rating,''), w.rating, '') END,
        \\  COALESCE(w.trailer_youtube,'')
        \\FROM (SELECT ? AS wk) k
        \\LEFT JOIN nfo_works w ON w.work_key = k.wk
        \\LEFT JOIN nfo_episodes e ON e.work_key = k.wk AND e.season = ? AND e.episode = ?
        \\LIMIT 1
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return .{};
    defer _ = sqlite3_finalize(stmt);
    const flag: i64 = if (series_work) 1 else 0;
    _ = sqlite3_bind_int64(stmt, 1, flag);
    _ = sqlite3_bind_int64(stmt, 2, flag);
    _ = sqlite3_bind_int64(stmt, 3, flag);
    bindText(stmt, 4, work_key);
    _ = sqlite3_bind_int64(stmt, 5, season);
    _ = sqlite3_bind_int64(stmt, 6, episode);
    if (sqlite3_step(stmt) != SQLITE_ROW) return .{};
    return .{
        .plot = storeDup(&nfo_overlay_store, &nfo_overlay_len, colText(stmt, 0)),
        .aired = storeDup(&nfo_overlay_store, &nfo_overlay_len, colText(stmt, 1)),
        .rating = storeDup(&nfo_overlay_store, &nfo_overlay_len, colText(stmt, 2)),
        .youtube = storeDup(&nfo_overlay_store, &nfo_overlay_len, colText(stmt, 3)),
    };
}

/// Offline TMDB/TVDB overlay. Keyed by `[tt…]`. Reindex does not wipe this table.
/// Prefer `findHydrateForAsset` so nfo/graph assertions are included.
pub fn findHydrateOverlay(imdb_id: []const u8) koru_media.koru_graph.HydrateMeta {
    hydrate_overlay_len = 0;
    if (!catalog_ready or imdb_id.len < 3) return .{};
    if (!(imdb_id[0] == 't' and imdb_id[1] == 't')) return .{};
    var stmt: ?*sqlite3_stmt = null;
    const sql =
        \\SELECT poster_url, actors, plot, title, year, tmdb_id, tvdb_id, source
        \\FROM hydrate_works WHERE imdb_id=? LIMIT 1
    ;
    if (sqlite3_prepare_v2(db, sql, -1, &stmt, null) != SQLITE_OK) return .{};
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, imdb_id);
    if (sqlite3_step(stmt) != SQLITE_ROW) return .{};
    const year_i = sqlite3_column_int64(stmt, 4);
    const year: u32 = if (year_i < 0 or year_i > 9999) 0 else @intCast(year_i);
    return .{
        .poster_url = storeDup(&hydrate_overlay_store, &hydrate_overlay_len, colText(stmt, 0)),
        .actors = storeDup(&hydrate_overlay_store, &hydrate_overlay_len, colText(stmt, 1)),
        .plot = storeDup(&hydrate_overlay_store, &hydrate_overlay_len, colText(stmt, 2)),
        .title = storeDup(&hydrate_overlay_store, &hydrate_overlay_len, colText(stmt, 3)),
        .year = year,
        .tmdb_id = storeDup(&hydrate_overlay_store, &hydrate_overlay_len, colText(stmt, 5)),
        .tvdb_id = storeDup(&hydrate_overlay_store, &hydrate_overlay_len, colText(stmt, 6)),
        .source = storeDup(&hydrate_overlay_store, &hydrate_overlay_len, colText(stmt, 7)),
    };
}

fn overlayDup(s: []const u8) []const u8 {
    return storeDup(&hydrate_overlay_store, &hydrate_overlay_len, s);
}

/// `sem_assertions` (nfo / TMDB graph) plus legacy `hydrate_works` by `[tt…]`.
pub fn findHydrateForAsset(asset_id: []const u8, imdb_id: []const u8) koru_media.koru_graph.HydrateMeta {
    var meta = findHydrateOverlay(imdb_id);
    if (asset_id.len == 0) return meta;
    const ent_raw = entityForAsset(asset_id);
    if (ent_raw.len == 0) return meta;
    var ent_buf: [192]u8 = undefined;
    if (ent_raw.len > ent_buf.len) return meta;
    @memcpy(ent_buf[0..ent_raw.len], ent_raw);
    const ent = ent_buf[0..ent_raw.len];
    const desc = assertionValue(ent, "description");
    if (meta.plot.len == 0 and desc.len > 0) meta.plot = overlayDup(desc);
    const poster = assertionValue(ent, "poster_url");
    if (meta.poster_url.len == 0 and poster.len > 0) meta.poster_url = overlayDup(poster);
    const backdrop = assertionValue(ent, "backdrop_url");
    if (meta.backdrop_url.len == 0 and backdrop.len > 0) meta.backdrop_url = overlayDup(backdrop);
    const logo = assertionValue(ent, "logo_url");
    if (meta.logo_url.len == 0 and logo.len > 0) meta.logo_url = overlayDup(logo);
    const yt = assertionValue(ent, "trailer_youtube");
    if (yt.len > 0 and meta.source.len == 0) meta.source = overlayDup("graph");
    const name = assertionValue(ent, "name");
    if (meta.title.len == 0 and name.len > 0) meta.title = overlayDup(name);
    const actors = assertionValue(ent, "actors");
    if (meta.actors.len == 0 and actors.len > 0) meta.actors = overlayDup(actors);
    const genres = assertionValue(ent, "genres");
    if (meta.genres.len == 0 and genres.len > 0) meta.genres = overlayDup(genres);
    const director = assertionValue(ent, "director");
    if (meta.director.len == 0 and director.len > 0) meta.director = overlayDup(director);
    const writers = assertionValue(ent, "writers");
    if (meta.writers.len == 0 and writers.len > 0) meta.writers = overlayDup(writers);
    const tagline = assertionValue(ent, "tagline");
    if (meta.tagline.len == 0 and tagline.len > 0) meta.tagline = overlayDup(tagline);
    const rating = assertionValue(ent, "contentRating");
    if (meta.rating.len == 0 and rating.len > 0) meta.rating = overlayDup(rating);
    const runtime_s = assertionValue(ent, "duration");
    if (meta.runtime == 0 and runtime_s.len > 0) {
        meta.runtime = std.fmt.parseInt(u32, runtime_s, 10) catch 0;
    }
    return meta;
}

pub fn findEntry(id: []const u8) ?koru_media.koru_graph.Entry {
    if (!catalog_ready) return null;
    find_store_len = 0;
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT id,kind,title,path,bytes,modified_ns,mime,container,poster,subtitle,year,video_codec,video_brand,audio_codec,season,episode,imdb_id,work_title,backdrop,logo FROM entries WHERE id=? LIMIT 1", -1, &stmt, null) != SQLITE_OK) return null;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, id);
    if (sqlite3_step(stmt) != SQLITE_ROW) return null;
    return rowToEntry(stmt, &find_store, &find_store_len);
}

pub fn hasKind(kind: []const u8) bool {
    if (!catalog_ready) return false;
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT 1 FROM entries WHERE kind=? LIMIT 1", -1, &stmt, null) != SQLITE_OK) return false;
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, kind);
    return sqlite3_step(stmt) == SQLITE_ROW;
}

fn orderSql(sort: koru_media.koru_graph.SortMode) []const u8 {
    return switch (sort) {
        .title => "COALESCE(NULLIF(work_title,''), title) COLLATE NOCASE ASC, id ASC",
        .id => "id ASC",
        .recent => "modified_ns DESC, COALESCE(NULLIF(work_title,''), title) COLLATE NOCASE ASC",
        .shuffle => "RANDOM()",
    };
}

fn filterSql(filter: []const u8) []const u8 {
    if (std.mem.eql(u8, filter, "uhd")) return " AND (path LIKE '%2160p%' OR path LIKE '%UHD%' OR path LIKE '%4K%' OR path LIKE '%2160i%')";
    if (std.mem.eql(u8, filter, "atmos")) return " AND path LIKE '%Atmos%'";
    if (std.mem.eql(u8, filter, "3d")) return " AND (path LIKE '%3D%' OR path LIKE '%HSBS%' OR path LIKE '%HOU%')";
    return "";
}

fn whereSql(kind_filter: ?[]const u8, q: ?[]const u8) []const u8 {
    const has_q = if (q) |needle| needle.len > 0 else false;
    const skip_stale_extra = blk: {
        if (kind_filter) |k| {
            if (std.mem.eql(u8, k, "audio") or std.mem.eql(u8, k, "extra")) break :blk false;
        }
        break :blk true;
    };
    if (kind_filter) |_| {
        if (has_q) {
            return if (skip_stale_extra)
                "WHERE kind=? AND (kind='audio' OR mime NOT LIKE 'audio/%') AND path NOT LIKE '%/extras/%' AND path NOT LIKE '%/featurettes/%' AND path NOT LIKE '%/trailers/%' AND path NOT LIKE '%/soundtrack/%' AND (title LIKE '%' || ? || '%' COLLATE NOCASE OR work_title LIKE '%' || ? || '%' COLLATE NOCASE)"
            else
                "WHERE kind=? AND (title LIKE '%' || ? || '%' COLLATE NOCASE OR work_title LIKE '%' || ? || '%' COLLATE NOCASE)";
        }
        return if (skip_stale_extra)
            "WHERE kind=? AND (kind='audio' OR mime NOT LIKE 'audio/%') AND path NOT LIKE '%/extras/%' AND path NOT LIKE '%/featurettes/%' AND path NOT LIKE '%/trailers/%' AND path NOT LIKE '%/soundtrack/%'"
        else
            "WHERE kind=?";
    }
    if (has_q) {
        return if (skip_stale_extra)
            "WHERE kind!='extra' AND (kind='audio' OR mime NOT LIKE 'audio/%') AND path NOT LIKE '%/extras/%' AND path NOT LIKE '%/featurettes/%' AND path NOT LIKE '%/trailers/%' AND path NOT LIKE '%/soundtrack/%' AND (title LIKE '%' || ? || '%' COLLATE NOCASE OR work_title LIKE '%' || ? || '%' COLLATE NOCASE)"
        else
            "WHERE kind!='extra' AND (title LIKE '%' || ? || '%' COLLATE NOCASE OR work_title LIKE '%' || ? || '%' COLLATE NOCASE)";
    }
    return if (skip_stale_extra)
        "WHERE kind!='extra' AND (kind='audio' OR mime NOT LIKE 'audio/%') AND path NOT LIKE '%/extras/%' AND path NOT LIKE '%/featurettes/%' AND path NOT LIKE '%/trailers/%' AND path NOT LIKE '%/soundtrack/%'"
    else
        "WHERE kind!='extra'";
}

fn bindWhere(stmt: ?*sqlite3_stmt, kind_filter: ?[]const u8, q: ?[]const u8) void {
    var bi: c_int = 1;
    if (kind_filter) |k| {
        bindText(stmt, bi, k);
        bi += 1;
    }
    if (q) |needle| {
        if (needle.len > 0) {
            bindText(stmt, bi, needle);
            bi += 1;
            bindText(stmt, bi, needle);
        }
    }
}

/// One row per work_key (Discover / Movies / Series / Music). Extras are
/// omitted unless the kind filter is `extra`. Empty work_key stays per-file.
pub fn collectPage(kind_filter: ?[]const u8, q: ?[]const u8, sort: koru_media.koru_graph.SortMode, offset: usize, limit: usize, filter: []const u8, out: *[MAX_PAGE]koru_media.koru_graph.Entry) koru_media.koru_graph.Page {
    page_store_len = 0;
    if (!catalog_ready) return .{ .items = out[0..0], .total = 0 };
    const cap = if (limit == 0) out.len else @min(out.len, limit);
    const where_base = whereSql(kind_filter, q);
    var where_buf: [1400]u8 = undefined;
    const where = std.fmt.bufPrint(&where_buf, "{s}{s}", .{ where_base, filterSql(filter) }) catch where_base;
    const work_group = "CASE WHEN work_key='' THEN id ELSE work_key END";

    var count_sql: [1600]u8 = undefined;
    var list_sql: [2800]u8 = undefined;
    const count_z = std.fmt.bufPrint(&count_sql, "SELECT COUNT(DISTINCT {s}) FROM entries {s}", .{ work_group, where }) catch return .{ .items = out[0..0], .total = 0 };
    const list_z = std.fmt.bufPrint(&list_sql, "SELECT {s} FROM entries WHERE id IN (SELECT MIN(id) FROM entries {s} GROUP BY {s}) ORDER BY {s} LIMIT {d} OFFSET {d}", .{ ENTRY_COLS, where, work_group, orderSql(sort), cap, offset }) catch return .{ .items = out[0..0], .total = 0 };

    var cstmt: ?*sqlite3_stmt = null;
    var cz: [1601]u8 = undefined;
    const czp = zsql(&cz, count_z) orelse return .{ .items = out[0..0], .total = 0 };
    if (sqlite3_prepare_v2(db, czp, -1, &cstmt, null) != SQLITE_OK) return .{ .items = out[0..0], .total = 0 };
    defer _ = sqlite3_finalize(cstmt);
    bindWhere(cstmt, kind_filter, q);
    var total: usize = 0;
    if (sqlite3_step(cstmt) == SQLITE_ROW) {
        const n = sqlite3_column_int64(cstmt, 0);
        if (n > 0) total = @intCast(n);
    }

    var lst: ?*sqlite3_stmt = null;
    var lz: [2801]u8 = undefined;
    const lzp = zsql(&lz, list_z) orelse return .{ .items = out[0..0], .total = total };
    if (sqlite3_prepare_v2(db, lzp, -1, &lst, null) != SQLITE_OK) return .{ .items = out[0..0], .total = total };
    defer _ = sqlite3_finalize(lst);
    bindWhere(lst, kind_filter, q);
    var w: usize = 0;
    while (sqlite3_step(lst) == SQLITE_ROW and w < out.len) {
        out[w] = rowToEntry(lst, &page_store, &page_store_len);
        w += 1;
    }
    return .{ .items = out[0..w], .total = total };
}

pub fn collectWorkmates(path: []const u8, except_id: []const u8, out: *[MAX_PAGE]koru_media.koru_graph.Entry) []koru_media.koru_graph.Entry {
    work_store_len = 0;
    if (!catalog_ready) return out[0..0];
    const work = koru_media.koru_graph.workKey(path);
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT id,kind,title,path,bytes,modified_ns,mime,container,poster,subtitle,year,video_codec,video_brand,audio_codec,season,episode,imdb_id,work_title,backdrop,logo FROM entries WHERE work_key=? AND id!=? LIMIT 256", -1, &stmt, null) != SQLITE_OK) return out[0..0];
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, work);
    bindText(stmt, 2, except_id);
    var n: usize = 0;
    while (sqlite3_step(stmt) == SQLITE_ROW and n < out.len) {
        out[n] = rowToEntry(stmt, &work_store, &work_store_len);
        n += 1;
    }
    return out[0..n];
}

/// Every file that shares this path's work_key, including extras (item seasons).
pub fn collectWorkFiles(path: []const u8, out: *[MAX_PAGE]koru_media.koru_graph.Entry) []koru_media.koru_graph.Entry {
    work_store_len = 0;
    if (!catalog_ready) return out[0..0];
    const work = koru_media.koru_graph.workKey(path);
    var stmt: ?*sqlite3_stmt = null;
    if (sqlite3_prepare_v2(db, "SELECT id,kind,title,path,bytes,modified_ns,mime,container,poster,subtitle,year,video_codec,video_brand,audio_codec,season,episode,imdb_id,work_title,backdrop,logo FROM entries WHERE work_key=? ORDER BY season ASC, episode ASC, title COLLATE NOCASE ASC, id ASC LIMIT 256", -1, &stmt, null) != SQLITE_OK) return out[0..0];
    defer _ = sqlite3_finalize(stmt);
    bindText(stmt, 1, work);
    var n: usize = 0;
    while (sqlite3_step(stmt) == SQLITE_ROW and n < out.len) {
        out[n] = rowToEntry(stmt, &work_store, &work_store_len);
        n += 1;
    }
    return out[0..n];
}

const VIDEO_EXT = [_][]const u8{ ".mp4", ".m4v", ".webm", ".mkv", ".mov" };
const AUDIO_EXT = [_][]const u8{ ".mp3", ".m4a", ".aac", ".flac", ".ogg", ".wav" };
const BOOK_EXT = [_][]const u8{ ".epub", ".pdf", ".cbz", ".cbr", ".mobi", ".azw3" };
const POSTER_EXT = [_][]const u8{ ".webp", ".jpg", ".jpeg", ".png" };

fn extOf(name: []const u8) []const u8 {
    if (std.mem.lastIndexOfScalar(u8, name, '.')) |d| return name[d..];
    return "";
}

fn isMediaName(name: []const u8) bool {
    if (std.mem.endsWith(u8, name, ".id")) return false;
    const ext = extOf(name);
    for (VIDEO_EXT) |e| if (std.ascii.eqlIgnoreCase(ext, e)) return true;
    for (AUDIO_EXT) |e| if (std.ascii.eqlIgnoreCase(ext, e)) return true;
    for (BOOK_EXT) |e| if (std.ascii.eqlIgnoreCase(ext, e)) return true;
    return false;
}

fn kindFor(rel: []const u8) []const u8 {
    if (pathHasExtraMarker(rel)) return "extra";
    return koru_media.koru_graph.fileKind(rel);
}

fn pathHasExtraMarker(rel: []const u8) bool {
    const marks = [_][]const u8{
        "/extras/",     "/extra/",      "/featurettes/", "/featurette/",
        "/soundtrack/", "/trailers/",   "/trailer/",     "/ost/",
        "/score/",
    };
    for (marks) |m| {
        if (std.mem.indexOf(u8, rel, m) != null) return true;
    }
    return false;
}

fn mimeFor(rel: []const u8) []const u8 {
    const ext = extOf(rel);
    if (std.ascii.eqlIgnoreCase(ext, ".mp4") or std.ascii.eqlIgnoreCase(ext, ".m4v")) return "video/mp4";
    if (std.ascii.eqlIgnoreCase(ext, ".webm")) return "video/webm";
    if (std.ascii.eqlIgnoreCase(ext, ".mkv")) return "video/x-matroska";
    if (std.ascii.eqlIgnoreCase(ext, ".mov")) return "video/quicktime";
    if (std.ascii.eqlIgnoreCase(ext, ".mp3")) return "audio/mpeg";
    if (std.ascii.eqlIgnoreCase(ext, ".m4a") or std.ascii.eqlIgnoreCase(ext, ".aac")) return "audio/mp4";
    if (std.ascii.eqlIgnoreCase(ext, ".flac")) return "audio/flac";
    if (std.ascii.eqlIgnoreCase(ext, ".ogg")) return "audio/ogg";
    if (std.ascii.eqlIgnoreCase(ext, ".wav")) return "audio/wav";
    if (std.ascii.eqlIgnoreCase(ext, ".pdf")) return "application/pdf";
    if (std.ascii.eqlIgnoreCase(ext, ".epub")) return "application/epub+zip";
    return "application/octet-stream";
}

fn containerFor(rel: []const u8) []const u8 {
    const ext = extOf(rel);
    if (ext.len < 2) return "bin";
    return ext[1..];
}

fn yearFromName(stem: []const u8) u32 {
    var i: usize = 0;
    while (i + 5 < stem.len) : (i += 1) {
        if (stem[i] != '(') continue;
        if (i + 5 >= stem.len or stem[i + 5] != ')') continue;
        const y = stem[i + 1 .. i + 5];
        const ok = (y[0] == '1' or y[0] == '2') and
            y[1] >= '0' and y[1] <= '9' and
            y[2] >= '0' and y[2] <= '9' and
            y[3] >= '0' and y[3] <= '9';
        if (!ok) continue;
        const n = std.fmt.parseInt(u32, y, 10) catch continue;
        if (n >= 1900 and n <= 2099) return n;
    }
    return 0;
}

fn stemOf(path: []const u8) []const u8 {
    var slash: usize = 0;
    var i: usize = 0;
    while (i < path.len) : (i += 1) {
        if (path[i] == '/') slash = i + 1;
    }
    const name = path[slash..];
    if (std.mem.lastIndexOfScalar(u8, name, '.')) |d| return name[0..d];
    return name;
}

fn parentName(path: []const u8) []const u8 {
    const slash = std.mem.lastIndexOfScalar(u8, path, '/') orelse return "";
    const dir = path[0..slash];
    const prev = std.mem.lastIndexOfScalar(u8, dir, '/') orelse return dir;
    return dir[prev + 1 ..];
}

fn opaqueId(rel: []const u8, size: u64, mtime_ns: u64) [8]u8 {
    var msg: [768]u8 = undefined;
    const line = std.fmt.bufPrint(&msg, "{s}|{d}|{d}", .{ rel, size, mtime_ns }) catch "x";
    var digest: [20]u8 = undefined;
    std.crypto.hash.Sha1.hash(line, &digest, .{});
    const hex = "0123456789abcdef";
    var out: [8]u8 = undefined;
    out[0] = 'm';
    out[1] = '_';
    var i: usize = 0;
    while (i < 3) : (i += 1) {
        out[2 + i * 2] = hex[digest[i] >> 4];
        out[3 + i * 2] = hex[digest[i] & 0xf];
    }
    return out;
}

fn parentDir(path: []const u8) []const u8 {
    const slash = std.mem.lastIndexOfScalar(u8, path, '/') orelse return "";
    return path[0..slash];
}

fn dirIsUnderWork(dir_rel: []const u8, work: []const u8) bool {
    if (work.len == 0) return false;
    if (!std.mem.startsWith(u8, dir_rel, work)) return false;
    return dir_rel.len > work.len and dir_rel[work.len] == '/';
}

fn findNamedSidecar(root: []const u8, rel: []const u8, store: *[512]u8, names: []const []const u8, try_stem: bool) []const u8 {
    const slash = std.mem.lastIndexOfScalar(u8, rel, '/') orelse rel.len;
    const stem_rel = blk: {
        if (std.mem.lastIndexOfScalar(u8, rel, '.')) |d| break :blk rel[0..d];
        break :blk rel;
    };
    if (try_stem) {
        for (POSTER_EXT) |ext| {
            var cand: [768]u8 = undefined;
            const p = std.fmt.bufPrint(&cand, "{s}/{s}{s}", .{ root, stem_rel, ext }) catch continue;
            if (std.fs.cwd().access(p, .{})) |_| {
                const relp = std.fmt.bufPrint(store, "{s}{s}", .{ stem_rel, ext }) catch continue;
                return relp;
            } else |_| {}
        }
    }
    const work = koru_media.koru_graph.workKey(rel);
    var dir_rel: []const u8 = if (slash < rel.len) rel[0..slash] else "";
    while (true) {
        for (names) |n| {
            for (POSTER_EXT) |ext| {
                var cand: [768]u8 = undefined;
                const p = if (dir_rel.len == 0)
                    std.fmt.bufPrint(&cand, "{s}/{s}{s}", .{ root, n, ext }) catch continue
                else
                    std.fmt.bufPrint(&cand, "{s}/{s}/{s}{s}", .{ root, dir_rel, n, ext }) catch continue;
                if (std.fs.cwd().access(p, .{})) |_| {
                    if (dir_rel.len == 0) {
                        return std.fmt.bufPrint(store, "{s}{s}", .{ n, ext }) catch continue;
                    }
                    return std.fmt.bufPrint(store, "{s}/{s}{s}", .{ dir_rel, n, ext }) catch continue;
                } else |_| {}
            }
        }
        if (dir_rel.len == 0) break;
        if (std.mem.eql(u8, dir_rel, work)) break;
        if (!dirIsUnderWork(dir_rel, work)) break;
        dir_rel = parentDir(dir_rel);
    }
    return "";
}

fn findSidecar(root: []const u8, rel: []const u8, store: *[512]u8) []const u8 {
    const names = [_][]const u8{ "poster", "folder", "cover", "show" };
    return findNamedSidecar(root, rel, store, &names, true);
}

fn findBackdropSidecar(root: []const u8, rel: []const u8, store: *[512]u8) []const u8 {
    const names = [_][]const u8{ "fanart", "landscape", "banner", "thumb", "backdrop" };
    return findNamedSidecar(root, rel, store, &names, false);
}

fn findLogoSidecar(root: []const u8, rel: []const u8, store: *[512]u8) []const u8 {
    const names = [_][]const u8{ "logo", "clearlogo" };
    return findNamedSidecar(root, rel, store, &names, false);
}

fn xmlUnescapeInto(src: []const u8, store: []u8) []const u8 {
    var i: usize = 0;
    var end = src.len;
    while (i < end and (src[i] == ' ' or src[i] == '\t' or src[i] == '\n' or src[i] == '\r')) : (i += 1) {}
    while (end > i and (src[end - 1] == ' ' or src[end - 1] == '\t' or src[end - 1] == '\n' or src[end - 1] == '\r')) : (end -= 1) {}
    var w: usize = 0;
    while (i < end and w < store.len) {
        if (src[i] == '&') {
            const rest = src[i..end];
            if (std.mem.startsWith(u8, rest, "&amp;")) {
                store[w] = '&';
                i += 5;
            } else if (std.mem.startsWith(u8, rest, "&lt;")) {
                store[w] = '<';
                i += 4;
            } else if (std.mem.startsWith(u8, rest, "&gt;")) {
                store[w] = '>';
                i += 4;
            } else if (std.mem.startsWith(u8, rest, "&quot;")) {
                store[w] = '"';
                i += 6;
            } else if (std.mem.startsWith(u8, rest, "&apos;")) {
                store[w] = '\'';
                i += 6;
            } else {
                store[w] = src[i];
                i += 1;
            }
            w += 1;
            continue;
        }
        store[w] = src[i];
        w += 1;
        i += 1;
    }
    return store[0..w];
}

fn xmlTagDelimOk(nxt: u8) bool {
    return nxt == '>' or nxt == ' ' or nxt == '\t' or nxt == '/' or nxt == '\n' or nxt == '\r';
}

fn extractXmlTag(text: []const u8, tag: []const u8, store: []u8) []const u8 {
    var i: usize = 0;
    while (i < text.len) : (i += 1) {
        if (text[i] != '<') continue;
        const rest = text[i + 1 ..];
        if (rest.len < tag.len) continue;
        if (!std.ascii.eqlIgnoreCase(rest[0..tag.len], tag)) continue;
        if (rest.len > tag.len and !xmlTagDelimOk(rest[tag.len])) continue;
        var j: usize = tag.len;
        while (j < rest.len and rest[j] != '>') : (j += 1) {}
        if (j >= rest.len) return "";
        var start = i + 1 + j + 1;
        while (start < text.len and (text[start] == ' ' or text[start] == '\t' or text[start] == '\n' or text[start] == '\r')) : (start += 1) {}
        if (start + 9 <= text.len and std.mem.eql(u8, text[start .. start + 9], "<![CDATA[")) {
            start += 9;
            const cend = std.mem.indexOf(u8, text[start..], "]]>") orelse return "";
            return xmlUnescapeInto(text[start .. start + cend], store);
        }
        var close_buf: [40]u8 = undefined;
        if (tag.len + 3 > close_buf.len) return "";
        close_buf[0] = '<';
        close_buf[1] = '/';
        @memcpy(close_buf[2 .. 2 + tag.len], tag);
        close_buf[2 + tag.len] = '>';
        const close = close_buf[0 .. 3 + tag.len];
        var k = start;
        while (k + close.len <= text.len) : (k += 1) {
            if (text[k] != '<') continue;
            if (std.ascii.eqlIgnoreCase(text[k .. k + close.len], close)) {
                return xmlUnescapeInto(text[start..k], store);
            }
        }
        return "";
    }
    return "";
}

const NfoParse = struct {
    title: []const u8 = "",
    plot: []const u8 = "",
    aired: []const u8 = "",
    rating: []const u8 = "",
    youtube: []const u8 = "",
    imdb: []const u8 = "",
    episode_scope: bool = false,
    work_scope: bool = false,
};

fn copyYoutubeId(src: []const u8, store: []u8) []const u8 {
    var n: usize = 0;
    for (src) |ch| {
        const ok = (ch >= 'A' and ch <= 'Z') or (ch >= 'a' and ch <= 'z') or (ch >= '0' and ch <= '9') or ch == '-' or ch == '_';
        if (!ok or n >= store.len or n >= 11) break;
        store[n] = ch;
        n += 1;
    }
    if (n < 11) return "";
    return store[0..11];
}

fn youtubeKeyFromTrailer(url: []const u8, store: []u8) []const u8 {
    if (std.ascii.indexOfIgnoreCase(url, "imdb.com") != null) return "";
    const markers = [_][]const u8{ "video_id=", "videoid=", "watch?v=", "embed/", "youtu.be/" };
    for (markers) |m| {
        if (std.ascii.indexOfIgnoreCase(url, m)) |at| {
            const start = at + m.len;
            if (start >= url.len) continue;
            const key = copyYoutubeId(url[start..], store);
            if (key.len == 11) return key;
        }
    }
    return "";
}

fn copyTtId(digits: []const u8, store: *[16]u8) []const u8 {
    if (digits.len == 0 or digits.len + 2 > store.len) return "";
    store[0] = 't';
    store[1] = 't';
    @memcpy(store[2 .. 2 + digits.len], digits);
    return store[0 .. 2 + digits.len];
}

fn imdbFromNfoText(text: []const u8, store: *[16]u8) []const u8 {
    var i: usize = 0;
    while (i < text.len) {
        const rest = text[i..];
        const at = std.ascii.indexOfIgnoreCase(rest, "<uniqueid") orelse break;
        const abs = i + at;
        const gt = std.mem.indexOfPos(u8, text, abs, ">") orelse break;
        const attrs = text[abs..gt];
        const close_rel = std.ascii.indexOfIgnoreCase(text[gt + 1 ..], "</uniqueid>") orelse break;
        const inner = std.mem.trim(u8, text[gt + 1 .. gt + 1 + close_rel], " \t\r\n");
        i = gt + 1 + close_rel + 11;
        const typed = std.ascii.indexOfIgnoreCase(attrs, "imdb") != null;
        if (inner.len < 3 or !std.ascii.eqlIgnoreCase(inner[0..2], "tt")) continue;
        if (!typed and std.ascii.indexOfIgnoreCase(attrs, "type=") != null) continue;
        var k: usize = 2;
        while (k < inner.len and inner[k] >= '0' and inner[k] <= '9') : (k += 1) {}
        if (k < 3) continue;
        const id = copyTtId(inner[2..k], store);
        if (id.len > 0) return id;
    }
    return "";
}

fn firstYoutubeFromNfo(text: []const u8, store: []u8) []const u8 {
    var i: usize = 0;
    while (i < text.len) {
        const rest = text[i..];
        const at = std.ascii.indexOfIgnoreCase(rest, "<trailer") orelse break;
        const abs = i + at;
        const gt = std.mem.indexOfPos(u8, text, abs, ">") orelse break;
        const close_at = std.ascii.indexOfIgnoreCase(text[gt + 1 ..], "</trailer>") orelse break;
        const inner = std.mem.trim(u8, text[gt + 1 .. gt + 1 + close_at], " \t\r\n");
        const key = youtubeKeyFromTrailer(inner, store);
        if (key.len == 11) return key;
        i = gt + 1 + close_at + 10;
    }
    return "";
}

fn nfoRatingOf(text: []const u8, store: []u8) []const u8 {
    const from_value = extractXmlTag(text, "value", store);
    if (from_value.len > 0 and std.mem.indexOfScalar(u8, from_value, '<') == null) return from_value;
    const from_rating = extractXmlTag(text, "rating", store);
    if (from_rating.len > 0 and std.mem.indexOfScalar(u8, from_rating, '<') == null) return from_rating;
    return "";
}

fn parseNfoBytes(text: []const u8) NfoParse {
    const plot = extractXmlTag(text, "plot", &nfo_plot_buf);
    const plot_or = if (plot.len > 0) plot else extractXmlTag(text, "outline", &nfo_plot_buf);
    const aired = extractXmlTag(text, "aired", &nfo_aired_buf);
    const aired_or = if (aired.len > 0) aired else extractXmlTag(text, "premiered", &nfo_aired_buf);
    return .{
        .title = extractXmlTag(text, "title", &nfo_title_parse_buf),
        .plot = plot_or,
        .aired = aired_or,
        .rating = nfoRatingOf(text, &nfo_rating_buf),
        .youtube = firstYoutubeFromNfo(text, &nfo_youtube_buf),
        .imdb = imdbFromNfoText(text, &nfo_imdb_buf),
        .episode_scope = std.ascii.indexOfIgnoreCase(text, "episodedetails") != null,
        .work_scope = std.ascii.indexOfIgnoreCase(text, "<tvshow") != null or std.ascii.indexOfIgnoreCase(text, "<movie") != null,
    };
}

fn loadNfoFull(full: []const u8) ?NfoParse {
    const st = std.fs.cwd().statFile(full) catch return null;
    if (st.size <= 0 or st.size > NFO_MAX) return null;
    const file = std.fs.cwd().openFile(full, .{}) catch return null;
    defer file.close();
    const n = file.readAll(nfo_read_buf[0..]) catch return null;
    if (n == 0) return null;
    return parseNfoBytes(nfo_read_buf[0..n]);
}

fn applyNfoOverlay(work: []const u8, season: u32, episode: u32, parsed: NfoParse, force_work: bool) void {
    if (!nfoHasText(parsed.plot, parsed.aired, parsed.rating, parsed.youtube)) return;
    const as_work = force_work or parsed.work_scope or (!parsed.episode_scope and season == 0 and episode == 0);
    if (as_work) {
        upsertNfoWork(work, parsed.plot, parsed.aired, parsed.rating, parsed.youtube);
        return;
    }
    upsertNfoEpisode(work, season, episode, parsed.plot, parsed.aired, parsed.rating);
}

fn ingestWorkNfo(root: []const u8, work: []const u8, name: []const u8) void {
    if (work.len == 0) return;
    var path_buf: [1024]u8 = undefined;
    const full = std.fmt.bufPrint(&path_buf, "{s}/{s}/{s}", .{ root, work, name }) catch return;
    const parsed = loadNfoFull(full) orelse return;
    applyNfoOverlay(work, 0, 0, parsed, true);
}

fn findJpegIn(buf: []const u8) ?[]const u8 {
    var i: usize = 0;
    while (i + 3 < buf.len) : (i += 1) {
        if (buf[i] != 0xFF or buf[i + 1] != 0xD8 or buf[i + 2] != 0xFF) continue;
        var j = i + 3;
        while (j + 1 < buf.len) : (j += 1) {
            if (buf[j] == 0xFF and buf[j + 1] == 0xD9) {
                const end = j + 2;
                if (end - i < 16 or end - i > JPEG_MAX) return null;
                return buf[i..end];
            }
        }
        return null;
    }
    return null;
}

fn isAudioRel(rel: []const u8) bool {
    const ext = extOf(rel);
    for (AUDIO_EXT) |e| {
        if (std.ascii.eqlIgnoreCase(ext, e)) return true;
    }
    return false;
}

/// Last-resort poster: cheap JPEG scan (ID3 APIC / covr) written as cover.jpg.
fn extractEmbeddedCover(root: []const u8, rel: []const u8, store: *[512]u8) []const u8 {
    if (!isAudioRel(rel)) return "";
    const slash = std.mem.lastIndexOfScalar(u8, rel, '/') orelse return "";
    const dir_rel = rel[0..slash];
    if (dir_rel.len == 0) return "";
    var dest_buf: [1024]u8 = undefined;
    const dest = std.fmt.bufPrint(&dest_buf, "{s}/{s}/cover.jpg", .{ root, dir_rel }) catch return "";
    if (std.fs.cwd().access(dest, .{})) |_| {
        return std.fmt.bufPrint(store, "{s}/cover.jpg", .{dir_rel}) catch "";
    } else |_| {}
    var full_buf: [1024]u8 = undefined;
    const full = std.fmt.bufPrint(&full_buf, "{s}/{s}", .{ root, rel }) catch return "";
    const file = std.fs.cwd().openFile(full, .{}) catch return "";
    defer file.close();
    const n = file.readAll(cover_scan_buf[0..]) catch return "";
    const jpeg = findJpegIn(cover_scan_buf[0..n]) orelse return "";
    const out = std.fs.cwd().createFile(dest, .{}) catch return "";
    defer out.close();
    out.writeAll(jpeg) catch return "";
    return std.fmt.bufPrint(store, "{s}/cover.jpg", .{dir_rel}) catch "";
}

fn findVtt(root: []const u8, rel: []const u8, store: *[512]u8) []const u8 {
    const stem_rel = blk: {
        if (std.mem.lastIndexOfScalar(u8, rel, '.')) |d| break :blk rel[0..d];
        break :blk rel;
    };
    var cand: [768]u8 = undefined;
    const p = std.fmt.bufPrint(&cand, "{s}/{s}.vtt", .{ root, stem_rel }) catch return "";
    if (std.fs.cwd().access(p, .{})) |_| {
        return std.fmt.bufPrint(store, "{s}.vtt", .{stem_rel}) catch "";
    } else |_| return "";
}

fn probeFtyp(full: []const u8, brand_out: *[4]u8) []const u8 {
    const file = std.fs.cwd().openFile(full, .{}) catch return "";
    defer file.close();
    var hdr: [32]u8 = undefined;
    const n = file.readAll(&hdr) catch return "";
    if (n < 16) return "";
    if (!std.mem.eql(u8, hdr[4..8], "ftyp")) return "";
    @memcpy(brand_out, hdr[8..12]);
    return brand_out;
}

fn pathHasParentDir(rel: []const u8) bool {
    var it = std.mem.splitScalar(u8, rel, '/');
    while (it.next()) |part| {
        if (std.mem.eql(u8, part, "..")) return true;
    }
    return false;
}

/// Open + fstat. Zig 0.15 `Dir.statFile` uses `statx`, which DSM btrfs/ACL
/// shares reject; `openat`/`fstat` still work (busybox `stat` uses those).
fn ingestFile(root: []const u8, rel: []const u8, file_dir: std.fs.Dir, basename: []const u8) bool {
    if (pathHasParentDir(rel)) return false;
    if (rel.len == 0 or rel[0] == '/') return false;
    var full_buf: [4096]u8 = undefined;
    const full = std.fmt.bufPrint(&full_buf, "{s}/{s}", .{ root, rel }) catch return false;
    const opened = file_dir.openFile(basename, .{}) catch |err| {
        std.debug.print("ingest open {s} {}\n", .{ rel, err });
        return false;
    };
    defer opened.close();
    const pst = std.posix.fstat(opened.handle) catch |err| {
        std.debug.print("ingest fstat {s} {}\n", .{ rel, err });
        return false;
    };
    const st = std.fs.File.Stat.fromPosix(pst);
    const mtime_ns: u64 = if (st.mtime < 0) 0 else @intCast(st.mtime);
    const id_arr = opaqueId(rel, st.size, mtime_ns);
    const id: []const u8 = &id_arr;
    const stem_rel = blk: {
        if (std.mem.lastIndexOfScalar(u8, rel, '.')) |d| break :blk rel[0..d];
        break :blk rel;
    };
    var nfo_path: [1024]u8 = undefined;
    const sibling_nfo = std.fmt.bufPrint(&nfo_path, "{s}/{s}.nfo", .{ root, stem_rel }) catch "";
    const sibling = if (sibling_nfo.len > 0) loadNfoFull(sibling_nfo) else null;
    const stem = stemOf(rel);
    const title: []const u8 = if (sibling) |p| (if (p.title.len > 0) p.title else stem) else stem;
    var year = yearFromName(stem);
    if (year == 0) year = yearFromName(parentName(rel));
    var poster_buf: [512]u8 = undefined;
    var backdrop_buf: [512]u8 = undefined;
    var logo_buf: [512]u8 = undefined;
    var sub_buf: [512]u8 = undefined;
    var poster = findSidecar(root, rel, &poster_buf);
    if (poster.len == 0) poster = extractEmbeddedCover(root, rel, &poster_buf);
    const backdrop = findBackdropSidecar(root, rel, &backdrop_buf);
    const logo = findLogoSidecar(root, rel, &logo_buf);
    const subtitle = findVtt(root, rel, &sub_buf);
    var brand_buf: [4]u8 = undefined;
    const brand = probeFtyp(full, &brand_buf);
    const se = koru_media.koru_graph.parseSeasonEpisode(rel);
    var imdb_buf: [16]u8 = undefined;
    var imdb_id = koru_media.koru_graph.parseImdbId(rel, &imdb_buf);
    if (imdb_id.len == 0) {
        if (sibling) |p| {
            if (p.imdb.len > 0) {
                const n = @min(p.imdb.len, imdb_buf.len);
                @memcpy(imdb_buf[0..n], p.imdb[0..n]);
                imdb_id = imdb_buf[0..n];
            }
        }
    }
    const work = koru_media.koru_graph.workKey(rel);
    if (sibling) |parsed| {
        applyNfoOverlay(work, se.season, se.episode, parsed, false);
    }
    if (imdb_id.len == 0) {
        const names = [_][]const u8{ "tvshow.nfo", "movie.nfo" };
        for (names) |name| {
            var work_nfo: [1024]u8 = undefined;
            const full_nfo = std.fmt.bufPrint(&work_nfo, "{s}/{s}/{s}", .{ root, work, name }) catch continue;
            const parsed = loadNfoFull(full_nfo) orelse continue;
            if (parsed.imdb.len == 0) continue;
            const n = @min(parsed.imdb.len, imdb_buf.len);
            @memcpy(imdb_buf[0..n], parsed.imdb[0..n]);
            imdb_id = imdb_buf[0..n];
            break;
        }
    }
    var wt_buf: [256]u8 = undefined;
    const work_title = koru_media.koru_graph.workDisplayTitle(work, &wt_buf);
    const e = koru_media.koru_graph.Entry{
        .id = id,
        .kind = kindFor(rel),
        .title = title,
        .path = rel,
        .bytes = st.size,
        .modified_ns = mtime_ns,
        .mime = mimeFor(rel),
        .container = containerFor(rel),
        .poster = poster,
        .backdrop = backdrop,
        .logo = logo,
        .subtitle = subtitle,
        .year = year,
        .video_codec = if (brand.len > 0) "unknown" else "",
        .video_brand = brand,
        .audio_codec = "",
        .season = se.season,
        .episode = se.episode,
        .imdb_id = imdb_id,
        .work_title = work_title,
    };
    upsert(e);
    ingestWorkNfo(root, work, "tvshow.nfo");
    ingestWorkNfo(root, work, "movie.nfo");
    return true;
}

fn skipDsmJunk(name: []const u8) bool {
    return std.mem.eql(u8, name, "@eaDir") or std.mem.eql(u8, name, "#recycle") or std.mem.eql(u8, name, "@tmp");
}

fn joinRel(buf: *[1024]u8, a: []const u8, b: []const u8) ?[]const u8 {
    if (a.len == 0) {
        if (b.len > buf.len) return null;
        @memcpy(buf[0..b.len], b);
        return buf[0..b.len];
    }
    return std.fmt.bufPrint(buf, "{s}/{s}", .{ a, b }) catch null;
}

fn entryKind(dir: std.fs.Dir, name: []const u8, reported: std.fs.File.Kind) ?std.fs.File.Kind {
    if (reported != .unknown) return reported;
    const st = dir.statFile(name) catch return null;
    return st.kind;
}

/// Iterate one library folder. Zig's Dir.walk only descends `.directory` and
/// aborts the tree on AccessDenied (`@eaDir`). DSM shares often report
/// DT_UNKNOWN, so we stat and keep going on errors.
fn walkMediaDir(root: []const u8, prefix: []const u8, dir: std.fs.Dir, rel_from_lib: []const u8, stop_first: bool) usize {
    var it = dir.iterate();
    var n: usize = 0;
    var listed: usize = 0;
    while (true) {
        const ent = it.next() catch |err| {
            std.debug.print("iterate {s}/{s} err {}\n", .{ prefix, rel_from_lib, err });
            break;
        } orelse break;
        listed += 1;
        if (skipDsmJunk(ent.name)) continue;
        const kind = entryKind(dir, ent.name, ent.kind) orelse continue;
        if (kind == .directory) {
            var sub = dir.openDir(ent.name, .{ .iterate = true }) catch |err| {
                if (rel_from_lib.len == 0) std.debug.print("openDir {s}/{s} {}\n", .{ prefix, ent.name, err });
                continue;
            };
            defer sub.close();
            var child_buf: [1024]u8 = undefined;
            const child = joinRel(&child_buf, rel_from_lib, ent.name) orelse continue;
            n += walkMediaDir(root, prefix, sub, child, stop_first);
            if (stop_first and n > 0) return n;
            continue;
        }
        if (kind != .file) continue;
        if (!isMediaName(ent.name)) continue;
        if (stop_first) return 1;
        var rel_buf: [1024]u8 = undefined;
        const rel = if (prefix.len == 0)
            (joinRel(&rel_buf, rel_from_lib, ent.name) orelse continue)
        else if (rel_from_lib.len == 0)
            (joinRel(&rel_buf, prefix, ent.name) orelse continue)
        else
            (std.fmt.bufPrint(&rel_buf, "{s}/{s}/{s}", .{ prefix, rel_from_lib, ent.name }) catch continue);
        if (ingestFile(root, rel, dir, ent.name)) n += 1;
    }
    if (rel_from_lib.len == 0) {
        std.debug.print("listed {s} {d} ingested {d}\n", .{ prefix, listed, n });
    }
    return n;
}

fn treeHasMedia(root: []const u8, prefix: []const u8) bool {
    var dir_buf: [1024]u8 = undefined;
    const dir_path = if (prefix.len == 0)
        root
    else
        (std.fmt.bufPrint(&dir_buf, "{s}/{s}", .{ root, prefix }) catch return false);
    var dir = std.fs.cwd().openDir(dir_path, .{ .iterate = true }) catch return false;
    defer dir.close();
    return walkMediaDir(root, prefix, dir, "", true) > 0;
}

/// True when an enabled library bind actually contains media files.
/// Empty image placeholders and unreadable ACL mounts return false.
pub fn mediaHasFiles(root: []const u8) bool {
    if (!catalog_ready) return false;
    ensureLibraryRoots();
    var roots_buf: [MAX_LIBRARY_ROOTS]LibraryRoot = undefined;
    const roots = listLibraryRoots(&roots_buf);
    var any = false;
    for (roots) |lib| {
        if (!lib.enabled or lib.rel_path.len == 0) continue;
        any = true;
        if (treeHasMedia(root, lib.rel_path)) return true;
    }
    if (!any) return treeHasMedia(root, "");
    return false;
}

fn indexOneTree(root: []const u8, prefix: []const u8) usize {
    var dir_buf: [1024]u8 = undefined;
    const dir_path = if (prefix.len == 0)
        root
    else
        (std.fmt.bufPrint(&dir_buf, "{s}/{s}", .{ root, prefix }) catch return 0);
    var dir = std.fs.cwd().openDir(dir_path, .{ .iterate = true }) catch |err| {
        std.debug.print("indexOneTree open {s} failed: {}\n", .{ dir_path, err });
        return 0;
    };
    defer dir.close();
    return walkMediaDir(root, prefix, dir, "", false);
}

/// Walk enabled library roots under `root` (container `/media` or fixtures)
/// and replace the catalog. Disabled Settings mounts are skipped.
/// If the walk finds nothing but the catalog already had rows, roll back so
/// a bind-mount miss during Watchtower recreate cannot wipe the library.
pub fn reindex(root: []const u8) usize {
    if (!catalog_ready) return 0;
    ensureLibraryRoots();
    const before = count();
    execSql("BEGIN");
    execSql("DELETE FROM entries");
    execSql("DELETE FROM nfo_works");
    execSql("DELETE FROM nfo_episodes");
    var roots_buf: [MAX_LIBRARY_ROOTS]LibraryRoot = undefined;
    const roots = listLibraryRoots(&roots_buf);
    std.debug.print("reindex roots {d} under {s}\n", .{ roots.len, root });
    var n: usize = 0;
    var enabled_n: usize = 0;
    for (roots) |lib| {
        if (!lib.enabled or lib.rel_path.len == 0) continue;
        var path_buf: [256]u8 = undefined;
        const take = @min(lib.rel_path.len, path_buf.len);
        @memcpy(path_buf[0..take], lib.rel_path[0..take]);
        enabled_n += 1;
        const got = indexOneTree(root, path_buf[0..take]);
        std.debug.print("reindex tree {s} -> {d}\n", .{ path_buf[0..take], got });
        n += got;
    }
    if (roots.len == 0) {
        n += indexOneTree(root, "");
    }
    if (n == 0 and before > 0) {
        execSql("ROLLBACK");
        std.debug.print("reindex found 0 files under {s} (had {d}); rolled back\n", .{ root, before });
        return before;
    }
    execSql("COMMIT");
    encodeFilenameGraph();
    std.debug.print("indexed {d} entries under {s} ({d} libraries)\n", .{ n, root, enabled_n });
    return n;
}
