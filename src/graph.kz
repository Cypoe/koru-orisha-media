// media/graph — physical manifest + semantic core (not Orisha).
// Sibling stem under src/ (Koru: import media loads index; graph.kz is media/graph).
// Schema scrape of entries[] + projections[] (orisha.item / orisha.links /
// schema.org.jsonld). Handlers never call TMDB, TVDB, or ffmpeg.

const std = @import("std");

const DEFAULT_MEDIA_ROOT = "fixtures/media";
const DEFAULT_MANIFEST_PATH = "data/manifest.json";
const DEFAULT_SEMANTIC_PATH = "data/semantic.json";
const DEFAULT_CATALOG_PATH = "data/catalog.sqlite";
pub const Entry = struct {
    id: []const u8,
    kind: []const u8,
    title: []const u8,
    path: []const u8,
    bytes: u64,
    modified_ns: u64,
    mime: []const u8,
    container: []const u8,
    poster: []const u8,
    /// Relative WebVTT sidecar path (empty if absent).
    subtitle: []const u8,
    year: u32,
    /// First nested `video[]` track facts from indexer probe (empty if absent).
    video_codec: []const u8,
    video_brand: []const u8,
    /// First nested `audio[]` track codec (empty if absent).
    audio_codec: []const u8,
    /// Parsed from `SxxEyy` / Sonarr season folders. 0 if unknown.
    season: u32 = 0,
    episode: u32 = 0,
    /// Local IMDb assertion from `[tt…]` / `[imdbid-tt…]` on disk. No HTTP.
    imdb_id: []const u8 = "",
    /// Series/movie folder title with `[tt…]` / `(year)` stripped.
    work_title: []const u8 = "",
};

/// Offline nfo overlay (plot / air date / rating). Join on work_key + season/episode.
pub const NfoMeta = struct {
    plot: []const u8 = "",
    aired: []const u8 = "",
    rating: []const u8 = "",
};

/// Offline TMDB/TVDB overlay. Keyed by `[tt…]` already on disk. Handlers only read.
pub const HydrateMeta = struct {
    poster_url: []const u8 = "",
    actors: []const u8 = "",
    plot: []const u8 = "",
    title: []const u8 = "",
    year: u32 = 0,
    tmdb_id: []const u8 = "",
    tvdb_id: []const u8 = "",
    source: []const u8 = "",
};

pub const MAX_PAGE: usize = koru_media.koru_catalog.MAX_PAGE;

var loaded = false;
var storage: [1024 * 1024]u8 = undefined;
var storage_len: usize = 0;
var config_storage_end: usize = 0;
var manifest_file_buf: [2 * 1024 * 1024]u8 = undefined;
var semantic_file_buf: [256 * 1024]u8 = undefined;
var manifest_mtime_ns: i128 = -1;
var media_root_owned: []const u8 = DEFAULT_MEDIA_ROOT;
var manifest_path_owned: []const u8 = DEFAULT_MANIFEST_PATH;
var semantic_path_owned: []const u8 = DEFAULT_SEMANTIC_PATH;
var catalog_path_owned: []const u8 = DEFAULT_CATALOG_PATH;
var reindex_flag_owned: []const u8 = "data/reindex.requested";
var base_path_buf: [256]u8 = undefined;
var base_path_len: usize = 0;
var base_path_owned: []const u8 = "";
var req_base_buf: [256]u8 = undefined;
var req_base: []const u8 = "";
var req_base_set = false;
var cfg_ready = false;

const DEFAULT_CONFIG_PATH = "/config/settings.conf";
var config_path_owned: []const u8 = DEFAULT_CONFIG_PATH;
var settings_file_buf: [16 * 1024]u8 = undefined;
var settings_store: [8192]u8 = undefined;
var settings_store_len: usize = 0;
var settings_driver_buf: [32]u8 = undefined;
var settings_driver_len: usize = 0;
var settings_dsn_buf: [512]u8 = undefined;
var settings_dsn_len: usize = 0;
var settings_walk_on_empty: bool = true;
var settings_have_file = false;
var pending_libs: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS]koru_media.koru_catalog.LibraryRoot = undefined;
var pending_lib_n: usize = 0;
var pending_from_file = false;

pub const SemanticJoin = struct {
    // Join key is the physical opaque id (m_*). Local work ids (work.movie.*)
    // live in the semantic snapshot only — never in /item/{id} URLs.
    asset_id: []const u8,
    display_title: []const u8,
    display_description: []const u8,
    tmdb_url: []const u8,
    imdb_url: []const u8,
    jsonld: []const u8,
};

var semantic_loaded = false;
var semantic_buf: [512]SemanticJoin = undefined;
var semantic_count: usize = 0;
var semantic_mtime_ns: i128 = -1;

fn allocDup(s: []const u8) ?[]const u8 {
    if (s.len == 0) return "";
    if (storage_len + s.len > storage.len) return null;
    const out = storage[storage_len .. storage_len + s.len];
    @memcpy(out, s);
    storage_len += s.len;
    return out;
}

fn envOr(name: []const u8, fallback: []const u8) []const u8 {
    return std.posix.getenv(name) orelse fallback;
}

fn envIs1(name: []const u8) bool {
    const v = std.posix.getenv(name) orelse return false;
    return std.mem.eql(u8, v, "1") or std.ascii.eqlIgnoreCase(v, "true") or std.ascii.eqlIgnoreCase(v, "yes");
}

fn normalizeBase(raw: []const u8) []const u8 {
    var s = std.mem.trim(u8, raw, " \t\r\n");
    if (s.len == 0 or std.mem.eql(u8, s, "/")) return "";
    if (s[s.len - 1] == '/') s = s[0 .. s.len - 1];
    if (s.len == 0) return "";
    if (s[0] != '/') {
        var tmp: [248]u8 = undefined;
        const with = std.fmt.bufPrint(&tmp, "/{s}", .{s}) catch return "";
        return allocDup(with) orelse "";
    }
    return allocDup(s) orelse "";
}

fn copyBaseTo(buf: []u8, raw: []const u8) []const u8 {
    var s = std.mem.trim(u8, raw, " \t\r\n");
    if (s.len == 0 or std.mem.eql(u8, s, "/")) return "";
    if (s[s.len - 1] == '/') s = s[0 .. s.len - 1];
    if (s.len == 0) return "";
    if (s[0] != '/') {
        if (s.len + 1 > buf.len) return "";
        buf[0] = '/';
        @memcpy(buf[1 .. 1 + s.len], s);
        return buf[0 .. 1 + s.len];
    }
    if (s.len > buf.len) return "";
    @memcpy(buf[0..s.len], s);
    return buf[0..s.len];
}

fn storeBase(raw: []const u8) []const u8 {
    const copied = copyBaseTo(&base_path_buf, raw);
    base_path_len = copied.len;
    base_path_owned = base_path_buf[0..base_path_len];
    return base_path_owned;
}

fn isForbiddenBase(s: []const u8) bool {
    return std.ascii.eqlIgnoreCase(s, "/media");
}

fn settingsDup(s: []const u8) []const u8 {
    return storeDup(&settings_store, &settings_store_len, s);
}

fn parseLibIndex(key: []const u8, prefix: []const u8) ?usize {
    if (!std.mem.startsWith(u8, key, prefix)) return null;
    const rest = key[prefix.len..];
    const dot = std.mem.indexOfScalar(u8, rest, '.') orelse return null;
    return std.fmt.parseInt(usize, rest[0..dot], 10) catch null;
}

fn parseLibField(key: []const u8, prefix: []const u8) ?[]const u8 {
    if (!std.mem.startsWith(u8, key, prefix)) return null;
    const rest = key[prefix.len..];
    const dot = std.mem.indexOfScalar(u8, rest, '.') orelse return null;
    return rest[dot + 1 ..];
}

fn loadSettingsFile() void {
    settings_store_len = 0;
    pending_lib_n = 0;
    pending_from_file = false;
    settings_have_file = false;
    settings_driver_len = 0;
    settings_dsn_len = 0;
    settings_walk_on_empty = true;
    const path = envOr("KORU_CONFIG", DEFAULT_CONFIG_PATH);
    config_path_owned = allocDup(path) orelse DEFAULT_CONFIG_PATH;
    const file = std.fs.cwd().openFile(config_path_owned, .{}) catch return;
    defer file.close();
    const n = file.readAll(&settings_file_buf) catch return;
    settings_have_file = true;
    var names: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS][]const u8 = .{""} ** koru_media.koru_catalog.MAX_LIBRARY_ROOTS;
    var paths: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS][]const u8 = .{""} ** koru_media.koru_catalog.MAX_LIBRARY_ROOTS;
    var caps: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS][]const u8 = .{""} ** koru_media.koru_catalog.MAX_LIBRARY_ROOTS;
    var affs: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS][]const u8 = .{""} ** koru_media.koru_catalog.MAX_LIBRARY_ROOTS;
    var ons: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS]bool = .{true} ** koru_media.koru_catalog.MAX_LIBRARY_ROOTS;
    var seen: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS]bool = .{false} ** koru_media.koru_catalog.MAX_LIBRARY_ROOTS;
    var it = std.mem.splitScalar(u8, settings_file_buf[0..n], '\n');
    while (it.next()) |raw_line| {
        const line = std.mem.trim(u8, raw_line, " \t\r");
        if (line.len == 0 or line[0] == '#') continue;
        const eq = std.mem.indexOfScalar(u8, line, '=') orelse continue;
        const key = std.mem.trim(u8, line[0..eq], " \t");
        const val = settingsDup(std.mem.trim(u8, line[eq + 1 ..], " \t"));
        if (std.mem.eql(u8, key, "base_path")) {
            if (!isForbiddenBase(val)) _ = storeBase(val);
        } else if (std.mem.eql(u8, key, "catalog_driver")) {
            const take = @min(val.len, settings_driver_buf.len);
            @memcpy(settings_driver_buf[0..take], val[0..take]);
            settings_driver_len = take;
        } else if (std.mem.eql(u8, key, "catalog_dsn")) {
            const take = @min(val.len, settings_dsn_buf.len);
            @memcpy(settings_dsn_buf[0..take], val[0..take]);
            settings_dsn_len = take;
        } else if (std.mem.eql(u8, key, "walk_on_empty")) {
            settings_walk_on_empty = !(std.mem.eql(u8, val, "0") or std.ascii.eqlIgnoreCase(val, "false") or std.ascii.eqlIgnoreCase(val, "no"));
        } else if (parseLibIndex(key, "lib.")) |idx| {
            if (idx >= koru_media.koru_catalog.MAX_LIBRARY_ROOTS) continue;
            const field = parseLibField(key, "lib.") orelse continue;
            seen[idx] = true;
            if (std.mem.eql(u8, field, "name")) names[idx] = val;
            if (std.mem.eql(u8, field, "path")) paths[idx] = val;
            if (std.mem.eql(u8, field, "capability")) caps[idx] = val;
            if (std.mem.eql(u8, field, "affordances")) affs[idx] = val;
            if (std.mem.eql(u8, field, "enabled")) ons[idx] = !(std.mem.eql(u8, val, "0") or std.ascii.eqlIgnoreCase(val, "false"));
        }
    }
    var i: usize = 0;
    while (i < koru_media.koru_catalog.MAX_LIBRARY_ROOTS) : (i += 1) {
        if (!seen[i] or paths[i].len == 0) continue;
        pending_libs[pending_lib_n] = .{
            .display_name = if (names[i].len > 0) names[i] else paths[i],
            .rel_path = paths[i],
            .enabled = ons[i],
            .capability = caps[i],
            .affordances = affs[i],
        };
        pending_lib_n += 1;
    }
    pending_from_file = pending_lib_n > 0;
}

fn writeSettingsFile(base: []const u8, driver: []const u8, dsn: []const u8, walk: bool, roots: []const koru_media.koru_catalog.LibraryRoot) bool {
    var buf: [16 * 1024]u8 = undefined;
    var w: usize = 0;
    const append = struct {
        fn go(dest: []u8, wp: *usize, piece: []const u8) void {
            if (wp.* + piece.len > dest.len) return;
            @memcpy(dest[wp.* .. wp.* + piece.len], piece);
            wp.* += piece.len;
        }
    }.go;
    append(&buf, &w, "# koru-orisha-media settings. Lives on the /config host bind.\n");
    append(&buf, &w, "base_path=");
    append(&buf, &w, base);
    append(&buf, &w, "\ncatalog_driver=");
    append(&buf, &w, driver);
    append(&buf, &w, "\ncatalog_dsn=");
    append(&buf, &w, dsn);
    append(&buf, &w, "\nwalk_on_empty=");
    append(&buf, &w, if (walk) "1" else "0");
    append(&buf, &w, "\n");
    var i: usize = 0;
    while (i < roots.len) : (i += 1) {
        const r = roots[i];
        var idx_buf: [8]u8 = undefined;
        const idx = std.fmt.bufPrint(&idx_buf, "{d}", .{i}) catch continue;
        append(&buf, &w, "\nlib.");
        append(&buf, &w, idx);
        append(&buf, &w, ".name=");
        append(&buf, &w, r.display_name);
        append(&buf, &w, "\nlib.");
        append(&buf, &w, idx);
        append(&buf, &w, ".path=");
        append(&buf, &w, r.rel_path);
        append(&buf, &w, "\nlib.");
        append(&buf, &w, idx);
        append(&buf, &w, ".enabled=");
        append(&buf, &w, if (r.enabled) "1" else "0");
        append(&buf, &w, "\nlib.");
        append(&buf, &w, idx);
        append(&buf, &w, ".capability=");
        append(&buf, &w, r.capability);
        append(&buf, &w, "\nlib.");
        append(&buf, &w, idx);
        append(&buf, &w, ".affordances=");
        append(&buf, &w, r.affordances);
        append(&buf, &w, "\n");
    }
    if (std.mem.lastIndexOfScalar(u8, config_path_owned, '/')) |slash| {
        if (slash > 0) std.fs.cwd().makePath(config_path_owned[0..slash]) catch {};
    }
    const f = std.fs.cwd().createFile(config_path_owned, .{}) catch return false;
    defer f.close();
    f.writeAll(buf[0..w]) catch return false;
    settings_have_file = true;
    return true;
}

fn rememberDriver(driver: []const u8, dsn: []const u8) void {
    const dtake = @min(driver.len, settings_driver_buf.len);
    @memcpy(settings_driver_buf[0..dtake], driver[0..dtake]);
    settings_driver_len = dtake;
    const stake = @min(dsn.len, settings_dsn_buf.len);
    @memcpy(settings_dsn_buf[0..stake], dsn[0..stake]);
    settings_dsn_len = stake;
}

pub fn catalogDriver() []const u8 {
    ensureConfig();
    if (settings_driver_len == 0) return "sqlite";
    return settings_driver_buf[0..settings_driver_len];
}

pub fn catalogDsn() []const u8 {
    ensureConfig();
    if (settings_dsn_len == 0) return catalog_path_owned;
    return settings_dsn_buf[0..settings_dsn_len];
}

pub fn catalogDriverLinked() bool {
    return std.ascii.eqlIgnoreCase(catalogDriver(), "sqlite");
}

pub fn walkOnEmpty() bool {
    ensureConfig();
    return settings_walk_on_empty;
}

pub fn configPath() []const u8 {
    ensureConfig();
    return config_path_owned;
}

/// Persist settings to /config and library_roots. Returns false if the catalog
/// cannot be written. /config write failure is non-fatal (sqlite still saved).
pub fn persistAppSettings(base: []const u8, driver: []const u8, dsn: []const u8, walk: bool, roots: []const koru_media.koru_catalog.LibraryRoot) bool {
    ensureConfig();
    if (isForbiddenBase(base)) return false;
    _ = storeBase(base);
    rememberDriver(driver, dsn);
    settings_walk_on_empty = walk;
    if (!koru_media.koru_catalog.saveLibraryRoots(roots)) return false;
    _ = writeSettingsFile(base_path_owned, catalogDriver(), if (settings_dsn_len > 0) settings_dsn_buf[0..settings_dsn_len] else catalog_path_owned, walk, roots);
    return true;
}

/// Apply a new base path in-process. Null if empty-after-normalize is OK, error
/// string not used — returns false when the value is `/media`.
pub fn applyBasePath(raw: []const u8) bool {
    if (isForbiddenBase(std.mem.trim(u8, raw, " \t\r\n"))) return false;
    _ = storeBase(raw);
    return true;
}

fn storeDup(store: []u8, used: *usize, s: []const u8) []const u8 {
    if (s.len == 0) return "";
    if (used.* + s.len > store.len) return "";
    const out = store[used.* .. used.* + s.len];
    @memcpy(out, s);
    used.* += s.len;
    return out;
}

fn siblingName(path: []const u8, name: []const u8) []const u8 {
    const slash = std.mem.lastIndexOfScalar(u8, path, '/') orelse return name;
    var tmp: [512]u8 = undefined;
    const out = std.fmt.bufPrint(&tmp, "{s}/{s}", .{ path[0..slash], name }) catch return name;
    return allocDup(out) orelse name;
}

/// Outbound URL prefix (`""` or `"/korisha"`). WebStation alias / reverse-proxy.
/// Do not set `KORU_BASE_PATH=/media` — that collides with `GET /media/{id}`.
pub fn basePath() []const u8 {
    if (req_base_set) return req_base;
    ensureConfig();
    return base_path_owned;
}

fn stripKnownBase(path: []const u8, base: []const u8) ?[]const u8 {
    if (base.len == 0) return null;
    if (!std.mem.startsWith(u8, path, base)) return null;
    const rest = path[base.len..];
    if (rest.len == 0) return "/";
    if (rest[0] == '/') return rest;
    return null;
}

/// Strip configured / forwarded prefix, then match app routes (`/library`, …).
/// Works when the proxy forwards `/korisha/library` or strips to `/library`
/// and sets `X-Forwarded-Prefix`.
pub fn routePath(path: []const u8) []const u8 {
    ensureConfig();
    if (stripKnownBase(path, basePath())) |rest| return rest;
    if (stripKnownBase(path, base_path_owned)) |rest| return rest;
    return path;
}

/// Per-request: honor `X-Forwarded-Prefix` when the proxy strips or forwards a prefix.
/// Empty header falls back to `KORU_BASE_PATH` so `/korisha/…` still strips.
pub fn beginRequest(path: []const u8, forwarded_prefix: ?[]const u8) []const u8 {
    ensureConfig();
    req_base_set = true;
    if (forwarded_prefix) |p| {
        const copied = copyBaseTo(&req_base_buf, p);
        req_base = if (copied.len > 0) copied else base_path_owned;
    } else {
        req_base = base_path_owned;
    }
    return routePath(path);
}

pub fn ensureConfig() void {
    if (cfg_ready) return;
    cfg_ready = true;
    loadSettingsFile();
    media_root_owned = allocDup(envOr("KORU_MEDIA_ROOT", DEFAULT_MEDIA_ROOT)) orelse DEFAULT_MEDIA_ROOT;
    manifest_path_owned = allocDup(envOr("KORU_MANIFEST", DEFAULT_MANIFEST_PATH)) orelse DEFAULT_MANIFEST_PATH;
    semantic_path_owned = allocDup(envOr("KORU_SEMANTIC", DEFAULT_SEMANTIC_PATH)) orelse DEFAULT_SEMANTIC_PATH;
    const env_catalog = envOr("KORU_CATALOG", DEFAULT_CATALOG_PATH);
    const driver = if (settings_driver_len > 0) settings_driver_buf[0..settings_driver_len] else "sqlite";
    if (!std.ascii.eqlIgnoreCase(driver, "sqlite")) {
        std.debug.print("catalog driver {s} is not linked; using sqlite\n", .{driver});
    }
    const sqlite_path = if (std.ascii.eqlIgnoreCase(driver, "sqlite") and settings_dsn_len > 0)
        settings_dsn_buf[0..settings_dsn_len]
    else
        env_catalog;
    catalog_path_owned = allocDup(sqlite_path) orelse DEFAULT_CATALOG_PATH;
    if (settings_driver_len == 0) {
        rememberDriver("sqlite", catalog_path_owned);
    } else if (settings_dsn_len == 0) {
        rememberDriver(driver, catalog_path_owned);
    }
    reindex_flag_owned = siblingName(catalog_path_owned, "reindex.requested");
    if (base_path_len == 0) {
        const env_base = envOr("KORU_BASE_PATH", "");
        if (!isForbiddenBase(env_base)) _ = storeBase(env_base);
    }
    config_storage_end = storage_len;
    koru_media.koru_catalog.open(catalog_path_owned);
    if (pending_from_file and pending_lib_n > 0) {
        _ = koru_media.koru_catalog.saveLibraryRoots(pending_libs[0..pending_lib_n]);
    } else if (!settings_have_file) {
        var roots_buf: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS]koru_media.koru_catalog.LibraryRoot = undefined;
        const roots = koru_media.koru_catalog.listLibraryRoots(&roots_buf);
        _ = writeSettingsFile(base_path_owned, driver, catalog_path_owned, settings_walk_on_empty, roots);
    }
    if (envIs1("KORU_HYDRATE")) {
        std.debug.print("KORU_HYDRATE=1: overlay tables ready; provider HTTP is host-side (scripts/hydrate_catalog.py --catalog {s})\n", .{catalog_path_owned});
    }
    if (envIs1("KORU_REINDEX")) {
        _ = koru_media.koru_catalog.reindex(media_root_owned);
        loaded = true;
        manifest_mtime_ns = manifestMtimeNs();
        return;
    }
    if (koru_media.koru_catalog.count() == 0) {
        loadManifest();
        loaded = true;
        manifest_mtime_ns = manifestMtimeNs();
        if (koru_media.koru_catalog.count() == 0 and settings_walk_on_empty and koru_media.koru_catalog.mediaHasFiles(media_root_owned)) {
            _ = koru_media.koru_catalog.reindex(media_root_owned);
        }
        return;
    }
    loaded = true;
    manifest_mtime_ns = manifestMtimeNs();
}

fn manifestMtimeNs() i128 {
    ensureConfig();
    const file = std.fs.cwd().openFile(manifest_path_owned, .{}) catch return -1;
    defer file.close();
    const st = file.stat() catch return -1;
    return st.mtime;
}

fn semanticMtimeNs() i128 {
    ensureConfig();
    const file = std.fs.cwd().openFile(semantic_path_owned, .{}) catch return -1;
    defer file.close();
    const st = file.stat() catch return -1;
    return st.mtime;
}

fn maybeReindexFlag() void {
    ensureConfig();
    const file = std.fs.cwd().openFile(reindex_flag_owned, .{}) catch return;
    file.close();
    _ = koru_media.koru_catalog.reindex(media_root_owned);
    std.fs.cwd().deleteFile(reindex_flag_owned) catch {};
}

/// Swap in a new immutable snapshot when the file changes and no media streams
/// are in flight (in-flight requests already hold paths/bytes from findEntry).
pub fn maybeReloadManifest() void {
    ensureConfig();
    if (koru_http.streamsBusy()) return;
    maybeReindexFlag();
    const mt = manifestMtimeNs();
    const smt = semanticMtimeNs();
    const manifest_changed = mt >= 0 and mt != manifest_mtime_ns;
    const semantic_changed = smt != semantic_mtime_ns;
    if (!manifest_changed and !semantic_changed) return;
    if (manifest_changed) {
        koru_media.koru_catalog.clear();
        loaded = false;
        storage_len = config_storage_end;
        manifest_mtime_ns = mt;
        loadManifest();
        loaded = true;
    }
    if (semantic_changed) {
        semantic_loaded = false;
        semantic_count = 0;
        semantic_mtime_ns = smt;
        loadSemantic();
    }
}

fn loadManifest() void {
    if (loaded) return;
    ensureConfig();
    const file = std.fs.cwd().openFile(manifest_path_owned, .{}) catch return;
    defer file.close();
    const n = file.readAll(&manifest_file_buf) catch return;
    const text = manifest_file_buf[0..n];
    // Schema-specific: only walk objects inside the top-level "entries" array.
    // Avoids false positives on keys outside entries and cross-object field bleed.
    const entries = entriesArraySlice(text) orelse return;
    var i: usize = 0;
    while (i < entries.len) : (i += 1) {
        if (std.mem.startsWith(u8, entries[i..], "\"id\"")) {
            const obj = entryObjectSlice(entries, i);
            const id = extractAfterUnescaped(obj, "\"id\"") orelse continue;
            const title = extractAfterUnescaped(obj, "\"title\"") orelse id;
            const path = extractAfterUnescaped(obj, "\"path\"") orelse continue;
            const mime = extractAfterUnescaped(obj, "\"mime\"") orelse "application/octet-stream";
            const kind = extractAfterUnescaped(obj, "\"kind\"") orelse "file";
            const container = extractAfterUnescaped(obj, "\"container\"") orelse "";
            const poster = extractAfterUnescaped(obj, "\"poster\"") orelse "";
            const subtitle = extractAfterUnescaped(obj, "\"subtitle\"") orelse "";
            const bytes = extractNumberAfter(obj, "\"bytes\"") orelse 0;
            const modified_ns = extractNumberAfter(obj, "\"modified_ns\"") orelse 0;
            const year_u64 = extractNumberAfter(obj, "\"year\"") orelse 0;
            const year: u32 = if (year_u64 > 9999) 0 else @intCast(year_u64);
            const video_track = firstArrayObjectSlice(obj, "\"video\"") orelse "";
            const audio_track = firstArrayObjectSlice(obj, "\"audio\"") orelse "";
            const video_codec = if (video_track.len > 0) extractAfterUnescaped(video_track, "\"codec\"") orelse "" else "";
            const video_brand = if (video_track.len > 0) extractAfterUnescaped(video_track, "\"brand\"") orelse "" else "";
            const audio_codec = if (audio_track.len > 0) extractAfterUnescaped(audio_track, "\"codec\"") orelse "" else "";
            if (id.len == 0 or path.len == 0) continue;
            koru_media.koru_catalog.upsert(.{
                .id = id,
                .kind = kind,
                .title = title,
                .path = path,
                .bytes = bytes,
                .modified_ns = modified_ns,
                .mime = mime,
                .container = container,
                .poster = poster,
                .subtitle = subtitle,
                .year = year,
                .video_codec = video_codec,
                .video_brand = video_brand,
                .audio_codec = audio_codec,
            });
            const se = parseSeasonEpisode(path);
            const work = workKey(path);
            const plot = extractAfterUnescaped(obj, "\"plot\"") orelse "";
            const aired = extractAfterUnescaped(obj, "\"aired\"") orelse "";
            const rating = extractAfterUnescaped(obj, "\"rating\"") orelse "";
            if (plot.len > 0 or aired.len > 0 or rating.len > 0) {
                if (se.season > 0 or se.episode > 0) {
                    koru_media.koru_catalog.upsertNfoEpisode(work, se.season, se.episode, plot, aired, rating);
                } else {
                    koru_media.koru_catalog.upsertNfoWork(work, plot, aired, rating);
                }
            }
            const work_plot = extractAfterUnescaped(obj, "\"work_plot\"") orelse "";
            const work_aired = extractAfterUnescaped(obj, "\"work_aired\"") orelse "";
            const work_rating = extractAfterUnescaped(obj, "\"work_rating\"") orelse "";
            if (work_plot.len > 0 or work_aired.len > 0 or work_rating.len > 0) {
                koru_media.koru_catalog.upsertNfoWork(work, work_plot, work_aired, work_rating);
            }
        }
    }
}

fn jsonArraySlice(text: []const u8, key: []const u8) ?[]const u8 {
    const at = std.mem.indexOf(u8, text, key) orelse return null;
    var p = at + key.len;
    while (p < text.len and (text[p] == ' ' or text[p] == '\t' or text[p] == '\n' or text[p] == '\r' or text[p] == ':')) : (p += 1) {}
    if (p >= text.len or text[p] != '[') return null;
    var depth: i32 = 0;
    var in_string = false;
    var escape = false;
    var k = p;
    while (k < text.len) : (k += 1) {
        const ch = text[k];
        if (in_string) {
            if (escape) {
                escape = false;
            } else if (ch == '\\') {
                escape = true;
            } else if (ch == '"') {
                in_string = false;
            }
            continue;
        }
        if (ch == '"') {
            in_string = true;
            continue;
        }
        if (ch == '[') depth += 1;
        if (ch == ']') {
            depth -= 1;
            if (depth == 0) return text[p .. k + 1];
        }
    }
    return null;
}

fn findSemanticSlot(asset_id: []const u8) ?*SemanticJoin {
    for (semantic_buf[0..semantic_count]) |*s| {
        if (std.mem.eql(u8, s.asset_id, asset_id)) return s;
    }
    if (semantic_count >= semantic_buf.len) return null;
    semantic_buf[semantic_count] = .{
        .asset_id = asset_id,
        .display_title = "",
        .display_description = "",
        .tmdb_url = "",
        .imdb_url = "",
        .jsonld = "",
    };
    semantic_count += 1;
    return &semantic_buf[semantic_count - 1];
}

fn loadSemantic() void {
    if (semantic_loaded) return;
    semantic_loaded = true;
    ensureConfig();
    const file = std.fs.cwd().openFile(semantic_path_owned, .{}) catch return;
    defer file.close();
    const n = file.readAll(&semantic_file_buf) catch return;
    const text = semantic_file_buf[0..n];
    // Named constructions in top-level "projections". Missing array, missing
    // construction key, or unknown construction = physical-only for that
    // affordance. Do not scrape display_* or title off Entity.
    const projections = jsonArraySlice(text, "\"projections\"") orelse return;
    var i: usize = 0;
    while (i < projections.len) : (i += 1) {
        if (!std.mem.startsWith(u8, projections[i..], "\"asset_id\"")) continue;
        const pobj = entryObjectSlice(projections, i);
        const asset_id = extractAfterUnescaped(pobj, "\"asset_id\"") orelse continue;
        if (asset_id.len == 0) continue;
        const construction = extractAfterUnescaped(pobj, "\"construction\"") orelse continue;
        const is_item = std.mem.eql(u8, construction, "orisha.item");
        const is_links = std.mem.eql(u8, construction, "orisha.links");
        const is_jsonld = std.mem.eql(u8, construction, "schema.org.jsonld");
        if (!is_item and !is_links and !is_jsonld) continue;
        const slot = findSemanticSlot(asset_id) orelse continue;
        if (is_item) {
            slot.display_title = extractAfterUnescaped(pobj, "\"display_title\"") orelse "";
            slot.display_description = extractAfterUnescaped(pobj, "\"display_description\"") orelse "";
        } else if (is_links) {
            slot.tmdb_url = extractAfterUnescaped(pobj, "\"tmdb_url\"") orelse "";
            slot.imdb_url = extractAfterUnescaped(pobj, "\"imdb_url\"") orelse "";
        } else if (is_jsonld) {
            slot.jsonld = extractAfterUnescaped(pobj, "\"jsonld\"") orelse "";
        }
    }
}

pub fn findSemantic(asset_id: []const u8) ?SemanticJoin {
    maybeReloadManifest();
    loadSemantic();
    for (semantic_buf[0..semantic_count]) |s| {
        if (std.mem.eql(u8, s.asset_id, asset_id)) return s;
    }
    return null;
}

/// Locate the JSON array value for the top-level `"entries"` key.
fn entriesArraySlice(text: []const u8) ?[]const u8 {
    return jsonArraySlice(text, "\"entries\"");
}

/// Limit JSON field scrapes to one object so keys before `"id"` (e.g. container)
/// are not read from the following entry when keys are sorted.
/// Walks backward with brace depth so nested `audio`/`video` objects before `"id"`
/// do not become the slice start.
fn entryObjectSlice(text: []const u8, id_at: usize) []const u8 {
    var start: usize = 0;
    var depth: i32 = 0;
    var in_string = false;
    var i: usize = id_at;
    while (i > 0) {
        i -= 1;
        const ch = text[i];
        if (in_string) {
            // Scanning backward: a preceding '\\' escapes this quote.
            if (ch == '"') {
                var bs: usize = 0;
                var j = i;
                while (j > 0 and text[j - 1] == '\\') : (j -= 1) bs += 1;
                if (bs % 2 == 1) continue;
                in_string = false;
            }
            continue;
        }
        if (ch == '"') {
            in_string = true;
            continue;
        }
        if (ch == '}') {
            depth += 1;
        } else if (ch == '{') {
            if (depth == 0) {
                start = i;
                break;
            }
            depth -= 1;
        }
    }
    depth = 0;
    in_string = false;
    var escape = false;
    var k = start;
    var seen_open = false;
    while (k < text.len) : (k += 1) {
        const ch = text[k];
        if (in_string) {
            if (escape) {
                escape = false;
            } else if (ch == '\\') {
                escape = true;
            } else if (ch == '"') {
                in_string = false;
            }
            continue;
        }
        if (ch == '"') {
            in_string = true;
            continue;
        }
        if (ch == '{') {
            depth += 1;
            seen_open = true;
        } else if (ch == '}') {
            depth -= 1;
            if (seen_open and depth == 0) {
                return text[start .. k + 1];
            }
        }
    }
    return text[start..];
}

/// First JSON string in a slice (array values have no `:` before the quote).
fn extractFirstJsonString(slice: []const u8) ?[]const u8 {
    var i: usize = 0;
    var in_string = false;
    var escape = false;
    var start: usize = 0;
    while (i < slice.len) : (i += 1) {
        const ch = slice[i];
        if (in_string) {
            if (escape) {
                escape = false;
                continue;
            }
            if (ch == '\\') {
                escape = true;
                continue;
            }
            if (ch == '"') return slice[start..i];
            continue;
        }
        if (ch == '"') {
            in_string = true;
            start = i + 1;
        }
    }
    return null;
}

fn extractRawString(slice: []const u8) ?[]const u8 {
    const colon = std.mem.indexOfScalar(u8, slice, ':') orelse return null;
    const q1 = std.mem.indexOfScalar(u8, slice[colon..], '"') orelse return null;
    const start = colon + q1 + 1;
    var i = start;
    var escape = false;
    while (i < slice.len) : (i += 1) {
        if (escape) {
            escape = false;
            continue;
        }
        if (slice[i] == '\\') {
            escape = true;
            continue;
        }
        if (slice[i] == '"') {
            return slice[start..i];
        }
    }
    return null;
}

fn allocUnescapeJson(raw: []const u8) ?[]const u8 {
    if (std.mem.indexOfScalar(u8, raw, '\\') == null) return allocDup(raw);
    var tmp: [8192]u8 = undefined;
    var w: usize = 0;
    var i: usize = 0;
    while (i < raw.len and w < tmp.len) : (i += 1) {
        if (raw[i] == '\\' and i + 1 < raw.len) {
            i += 1;
            const esc = raw[i];
            tmp[w] = switch (esc) {
                '"', '\\', '/' => esc,
                'n' => '\n',
                't' => '\t',
                'r' => '\r',
                else => esc,
            };
            w += 1;
        } else {
            tmp[w] = raw[i];
            w += 1;
        }
    }
    return allocDup(tmp[0..w]);
}

fn extractAfterUnescaped(slice: []const u8, key: []const u8) ?[]const u8 {
    const at = std.mem.indexOf(u8, slice, key) orelse return null;
    const raw = extractRawString(slice[at..]) orelse return null;
    return allocUnescapeJson(raw);
}

fn extractNumberAfter(slice: []const u8, key: []const u8) ?u64 {
    const at = std.mem.indexOf(u8, slice, key) orelse return null;
    const colon = std.mem.indexOfScalar(u8, slice[at..], ':') orelse return null;
    var p = at + colon + 1;
    while (p < slice.len and (slice[p] == ' ' or slice[p] == '\t')) : (p += 1) {}
    var end = p;
    while (end < slice.len and slice[end] >= '0' and slice[end] <= '9') : (end += 1) {}
    if (end == p) return null;
    return std.fmt.parseInt(u64, slice[p..end], 10) catch null;
}

/// First object inside a top-level array field on an entry (e.g. `"video":[{...}]`).
/// Scopes nested scrapes so `"codec"` on video does not bleed into `"audio"`.
fn firstArrayObjectSlice(entry_obj: []const u8, key: []const u8) ?[]const u8 {
    const at = std.mem.indexOf(u8, entry_obj, key) orelse return null;
    var p = at + key.len;
    while (p < entry_obj.len and (entry_obj[p] == ' ' or entry_obj[p] == '\t' or entry_obj[p] == '\n' or entry_obj[p] == '\r' or entry_obj[p] == ':')) : (p += 1) {}
    if (p >= entry_obj.len or entry_obj[p] != '[') return null;
    var depth: i32 = 0;
    var in_string = false;
    var escape = false;
    var k = p;
    var first_obj_start: ?usize = null;
    while (k < entry_obj.len) : (k += 1) {
        const ch = entry_obj[k];
        if (in_string) {
            if (escape) {
                escape = false;
            } else if (ch == '\\') {
                escape = true;
            } else if (ch == '"') {
                in_string = false;
            }
            continue;
        }
        if (ch == '"') {
            in_string = true;
            continue;
        }
        if (ch == '[') {
            depth += 1;
            continue;
        }
        if (ch == ']') {
            depth -= 1;
            if (depth == 0) return null; // empty / no object
            continue;
        }
        if (ch == '{' and depth == 1 and first_obj_start == null) {
            first_obj_start = k;
            var obj_depth: i32 = 0;
            var j = k;
            var obj_in_string = false;
            var obj_escape = false;
            while (j < entry_obj.len) : (j += 1) {
                const oj = entry_obj[j];
                if (obj_in_string) {
                    if (obj_escape) {
                        obj_escape = false;
                    } else if (oj == '\\') {
                        obj_escape = true;
                    } else if (oj == '"') {
                        obj_in_string = false;
                    }
                    continue;
                }
                if (oj == '"') {
                    obj_in_string = true;
                    continue;
                }
                if (oj == '{') obj_depth += 1;
                if (oj == '}') {
                    obj_depth -= 1;
                    if (obj_depth == 0) return entry_obj[k .. j + 1];
                }
            }
            return null;
        }
    }
    return null;
}

pub fn findEntry(id: []const u8) ?Entry {
    maybeReloadManifest();
    return koru_media.koru_catalog.findEntry(id);
}

/// Local nfo overlay for this work. `series_work` uses tvshow/movie plot only.
pub fn findNfoOverlay(path: []const u8, season: u32, episode: u32, series_work: bool) NfoMeta {
    maybeReloadManifest();
    return koru_media.koru_catalog.findNfoOverlay(workKey(path), season, episode, series_work);
}

/// Provider overlay for this IMDb id (`[tt…]` on disk). Empty id → empty row.
pub fn findHydrateOverlay(imdb_id: []const u8) HydrateMeta {
    maybeReloadManifest();
    return koru_media.koru_catalog.findHydrateOverlay(imdb_id);
}

pub fn pathOk(rel: []const u8) bool {
    if (rel.len == 0) return false;
    if (std.mem.indexOf(u8, rel, "..") != null) return false;
    if (std.mem.indexOfScalar(u8, rel, '\\') != null) return false;
    return true;
}

pub fn mediaRoot() []const u8 {
    ensureConfig();
    return media_root_owned;
}

/// Touch `reindex.requested`. The next idle request (not a STREAM) walks
/// enabled library roots. Settings POST and `nas-index.sh` share this flag.
pub fn requestReindex() void {
    ensureConfig();
    const path = reindex_flag_owned;
    if (std.mem.lastIndexOfScalar(u8, path, '/')) |slash| {
        if (slash > 0) std.fs.cwd().makePath(path[0..slash]) catch {};
    }
    const f = std.fs.cwd().createFile(path, .{}) catch return;
    f.close();
}

pub const LibraryRoot = koru_media.koru_catalog.LibraryRoot;

pub fn listLibraryRoots(out: []LibraryRoot) []LibraryRoot {
    ensureConfig();
    return koru_media.koru_catalog.listLibraryRoots(out);
}

pub fn saveLibraryRoots(roots: []const LibraryRoot) bool {
    ensureConfig();
    return koru_media.koru_catalog.saveLibraryRoots(roots);
}

/// Relative folder under `KORU_MEDIA_ROOT`. Rejects `..`, backslash, and
/// absolute paths that are not that root. `/media/movies` → `movies`.
pub fn normalizeLibraryRel(raw: []const u8, out: []u8) ?[]const u8 {
    ensureConfig();
    var s = std.mem.trim(u8, raw, " \t\r\n");
    if (s.len == 0) return null;
    while (s.len > 0 and (s[s.len - 1] == '/' or s[s.len - 1] == '\\')) {
        s = s[0 .. s.len - 1];
    }
    if (s.len == 0) return null;
    if (s[0] == '/') {
        const root = media_root_owned;
        if (root.len == 0 or !std.mem.startsWith(u8, s, root)) return null;
        if (s.len == root.len) return null;
        if (s[root.len] != '/') return null;
        s = s[root.len + 1 ..];
        while (s.len > 0 and s[0] == '/') s = s[1..];
        if (s.len == 0) return null;
    }
    if (!pathOk(s)) return null;
    if (s[0] == '/') return null;
    if (out.len < s.len) return null;
    @memcpy(out[0..s.len], s);
    return out[0..s.len];
}

pub fn pathUnderRoot(rel: []const u8, out: []u8) ?[]const u8 {
    ensureConfig();
    if (!pathOk(rel)) return null;
    if (rel[0] == '/') {
        if (!std.mem.startsWith(u8, rel, media_root_owned)) return null;
        if (rel.len > media_root_owned.len and rel[media_root_owned.len] != '/') return null;
        return std.fmt.bufPrint(out, "{s}", .{rel}) catch null;
    }
    const joined = std.fmt.bufPrint(out, "{s}/{s}", .{ media_root_owned, rel }) catch return null;
    if (!std.mem.startsWith(u8, joined, media_root_owned)) return null;
    if (joined.len > media_root_owned.len and joined[media_root_owned.len] != '/' and joined[media_root_owned.len] != '\\') {
        return null;
    }
    return joined;
}
pub const SortMode = enum { title, id, recent };

/// True when a path segment is a Jellyfin `trailers/` (or `trailer/`) folder.
pub fn pathIsTrailer(path: []const u8) bool {
    var start: usize = 0;
    while (start < path.len) {
        var end = start;
        while (end < path.len and path[end] != '/') : (end += 1) {}
        const seg = path[start..end];
        if (std.ascii.eqlIgnoreCase(seg, "trailers") or std.ascii.eqlIgnoreCase(seg, "trailer")) return true;
        if (end >= path.len) break;
        start = end + 1;
    }
    return false;
}

pub fn workKeyIsExtraDir(name: []const u8) bool {
    const names = [_][]const u8{
        "extras",            "extra",             "featurettes",       "featurette",
        "trailers",          "trailer",           "shorts",            "short",
        "interviews",        "interview",         "scenes",            "deleted scenes",
        "behind the scenes", "behind-the-scenes", "samples",           "sample",
        "other",             "theme-music",       "theme music",
        "clips",             "backdrops",         "soundtrack",        "ost",
        "score",
    };
    for (names) |n| {
        if (std.ascii.eqlIgnoreCase(name, n)) return true;
    }
    return false;
}

fn asciiContainsIgnoreCase(hay: []const u8, needle: []const u8) bool {
    if (needle.len == 0 or hay.len < needle.len) return false;
    var i: usize = 0;
    while (i + needle.len <= hay.len) : (i += 1) {
        if (std.ascii.eqlIgnoreCase(hay[i .. i + needle.len], needle)) return true;
    }
    return false;
}

fn pathBasename(rel: []const u8) []const u8 {
    if (std.mem.lastIndexOfScalar(u8, rel, '/')) |s| return rel[s + 1 ..];
    return rel;
}

fn pathStem(rel: []const u8) []const u8 {
    const base = pathBasename(rel);
    if (std.mem.lastIndexOfScalar(u8, base, '.')) |d| {
        if (d > 0) return base[0..d];
    }
    return base;
}

fn looksLikeEditionToken(s: []const u8) bool {
    const tokens = [_][]const u8{
        "3D", "HSBS", "H-SBS", "H.SBS", ".HBS", "SBS", "MVC", "FLAT",
        "2160P", "1080P", "720P", "UHD", "4K", "HDR10", "HDR", "DV",
        "REMUX", "THEATRICAL", "DIRECTOR",
    };
    for (tokens) |t| {
        if (asciiContainsIgnoreCase(s, t)) return true;
    }
    return false;
}

/// Filename edition: `Avatar (2009) - 3D HSBS.mkv` → `3D HSBS`. Unknown suffix → `Original`.
pub fn editionLabel(rel: []const u8) []const u8 {
    const stem = pathStem(rel);
    if (std.mem.lastIndexOf(u8, stem, " - ")) |dash| {
        const suffix = std.mem.trim(u8, stem[dash + 3 ..], " ");
        if (suffix.len > 0 and looksLikeEditionToken(suffix)) return suffix;
    }
    if (looksLikeEditionToken(stem)) return stem;
    return "Original";
}

pub fn editionLooks3d(rel: []const u8) bool {
    return asciiContainsIgnoreCase(rel, "3D") or asciiContainsIgnoreCase(rel, "HSBS") or
        asciiContainsIgnoreCase(rel, "H-SBS") or asciiContainsIgnoreCase(rel, "MVC");
}

/// Extra grouping: soundtrack / featurette / document / trailer / extra.
/// Folder wins, then MIME (audio → soundtrack, pdf → document, video → featurette).
pub fn extraRole(rel: []const u8, mime: []const u8) []const u8 {
    var start: usize = 0;
    while (start < rel.len) {
        var end = start;
        while (end < rel.len and rel[end] != '/') : (end += 1) {}
        const seg = rel[start..end];
        if (std.ascii.eqlIgnoreCase(seg, "soundtrack") or std.ascii.eqlIgnoreCase(seg, "ost") or
            std.ascii.eqlIgnoreCase(seg, "score") or std.ascii.eqlIgnoreCase(seg, "theme-music") or
            std.ascii.eqlIgnoreCase(seg, "theme music"))
            return "soundtrack";
        if (std.ascii.eqlIgnoreCase(seg, "trailers") or std.ascii.eqlIgnoreCase(seg, "trailer"))
            return "trailer";
        if (std.ascii.eqlIgnoreCase(seg, "featurettes") or std.ascii.eqlIgnoreCase(seg, "featurette") or
            std.ascii.eqlIgnoreCase(seg, "shorts") or std.ascii.eqlIgnoreCase(seg, "short") or
            std.ascii.eqlIgnoreCase(seg, "interviews") or std.ascii.eqlIgnoreCase(seg, "interview") or
            std.ascii.eqlIgnoreCase(seg, "scenes") or std.ascii.eqlIgnoreCase(seg, "deleted scenes") or
            std.ascii.eqlIgnoreCase(seg, "behind the scenes") or std.ascii.eqlIgnoreCase(seg, "behind-the-scenes") or
            std.ascii.eqlIgnoreCase(seg, "clips"))
            return "featurette";
        if (end >= rel.len) break;
        start = end + 1;
    }
    if (std.mem.startsWith(u8, mime, "audio/")) return "soundtrack";
    if (std.mem.eql(u8, mime, "application/pdf") or asciiContainsIgnoreCase(rel, ".pdf")) return "document";
    if (std.mem.startsWith(u8, mime, "video/")) return "featurette";
    return "extra";
}

fn pathSegment(path: []const u8, ends: []const usize, i: usize) []const u8 {
    const start: usize = if (i == 0) 0 else ends[i - 1] + 1;
    return path[start..ends[i]];
}

fn fileStemPrefix(path: []const u8) []const u8 {
    var slash: usize = 0;
    var i: usize = 0;
    while (i < path.len) : (i += 1) {
        if (path[i] == '/') slash = i + 1;
    }
    var dot: usize = path.len;
    i = path.len;
    while (i > slash) {
        i -= 1;
        if (path[i] == '.') {
            dot = i;
            break;
        }
    }
    return path[0..dot];
}

/// Folder that owns this file (Jellyfin-style). Extras/featurettes share the
/// title folder; loose files in a library root use `root/stem`.
pub fn workKey(path: []const u8) []const u8 {
    var ends: [8]usize = undefined;
    var n: usize = 0;
    var i: usize = 0;
    while (i < path.len and n < ends.len) {
        while (i < path.len and path[i] != '/') : (i += 1) {}
        ends[n] = i;
        n += 1;
        if (i < path.len and path[i] == '/') i += 1;
    }
    if (n == 0) return path;
    const dir_n = n - 1;
    var keep = dir_n;
    var s: usize = 0;
    while (s < dir_n) : (s += 1) {
        if (workKeyIsExtraDir(pathSegment(path, ends[0..n], s))) {
            keep = s;
            break;
        }
    }
    const root = if (dir_n > 0) pathSegment(path, ends[0..n], 0) else "";
    const want: usize = if (std.ascii.eqlIgnoreCase(root, "shows") or std.ascii.eqlIgnoreCase(root, "tv"))
        2
    else if (std.ascii.eqlIgnoreCase(root, "music"))
        3
    else
        2;
    var dirs_keep = keep;
    if (dirs_keep > want) dirs_keep = want;
    if (dirs_keep <= 1) return fileStemPrefix(path);
    return path[0..ends[dirs_keep - 1]];
}

const KIND_AUDIO_EXT = [_][]const u8{ ".mp3", ".m4a", ".aac", ".flac", ".ogg", ".wav" };
const KIND_BOOK_EXT = [_][]const u8{ ".epub", ".pdf", ".cbz", ".cbr", ".mobi", ".azw3" };

fn extOfPath(name: []const u8) []const u8 {
    if (std.mem.lastIndexOfScalar(u8, name, '.')) |d| return name[d..];
    return "";
}

fn firstSegment(rel: []const u8) []const u8 {
    var i: usize = 0;
    while (i < rel.len) : (i += 1) {
        if (rel[i] == '/') return rel[0..i];
    }
    return rel;
}

fn rootCapability(first: []const u8) []const u8 {
    var buf: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS]koru_media.koru_catalog.LibraryRoot = undefined;
    const roots = koru_media.koru_catalog.listLibraryRoots(&buf);
    for (roots) |lib| {
        if (std.ascii.eqlIgnoreCase(lib.rel_path, first)) {
            if (lib.capability.len > 0) return lib.capability;
            return koru_media.koru_catalog.inferCapability(first);
        }
    }
    return koru_media.koru_catalog.inferCapability(first);
}

fn rootAffordances(first: []const u8) []const u8 {
    var buf: [koru_media.koru_catalog.MAX_LIBRARY_ROOTS]koru_media.koru_catalog.LibraryRoot = undefined;
    const roots = koru_media.koru_catalog.listLibraryRoots(&buf);
    for (roots) |lib| {
        if (std.ascii.eqlIgnoreCase(lib.rel_path, first)) {
            if (lib.affordances.len > 0) return lib.affordances;
            return koru_media.koru_catalog.inferAffordances(rootCapability(first));
        }
    }
    return koru_media.koru_catalog.inferAffordances(rootCapability(first));
}

/// Library capability names the work (series → tv). File kind uses extras folders
/// then MIME/ext so audio under a series/movies tree is extra, not a standalone track.
pub fn fileKind(rel: []const u8) []const u8 {
    var start: usize = 0;
    while (start < rel.len) {
        var end = start;
        while (end < rel.len and rel[end] != '/') : (end += 1) {}
        if (workKeyIsExtraDir(rel[start..end])) return "extra";
        if (end >= rel.len) break;
        start = end + 1;
    }
    const first = firstSegment(rel);
    var cap_hold: [32]u8 = undefined;
    var aff_hold: [128]u8 = undefined;
    const cap_src = rootCapability(first);
    const cap_n = @min(cap_src.len, cap_hold.len);
    @memcpy(cap_hold[0..cap_n], cap_src[0..cap_n]);
    const cap: []const u8 = cap_hold[0..cap_n];
    const aff_src = rootAffordances(first);
    const aff_n = @min(aff_src.len, aff_hold.len);
    @memcpy(aff_hold[0..aff_n], aff_src[0..aff_n]);
    const aff: []const u8 = aff_hold[0..aff_n];
    const ext = extOfPath(rel);
    var is_audio = false;
    var is_book = false;
    for (KIND_AUDIO_EXT) |e| {
        if (std.ascii.eqlIgnoreCase(ext, e)) is_audio = true;
    }
    for (KIND_BOOK_EXT) |e| {
        if (std.ascii.eqlIgnoreCase(ext, e)) is_book = true;
    }
    if (koru_media.koru_catalog.hasAffordance(aff, "audio_as_extra") and is_audio) {
        if (std.mem.eql(u8, cap, "series") or std.mem.eql(u8, cap, "movies")) return "extra";
    }
    if (std.mem.eql(u8, cap, "movies")) return "movie";
    if (std.mem.eql(u8, cap, "series")) return "tv";
    if (std.mem.eql(u8, cap, "music")) return "audio";
    if (std.mem.eql(u8, cap, "books")) return "book";
    if (std.mem.eql(u8, cap, "music_videos")) return "musicVideo";
    if (is_audio) return "audio";
    if (is_book) return "book";
    return "movie";
}

pub const SeasonEpisode = struct {
    season: u32 = 0,
    episode: u32 = 0,
};

fn isAsciiDigit(c: u8) bool {
    return c >= '0' and c <= '9';
}

fn isAsciiAlpha(c: u8) bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z');
}

fn parseU32Digits(s: []const u8, max_digits: usize) ?struct { n: u32, len: usize } {
    if (s.len == 0 or !isAsciiDigit(s[0])) return null;
    var n: u32 = 0;
    var i: usize = 0;
    while (i < s.len and i < max_digits and isAsciiDigit(s[i])) : (i += 1) {
        n = n * 10 + @as(u32, s[i] - '0');
    }
    if (i == 0) return null;
    return .{ .n = n, .len = i };
}

fn findSxxEyy(s: []const u8) ?SeasonEpisode {
    var i: usize = 0;
    while (i < s.len) : (i += 1) {
        const c = s[i];
        if (c != 'S' and c != 's') continue;
        if (i > 0) {
            const prev = s[i - 1];
            if (isAsciiDigit(prev) or isAsciiAlpha(prev)) continue;
        }
        const rest = s[i + 1 ..];
        const sn = parseU32Digits(rest, 2) orelse continue;
        if (sn.len >= rest.len) continue;
        if (rest[sn.len] != 'E' and rest[sn.len] != 'e') continue;
        const en = parseU32Digits(rest[sn.len + 1 ..], 3) orelse continue;
        return .{ .season = sn.n, .episode = en.n };
    }
    return null;
}

fn isPathSepChar(c: u8) bool {
    return c == ' ' or c == '-' or c == '_' or c == '.' or c == '\t';
}

fn parseSeasonFolder(name: []const u8) u32 {
    const needle = "season";
    var i: usize = 0;
    while (i + needle.len <= name.len) : (i += 1) {
        if (!std.ascii.eqlIgnoreCase(name[i .. i + needle.len], needle)) continue;
        if (i > 0 and (isAsciiDigit(name[i - 1]) or isAsciiAlpha(name[i - 1]))) continue;
        var j = i + needle.len;
        while (j < name.len and isPathSepChar(name[j])) : (j += 1) {}
        const parsed = parseU32Digits(name[j..], 2) orelse continue;
        if (parsed.n != 0) return parsed.n;
    }
    return 0;
}

fn lastPathSeg(path: []const u8) []const u8 {
    if (std.mem.lastIndexOfScalar(u8, path, '/')) |sl| return path[sl + 1 ..];
    return path;
}

/// `SxxEyy` on the file stem wins; otherwise Sonarr `Season - 1` / `Season 01` folders.
pub fn parseSeasonEpisode(path: []const u8) SeasonEpisode {
    if (findSxxEyy(lastPathSeg(path))) |se| return se;
    var out = SeasonEpisode{};
    var start: usize = 0;
    while (start < path.len) {
        var end = start;
        while (end < path.len and path[end] != '/') : (end += 1) {}
        const n = parseSeasonFolder(path[start..end]);
        if (n != 0) out.season = n;
        if (end >= path.len) break;
        start = end + 1;
    }
    return out;
}

fn indexOfCharFrom(s: []const u8, start: usize, ch: u8) ?usize {
    var i = start;
    while (i < s.len) : (i += 1) {
        if (s[i] == ch) return i;
    }
    return null;
}

fn isProviderBracketTag(inside: []const u8) bool {
    const s = std.mem.trim(u8, inside, " \t");
    if (s.len >= 3 and std.ascii.eqlIgnoreCase(s[0..2], "tt") and isAsciiDigit(s[2])) {
        var k: usize = 2;
        while (k < s.len and isAsciiDigit(s[k])) : (k += 1) {}
        if (k == s.len) return true;
    }
    const prefixes = [_][]const u8{ "imdbid-", "imdb-", "tmdbid-", "tmdb-", "tvdbid-", "tvdb-" };
    for (prefixes) |p| {
        if (s.len >= p.len and std.ascii.eqlIgnoreCase(s[0..p.len], p)) return true;
    }
    return false;
}

fn writeTtId(digits: []const u8, out: *[16]u8) []const u8 {
    if (digits.len == 0 or 2 + digits.len > out.len) return "";
    out[0] = 't';
    out[1] = 't';
    @memcpy(out[2 .. 2 + digits.len], digits);
    return out[0 .. 2 + digits.len];
}

/// First `[tt…]` or `[imdbid-tt…]` in the path. Written lowercase into `out`.
pub fn parseImdbId(path: []const u8, out: *[16]u8) []const u8 {
    var i: usize = 0;
    while (i < path.len) : (i += 1) {
        if (path[i] != '[') continue;
        const close = indexOfCharFrom(path, i + 1, ']') orelse continue;
        const s = std.mem.trim(u8, path[i + 1 .. close], " \t");
        if (s.len >= 3 and std.ascii.eqlIgnoreCase(s[0..2], "tt") and isAsciiDigit(s[2])) {
            var k: usize = 2;
            while (k < s.len and isAsciiDigit(s[k])) : (k += 1) {}
            if (k == s.len) return writeTtId(s[2..k], out);
        }
        const pfx = "imdbid-";
        if (s.len > pfx.len and std.ascii.eqlIgnoreCase(s[0..pfx.len], pfx)) {
            const rest = s[pfx.len..];
            if (rest.len >= 3 and std.ascii.eqlIgnoreCase(rest[0..2], "tt") and isAsciiDigit(rest[2])) {
                var k: usize = 2;
                while (k < rest.len and isAsciiDigit(rest[k])) : (k += 1) {}
                if (k >= 3) return writeTtId(rest[2..k], out);
            }
        }
    }
    return "";
}

fn isYearParensAt(s: []const u8, i: usize) bool {
    if (i + 5 >= s.len) return false;
    if (s[i] != '(' or s[i + 5] != ')') return false;
    const y0 = s[i + 1];
    return (y0 == '1' or y0 == '2') and isAsciiDigit(s[i + 2]) and isAsciiDigit(s[i + 3]) and isAsciiDigit(s[i + 4]);
}

fn collapseTrim(buf: []u8, n: usize) []const u8 {
    var r: usize = 0;
    var i: usize = 0;
    var pending_space = false;
    var any = false;
    while (i < n) : (i += 1) {
        const c = buf[i];
        if (c == ' ' or c == '\t') {
            if (any) pending_space = true;
            continue;
        }
        if (pending_space) {
            buf[r] = ' ';
            r += 1;
            pending_space = false;
        }
        buf[r] = c;
        r += 1;
        any = true;
    }
    return buf[0..r];
}

/// Last work_key segment with `[tt…]` / `[imdbid-…]` / `(year)` stripped.
pub fn workDisplayTitle(work_key: []const u8, out: []u8) []const u8 {
    const name = lastPathSeg(work_key);
    var w: usize = 0;
    var i: usize = 0;
    while (i < name.len and w < out.len) {
        if (name[i] == '[') {
            if (indexOfCharFrom(name, i + 1, ']')) |cl| {
                if (isProviderBracketTag(name[i + 1 .. cl])) {
                    i = cl + 1;
                    continue;
                }
            }
        }
        if (isYearParensAt(name, i)) {
            i += 6;
            continue;
        }
        out[w] = name[i];
        w += 1;
        i += 1;
    }
    const cleaned = collapseTrim(out, w);
    if (cleaned.len == 0) {
        if (name.len > out.len) return out[0..0];
        @memcpy(out[0..name.len], name);
        return out[0..name.len];
    }
    return cleaned;
}

pub fn hasKind(kind: []const u8) bool {
    maybeReloadManifest();
    return koru_media.koru_catalog.hasKind(kind);
}

pub fn playerTag(e: Entry) []const u8 {
    if (std.mem.startsWith(u8, e.mime, "audio/")) return "audio";
    if (std.mem.startsWith(u8, e.mime, "video/")) return "video";
    if (std.mem.eql(u8, e.mime, "application/pdf") or std.mem.eql(u8, e.container, "pdf")) return "pdf";
    if (std.mem.eql(u8, e.kind, "audio")) return "audio";
    if (std.mem.eql(u8, e.kind, "book")) return "none";
    if (std.mem.eql(u8, e.kind, "musicVideo")) return "video";
    return "video";
}

pub const Page = struct {
    items: []Entry,
    total: usize,
};

pub fn collectPage(kind_filter: ?[]const u8, q: ?[]const u8, sort: SortMode, offset: usize, limit: usize, out: *[MAX_PAGE]Entry) Page {
    maybeReloadManifest();
    return koru_media.koru_catalog.collectPage(kind_filter, q, sort, offset, limit, out);
}

pub fn collectFiltered(kind_filter: ?[]const u8, q: ?[]const u8, sort: SortMode, out: *[MAX_PAGE]Entry) []Entry {
    return collectPage(kind_filter, q, sort, 0, out.len, out).items;
}

pub fn collectWorkmates(path: []const u8, except_id: []const u8, out: *[MAX_PAGE]Entry) []Entry {
    maybeReloadManifest();
    return koru_media.koru_catalog.collectWorkmates(path, except_id, out);
}

pub fn collectWorkFiles(path: []const u8, out: *[MAX_PAGE]Entry) []Entry {
    maybeReloadManifest();
    return koru_media.koru_catalog.collectWorkFiles(path, out);
}

pub fn hasProjectionIndex() bool {
    maybeReloadManifest();
    loadSemantic();
    return semantic_count > 0;
}
