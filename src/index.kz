// media — representation dispatch (not Orisha).
// Graph load lives in graph.kz; HTML/JSON-LD/bytes in consumers.kz.
// `dispatch` is wired from main.k as http:handler. Never calls TMDB, TVDB, or ffmpeg.

const std = @import("std");

// Host aliases so the contract can name http's request/response types.
pub const Request = koru_http.Request;
pub const ContentType = koru_http.ContentType;

// Representation dispatch: graph snapshot + named consumer → HTML / JSON-LD / bytes.
~proc dispatch|zig {
    const allocator = std.heap.c_allocator;
    koru_media.koru_graph.ensureConfig();
    koru_media.koru_graph.maybeReloadManifest();
    const method = req.method;
    // Strip alias (`KORU_BASE_PATH` / `X-Forwarded-Prefix`) before matching routes.
    const path = koru_media.koru_graph.beginRequest(req.path, req.header("X-Forwarded-Prefix"));
    const pq = koru_media.koru_consumers.parseQueryString(req.query);
    const authed = koru_media.koru_auth.authorize(req, path);
    if (!authed) {
        return .{ .status = 401, .body = koru_media.koru_consumers.loginHtml(allocator, "Sign in to continue.", 401), .content_type = null };
    }

    if (std.mem.eql(u8, path, "/login")) {
        if (std.mem.eql(u8, method, "GET")) {
            return .{ .status = 200, .body = koru_media.koru_consumers.loginHtml(allocator, "", 200), .content_type = null };
        }
        if (std.mem.eql(u8, method, "POST")) {
            return .{ .status = 200, .body = koru_media.koru_consumers.loginPost(allocator, req.body), .content_type = null };
        }
    }

    if (std.mem.eql(u8, method, "GET") and std.mem.eql(u8, path, "/")) {
        return .{ .status = 200, .body = koru_media.koru_consumers.homeHtml(allocator), .content_type = null };
    }

    if (std.mem.eql(u8, method, "GET") and std.mem.eql(u8, path, "/library")) {
        const body = if (koru_media.koru_consumers.wantsFragment(req.prefer, req.header("HX-Request") != null))
            koru_media.koru_consumers.libraryFragment(allocator, null, pq.sort, pq.q, pq.limit, pq.offset)
        else
            koru_media.koru_consumers.libraryHtml(allocator, null, pq.sort, pq.q, pq.limit, pq.offset);
        return .{ .status = 200, .body = body, .content_type = null };
    }
    if (std.mem.eql(u8, method, "GET") and std.mem.eql(u8, path, "/fragments/library")) {
        const body = koru_media.koru_consumers.libraryFragment(allocator, null, pq.sort, pq.q, pq.limit, pq.offset);
        return .{ .status = 200, .body = body, .content_type = null };
    }
    if (std.mem.eql(u8, method, "GET") and std.mem.startsWith(u8, path, "/fragments/library/")) {
        const kind = path["/fragments/library/".len..];
        const body = koru_media.koru_consumers.libraryFragment(allocator, kind, pq.sort, pq.q, pq.limit, pq.offset);
        return .{ .status = 200, .body = body, .content_type = null };
    }
    if (std.mem.eql(u8, method, "GET") and std.mem.startsWith(u8, path, "/library/")) {
        const kind = path["/library/".len..];
        const body = if (koru_media.koru_consumers.wantsFragment(req.prefer, req.header("HX-Request") != null))
            koru_media.koru_consumers.libraryFragment(allocator, kind, pq.sort, pq.q, pq.limit, pq.offset)
        else
            koru_media.koru_consumers.libraryHtml(allocator, kind, pq.sort, pq.q, pq.limit, pq.offset);
        return .{ .status = 200, .body = body, .content_type = null };
    }
    if (std.mem.eql(u8, method, "GET") and std.mem.startsWith(u8, path, "/item/")) {
        const id = path["/item/".len..];
        if (koru_media.koru_consumers.wantsJsonLd(req.query, req.accept)) {
            return .{ .status = 200, .body = koru_media.koru_consumers.itemJsonLd(allocator, id), .content_type = null };
        }
        return .{ .status = 200, .body = koru_media.koru_consumers.itemHtml(allocator, id), .content_type = null };
    }
    if (std.mem.eql(u8, method, "GET") and std.mem.startsWith(u8, path, "/play/") and std.mem.endsWith(u8, path, ".m3u")) {
        const rest = path["/play/".len..];
        const id = rest[0 .. rest.len - ".m3u".len];
        return .{ .status = 200, .body = koru_media.koru_consumers.playM3u(allocator, id, req.header("Host")), .content_type = null };
    }
    if (std.mem.eql(u8, method, "GET") and std.mem.startsWith(u8, path, "/play/")) {
        const id = path["/play/".len..];
        return .{ .status = 200, .body = koru_media.koru_consumers.playHtml(allocator, id), .content_type = null };
    }
    if (std.mem.eql(u8, method, "GET") and std.mem.startsWith(u8, path, "/art/")) {
        const id = path["/art/".len..];
        const body = koru_media.koru_consumers.artHttp(allocator, id);
        return .{ .status = 200, .body = body, .content_type = null };
    }
    if (std.mem.eql(u8, method, "GET") and std.mem.startsWith(u8, path, "/subtitles/")) {
        const id = path["/subtitles/".len..];
        const body = koru_media.koru_consumers.subtitlesHttp(allocator, id);
        return .{ .status = 200, .body = body, .content_type = null };
    }
    if (std.mem.eql(u8, method, "OPTIONS") and std.mem.startsWith(u8, path, "/media/")) {
        const id = path["/media/".len..];
        return .{ .status = 200, .body = koru_media.koru_consumers.mediaOptions(id), .content_type = null };
    }
    if ((std.mem.eql(u8, method, "GET") or std.mem.eql(u8, method, "HEAD")) and std.mem.startsWith(u8, path, "/media/")) {
        const id = path["/media/".len..];
        const body = koru_media.koru_consumers.mediaHttp(allocator, method, id, req.range, koru_media.koru_consumers.queryFlag(req.query, "download"), req.if_none_match);
        return .{ .status = 200, .body = body, .content_type = null };
    }
    if (std.mem.eql(u8, path, "/settings")) {
        if (std.mem.eql(u8, method, "GET")) {
            return .{ .status = 200, .body = koru_media.koru_consumers.settingsHtml(allocator, ""), .content_type = null };
        }
        if (std.mem.eql(u8, method, "POST")) {
            return .{ .status = 200, .body = koru_media.koru_consumers.settingsPost(allocator, req.body), .content_type = null };
        }
    }

    if (koru_media.koru_consumers.staticFallback(method, path, req.if_none_match)) |r| {
        return .{ .status = r.status, .body = r.body, .content_type = r.content_type };
    }
    return .{ .status = 404, .body = "Not Found", .content_type = null };
}

~proc reindex|zig {
    koru_media.koru_graph.maybeReindexFlag();
}

~proc hydrate-catalog|zig {
    koru_media.koru_hydrate.run();
}
